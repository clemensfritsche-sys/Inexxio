# ============================================================
# INEXXIO ENTERPRISE CENTRAL SYSTEM - Environment Variables
# ============================================================
# Kopiere diese Datei nach .env.local und fülle alle Felder aus.
# NIEMALS .env.local in Git committen!
#
# Hier steht ausschliesslich, was der Code auch LIEST. Eine Variable auf Vorrat ist
# eine Behauptung: sie sieht aus wie eine Stellschraube, dreht aber an nichts – und
# beim nächsten Fehler sucht jemand genau dort.

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
DEBUG=true
# development | production. Ausserhalb der Produktion liefert die API Fehlerdetails
# und die Testnotizen der Oberfläche sind erreichbar (sonst 404).
APP_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────
# Lokal: postgresql://postgres:postgres@localhost:5432/inexxio_local
# Cloud SQL (Production): postgresql://user:pass@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inexxio_local

# ─── Firebase Authentication ────────────────────────────────
# Aus Firebase Console: Projekteinstellungen > Allgemein
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inexxio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inexxio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inexxio.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend: Service Account JSON (Pfad zur Datei oder JSON-String)
FIREBASE_PROJECT_ID=inexxio
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Passkeys / WebAuthn (FIDO2) ──────────────────────────────
# Passwortlose Anmeldung via Passkey. RP-ID und Origin werden pro Request aus dem
# Origin-Header abgeleitet (localhost, inexxio-dev.web.app, inexxio.com) und gegen
# CORS_ORIGINS geprüft – i. d. R. ist KEINE Konfiguration nötig.
# WEBAUTHN_RP_NAME wird im Passkey-Dialog angezeigt.
WEBAUTHN_RP_NAME=Inexxio AG
# Optional: feste RP-ID erzwingen (leer = aus Origin-Host ableiten).
# WEBAUTHN_RP_ID=
# Optional: zusätzliche erlaubte Origins über CORS_ORIGINS hinaus (kommagetrennt/JSON-Liste).
# WEBAUTHN_EXTRA_ORIGINS=["https://app.inexxio.com"]
#
# WICHTIG (Cloud Run): Damit das Firebase Admin SDK den Custom Token signieren kann,
# braucht der Laufzeit-Service-Account die Rolle roles/iam.serviceAccountTokenCreator
# auf sich selbst (siehe docs/passkeys.md). Ohne Service-Account-JSON läuft die
# Signierung sonst nicht.

# ─── Backend API ──────────────────────────────────────────────
# Lokale Entwicklung: http://localhost:8000
# Production: https://api.inexxio.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Öffentliche Adresse des Frontends ────────────────────────
# Unter welcher Adresse die Website läuft, weiss das Deployment – daraus leitet
# services/sites.website_url das Impressum und die Anzeige am Datensatz ab.
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Build-Commit: die Testnotizen der Oberfläche hängen ihn an jede Meldung.
NEXT_PUBLIC_COMMIT_SHA=

# ─── Security ────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://inexxio.web.app,https://inexxio.com
