{
  "name": "inexxio-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/site-shell.mjs && node scripts/vendor-opencv.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/site-shell.mjs && node scripts/vendor-opencv.mjs",
    "build": "node scripts/build-islands.mjs && next build",
    "prelint": "node scripts/site-shell.mjs",
    "lint": "eslint .",
    "pretype-check": "node scripts/site-shell.mjs && next typegen",
    "type-check": "tsc --noEmit",
    "pretest": "node scripts/site-shell.mjs",
    "test": "node --test scripts/*.test.mjs",
    "generate:types": "openapi-typescript ../backend/openapi.json -o ./src/types/api.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tanstack/react-query": "^5.104.2",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@zxing/browser": "^0.1.5",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.460.0",
    "next": "^16.4.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.1",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
