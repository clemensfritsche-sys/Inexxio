{
  "hosting": {
    "public": "frontend/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "regex": "(?i)^/heuentnahmekran/kran-dem-geb(?:ä|ae|a|%c3%a4)ude-angepasst(?:/.*)?$",
        "destination": "/krane/krananlagen",
        "type": 301
      },
      {
        "regex": "(?i)^/heuentnahmekran/matagematerial(?:/.*)?$",
        "destination": "/krane/kranservice",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:heuentnahmekran|forst-und-landwirtschaft|drehkran-hydraulisch|bruecken-kran|einschienen-kran)(?:/.*)?$",
        "destination": "/krane/heukrananlagen",
        "type": 301
      },
      {
        "regex": "(?i)^/application/files/.*$",
        "destination": "/krane/heukrananlagen",
        "type": 301
      },
      {
        "regex": "(?i)^/betonfordertechnik/euro-k(?:ö|oe|o|%c3%b6)?pper(?:/.*)?$",
        "destination": "/sonderloesungen#fahrzeugbau",
        "type": 301
      },
      {
        "regex": "(?i)^/betonfordertechnik/verschleissteile(?:/.*)?$",
        "destination": "/fahrzeugbau/fahrmischer#katalog",
        "type": 301
      },
      {
        "regex": "(?i)^/betonfordertechnik(?:/.*)?$",
        "destination": "/fahrzeugbau/fahrmischer",
        "type": 301
      },
      {
        "regex": "(?i)^/antrieb-und-steuerung(?:/.*)?$",
        "destination": "/krane/kranservice",
        "type": 301
      },
      {
        "regex": "(?i)^/baumaschinen(?:/.*)?$",
        "destination": "/sonderloesungen",
        "type": 301
      },
      {
        "regex": "(?i)^/wahrschaftes/gelaender-und-verglasung(?:/.*)?$",
        "destination": "/ueber-uns",
        "type": 301
      },
      {
        "regex": "(?i)^/wahrschaftes(?:/.*)?$",
        "destination": "/sonderloesungen",
        "type": 301
      },
      {
        "regex": "(?i)^/sachtransporter-anhanger/reparaturen(?:/.*)?$",
        "destination": "/sonderloesungen#fahrzeugbau",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:haus-und-garten|kleintransporter-pw|hebebuhnen|sachtransporter-anhanger|camping)(?:/.*)?$",
        "destination": "/ueber-uns",
        "type": 301
      },
      {
        "regex": "(?i)^/unsere-einsatzorte(?:/.*)?$",
        "destination": "/ueber-uns",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=(self), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.firebaseapp.com https://*.googleapis.com https://apis.google.com https://cdn.firebase.com https://www.gstatic.com https://js.stripe.com https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://storage.googleapis.com https://lh3.googleusercontent.com https://*.stripe.com; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://inexxio-dev.web.app https://*.firebaseio.com https://*.cloudfunctions.net wss://*.firebaseio.com https://apis.google.com https://api.stripe.com https://maps.googleapis.com https://plausible.io; frame-src 'self' blob: https://*.firebaseapp.com https://inexxio-dev.web.app https://accounts.google.com https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2|woff|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|ico|webp|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "/(app|admin)/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "inexxio-backend-dev",
          "region": "europe-west6"
        }
      }
    ]
  }
}
