---
/**
 * Vorlage der drei Bereichsseiten (Auftrag Kap. 7.4), gleiche Struktur überall:
 * Hero → Auf einen Blick → die drei Ebenen → Unterseiten als grosse Karten mit Foto →
 * Ablauf in vier Schritten (Kranbahn-Linie) → FAQ → Anfrage mit vorausgewähltem Bereich.
 */
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import Levels from '../components/Levels.astro';
import AreaCard from '../components/AreaCard.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
import SeasonNotice from '../components/SeasonNotice.astro';
import Rich from '../components/Rich.astro';
import { areaOf } from '../config/site.mjs';
import { faqPage, service as serviceNode } from '../lib/seo.mjs';
import { plain } from '../lib/text.mjs';
import type { AreaPage, SubPage } from '../content/types';

interface Props { page: AreaPage; subpages: SubPage[] }
const { page, subpages } = Astro.props;
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const nodes = [
  serviceNode(siteUrl, { name: page.service.name, serviceType: page.service.serviceType, path: page.path, description: plain(page.summary) }),
  faqPage(page.faq),
];
/** Kurztext je Unterseite: derselbe wie im Menü. */
const teaser = (path: string) => areaOf(page.id).children.find((c) => c.href === path)?.text ?? '';
---
<Base title={page.title} description={page.description} crumbs={[{ name: page.hero.eyebrow, path: page.path }]} og={page.id} jsonLd={nodes}>
  <Hero eyebrow={page.hero.eyebrow} title={page.hero.h1} lead={page.hero.lead} photo={page.hero.photo} primary={page.hero.primary} />

  <section class="section section--tight" aria-labelledby="auf-einen-blick">
    <div class="wrap grid">
      <div class="col-8 area-glance">
        <h2 id="auf-einen-blick" class="label">Auf einen Blick</h2>
        <Rich as="p" class="area-glance__text" text={page.summary} />
      </div>
    </div>
    <div class="wrap season-slot"><SeasonNotice page={page.path} /></div>
  </section>

  <section class="section section--paper" aria-labelledby="ebenen">
    <div class="wrap">
      <SectionHead eyebrow="Leistungen" title={`${page.hero.eyebrow}: Lösungen, Service, Teile`} id="ebenen" class="head--line" />
      <Levels levels={page.levels} />
    </div>
  </section>

  <section class="section" aria-labelledby="seiten">
    <div class="wrap">
      <SectionHead eyebrow="Im Einzelnen" title="Unsere Leistungen im Detail" id="seiten" />
      <div class:list={['cardgrid', subpages.length === 3 ? 'cardgrid--3' : 'cardgrid--2']}>
        {subpages.map((p) => (
          <AreaCard title={p.crumb} href={p.path} text={teaser(p.path)} photo={p.hero.photo} more={`Mehr zu ${p.crumb}`} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="ablauf">
    <div class="wrap">
      <SectionHead eyebrow="Ablauf" title="In vier Schritten zur Lösung" id="ablauf" />
      <Steps steps={page.steps} />
    </div>
  </section>

  <section class="section" aria-labelledby="fragen">
    <div class="wrap grid">
      <div class="col-4"><SectionHead eyebrow="Fragen" title="Häufige Fragen" id="fragen" /></div>
      <div class="col-8"><Faq items={page.faq} /></div>
    </div>
  </section>

  <ContactSection need={page.cta.need} />
</Base>

<style>
  .area-glance { display: grid; gap: var(--s-3); }
  .area-glance__text { font-size: 1.125rem; color: var(--ink); max-width: 60ch; }
  .season-slot:empty { display: none; }
  .season-slot { margin-top: var(--s-6); }
  .head--line { margin-bottom: var(--s-6); }
</style>
