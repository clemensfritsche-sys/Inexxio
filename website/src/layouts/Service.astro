---
/**
 * Vorlage aller Leistungsseiten (gleiche Struktur überall):
 * Hero → Auf einen Blick → Leistungsumfang → Ablauf in vier Schritten → seitenspezifisches
 * Modul (Slot «module») → FAQ → Anfrage (Kurzformular, Typ/Thema vorausgewählt) → Verwandtes.
 */
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Glance from '../components/Glance.astro';
import ScopeList from '../components/ScopeList.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBlock from '../components/CtaBlock.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import SectionHead from '../components/SectionHead.astro';
import SeasonNotice from '../components/SeasonNotice.astro';
import { faqPage, service as serviceNode } from '../lib/seo.mjs';
import { plain } from '../lib/text.mjs';
import { glanceRows, type ServicePage } from '../content/types';

interface Props { page: ServicePage }
const { page } = Astro.props;
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const crumbs = [...(page.parent ? [page.parent] : []), { name: page.crumb, path: page.path }];
const jsonLd = [
  serviceNode(siteUrl, { name: page.service.name, serviceType: page.service.serviceType, path: page.path, description: plain(page.summary) }),
  faqPage(page.faq),
];
---
<Base title={page.title} description={page.description} crumbs={crumbs} og={page.og} jsonLd={jsonLd}>
  <Hero
    eyebrow={page.hero.eyebrow}
    title={page.hero.h1}
    lead={page.hero.lead}
    photo={page.hero.photo}
    primary={page.hero.primary}
    note={page.hero.note}
  />

  <!-- div: die Überschrift «Auf einen Blick» trägt die Glance-Sektion selbst -->
  <div class="section section--tight">
    <div class="wrap grid">
      <div class="col-8">
        <Glance summary={page.summary} rows={glanceRows(page.glance)} />
      </div>
    </div>
    <div class="wrap season-slot"><SeasonNotice page={page.path} /></div>
  </div>

  <slot name="intro" />

  <section class="section section--paper" aria-labelledby="umfang">
    <div class="wrap">
      <SectionHead title={page.scope.title} lead={page.scope.lead} id="umfang" />
      <ScopeList items={page.scope.items} />
    </div>
  </section>

  <section class="section" aria-labelledby="ablauf">
    <div class="wrap">
      <SectionHead eyebrow="Ablauf" title="So läuft es ab" id="ablauf" />
      <Steps steps={page.steps} />
    </div>
  </section>

  <slot name="module" />

  <section class="section section--rule" aria-labelledby="fragen">
    <div class="wrap grid">
      <div class="col-4"><SectionHead eyebrow="Fragen" title="Häufige Fragen" id="fragen" /></div>
      <div class="col-8"><Faq items={page.faq} /></div>
    </div>
  </section>

  <CtaBlock
    title={page.cta.title}
    lead={page.cta.lead}
    kind={page.cta.kind}
    need={page.cta.need}
    urgency={page.cta.urgency}
    messageLabel={page.cta.messageLabel}
    pikettFirst={page.cta.pikettFirst}
  />

  <!-- div statt section: die Überschrift gehört der <nav> darin, nicht dem Rahmen -->
  <div class="section section--tight">
    <div class="wrap"><RelatedLinks items={page.related} /></div>
  </div>
</Base>

<style>
  .season-slot:empty { display: none; }
  .season-slot { margin-top: var(--s-6); }
</style>
