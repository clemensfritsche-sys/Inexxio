---
/** Rechtliche Seiten: schlichter Kopf, Text als Prosa, Stand-Datum. */
import Base from './Base.astro';
import type { LegalDoc } from '../lib/legal';
import { formatDay } from '../lib/ratgeber';

interface Props { doc: LegalDoc; path: string }
const { doc, path } = Astro.props;
---
<Base title={doc.title} description={doc.description} crumbs={[{ name: doc.title, path }]}>
  <article class="section legal">
    <div class="wrap">
      <div class="legal__inner">
        <header class="legal__head" data-hero>
          <h1 class="legal__title">{doc.title}</h1>
          <p class="label">Stand: <time datetime={doc.updated}>{formatDay(doc.updated)}</time></p>
        </header>
        <div class="prose legal__body" set:html={doc.html} />
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal { padding-top: var(--s-6); }
  .legal__inner { max-width: 760px; display: grid; gap: var(--s-4); }
  .legal__head { display: grid; gap: var(--s-4); }
  .legal__title { font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.5rem); }
  .legal__body { margin-top: var(--s-5); }
</style>
