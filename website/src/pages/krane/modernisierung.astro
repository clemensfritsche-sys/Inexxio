---
/** /krane/modernisierung – Nachrüstungen, Hinweis EU-Maschinenverordnung, Vorher/Nachher (abgeschaltet bis echte Fotos). */
import Service from '../../layouts/Service.astro';
import SectionHead from '../../components/SectionHead.astro';
import Sources from '../../components/Sources.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Rich from '../../components/Rich.astro';
import { modernisierung, machineryNote } from '../../content/krane';
import { site } from '../../config/site.mjs';
---
<Service page={modernisierung}>
  <section slot="module" class="section section--paper" aria-labelledby="maschinenverordnung">
    <div class="wrap grid mod">
      <div class="col-7 mod__text">
        <SectionHead eyebrow="EU-Maschinenverordnung" title={machineryNote.title} id="maschinenverordnung" class="head--flush" />
        {machineryNote.text.map((t) => <Rich as="p" text={t} />)}
      </div>
      <aside class="col-4 mod__aside">
        <Sources items={machineryNote.sources} />
      </aside>
      {site.features.beforeAfter && (
        <div class="col-12">
          <BeforeAfter before="vorher-kran" after="nachher-kran" caption="Dieselbe Anlage vor und nach der Modernisierung." />
        </div>
      )}
    </div>
  </section>
</Service>

<style>
  .mod__text { display: grid; gap: var(--s-4); }
  .head--flush { margin-bottom: var(--s-2); }
  @media (min-width: 960px) { .mod__aside { grid-column: 9 / span 4; padding-left: var(--s-5); border-left: 1px solid var(--line-2); align-self: end; } }
</style>
