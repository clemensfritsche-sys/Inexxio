---
/** /krane/reparatur – Störung und Stillstand: Pikett gross, Ersatzteile ab Lager, «Foto mitschicken». */
import Service from '../../layouts/Service.astro';
import SectionHead from '../../components/SectionHead.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import { reparatur } from '../../content/krane';
import { site, contactEmail } from '../../config/site.mjs';
---
<Service page={reparatur}>
  <section slot="intro" class="section section--tight" aria-labelledby="stillstand">
    <div class="wrap">
      <div class="stop">
        <div class="stop__head">
          <p class="label label--red"><Icon name="siren" size={16} /> Kran steht still</p>
          <h2 class="h3" id="stillstand">Rufen Sie direkt an</h2>
        </div>
        <div class="stop__nums">
          <div class="stop__num">
            <p class="label">Während der Bürozeiten</p>
            <a class="stop__tel tnum" href={`tel:${site.phone.e164}`} data-track="tel_click">{site.phone.display}</a>
            <Rich as="p" class="small muted" text={`${site.hours.text} ${site.hours.review}`} />
          </div>
          {site.features.pikett && (
            <div class="stop__num">
              <p class="label">Pikett für Notfälle</p>
              <a class="stop__tel tnum" href={`tel:${site.pikett.e164}`} data-track="pikett_click">{site.pikett.display}</a>
              <Rich as="p" class="small muted" text={`${site.pikett.hours} ${site.pikett.review}`} />
            </div>
          )}
        </div>
        <div class="stop__tip">
          <p class="stop__tiptitle"><Icon name="camera" size={20} /> Foto mitschicken</p>
          <p class="small">Typenschild (Hersteller, Typ, Baujahr) und Schadensstelle – per Formular unten oder an <a class="link tap" href={`mailto:${contactEmail()}`} data-track="mailto_click">{contactEmail()}</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section slot="module" class="section section--paper" aria-labelledby="ersatzteile">
    <div class="wrap grid rep-parts">
      <div class="col-6">
        <Photo id="ersatzteillager" sizes="(min-width: 960px) 50vw, 100vw" />
      </div>
      <div class="col-5 rep-parts__text">
        <SectionHead eyebrow="Ersatzteile" title="Viele Teile liegen in Tuttwil an Lager" id="ersatzteile" class="head--flush" />
        <p>
          Für HS-Krananlagen haben wir Greifer, Ausleger, Fahrwerke und Drehtürme an Lager, dazu gängige Verschleissteile.
          Teile für andere Hersteller bestellen wir – und bringen sie zum Einsatz mit.
          <Rich as="span" text="[[PRÜFEN: Lagerumfang für andere Hersteller]]" />
        </p>
        <h3 class="rep-parts__h">Was uns schneller macht</h3>
        <ul class="checklist" role="list">
          <li><Icon name="check" size={20} /><span>Foto vom Typenschild: Hersteller, Typ, Baujahr, Nummer</span></li>
          <li><Icon name="check" size={20} /><span>Foto der Schadensstelle aus zwei Blickwinkeln</span></li>
          <li><Icon name="check" size={20} /><span>Fehlermeldung oder Anzeige an der Steuerung</span></li>
        </ul>
      </div>
    </div>
  </section>
</Service>

<style>
  .stop {
    display: grid; gap: var(--s-5); padding: var(--s-6); background: var(--paper); border-left: 3px solid var(--red); --overline: var(--red-deep);
  }
  @media (min-width: 960px) {
    .stop { grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr); align-items: start; gap: var(--s-6); }
  }
  .stop__head { display: grid; gap: var(--s-2); }
  .stop__head .label { display: inline-flex; align-items: center; gap: 6px; }
  .stop__nums { display: grid; gap: var(--s-5); }
  @media (min-width: 640px) { .stop__nums { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .stop__num { display: grid; gap: 4px; }
  .stop__tel {
    font-size: clamp(1.75rem, 1.45rem + 1.3vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;
    color: var(--ink); text-decoration: none; width: fit-content;
    display: inline-flex; align-items: center; min-height: 44px;
  }
  .stop__tel:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .stop__tip { display: grid; gap: var(--s-2); }
  .stop__tiptitle { display: inline-flex; gap: 8px; align-items: center; font-weight: 650; color: var(--ink); }
  .rep-parts { align-items: center; }
  @media (min-width: 960px) { .rep-parts__text { grid-column: 8 / span 5; } }
  .rep-parts__text { display: grid; gap: var(--s-4); }
  .head--flush { margin-bottom: 0; }
  .rep-parts__h { font-size: 1.125rem; margin-top: var(--s-3); }
</style>
