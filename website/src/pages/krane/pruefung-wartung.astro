---
/** /krane/pruefung-wartung – Prüfpflicht mit Tabelle, Prüfpflicht-Check, Quellen und Abo-Hinweis. */
import Service from '../../layouts/Service.astro';
import SectionHead from '../../components/SectionHead.astro';
import InspectionTable from '../../components/InspectionTable.astro';
import InspectionCheck from '../../components/InspectionCheck.astro';
import Sources from '../../components/Sources.astro';
import Icon from '../../components/Icon.astro';
import { pruefung } from '../../content/krane';
import { inspection } from '../../config/inspection.mjs';
---
<Service page={pruefung}>
  <section slot="module" class="section section--paper" aria-labelledby="pruefpflicht">
    <div class="wrap">
      <SectionHead
        eyebrow="Prüfpflicht"
        title="Was die Prüfpflicht verlangt"
        lead="Kurz erklärt – nach Kranverordnung (SR 832.312.15) und EKAS-Richtlinie 6511. [[PRÜFEN: fachlich]]"
        id="pruefpflicht"
      />
      <div class="grid pflicht">
        <div class="col-7 pflicht__text">
          <h3>Alle Krane</h3>
          <p>Regelmässige Überprüfung nach den Angaben des Herstellers durch ausgebildete Kranfachleute.</p>
          <h3>Fahrzeug- und Turmdrehkrane</h3>
          <p>
            Jährliche Überprüfung durch Kranfachleute, zusätzlich eine periodische Kontrolle durch einen von der Suva
            anerkannten Kranexperten: bis 20 Jahre alle 4 Jahre, mit 21 bis 30 Jahren alle 2 Jahre, ab 31 Jahren jährlich.
          </p>
          <h3>Kranbuch</h3>
          <p>Zu jedem Kran gehört ein Kranbuch. Die Form ist frei – es darf also auch digital sein.</p>
        </div>
        <aside class="col-5 pflicht__aside">
          <Sources items={inspection.sources} />
        </aside>
      </div>
      <h3 class="pflicht__h">Übersicht nach Kranart</h3>
      <InspectionTable />
      <h3 class="pflicht__h">Was ist bei Ihrem Kran fällig?</h3>
      <InspectionCheck />
      <div class="pflicht__abo">
        <p><strong>Nie mehr einen Prüftermin vergessen:</strong> Mit dem Service-Abo erinnern wir Sie, prüfen und tragen alles ins digitale Kranbuch ein.</p>
        <a class="arrow-link" href="/service-abo">Service-Abo ansehen <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>
</Service>

<style>
  .pflicht { margin-bottom: var(--s-7); }
  .pflicht__text { display: grid; gap: var(--s-2); }
  .pflicht__text h3 { font-size: 1.125rem; margin-top: var(--s-3); }
  .pflicht__text h3:first-child { margin-top: 0; }
  @media (min-width: 960px) { .pflicht__aside { grid-column: 9 / span 4; padding-left: var(--s-5); border-left: 1px solid var(--line-2); } }
  .pflicht__h { font-size: 1.25rem; margin: var(--s-7) 0 var(--s-4); }
  .pflicht__h:first-of-type { margin-top: 0; }
  .pflicht__abo {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3) var(--s-6);
    margin-top: var(--s-7); padding: var(--s-5) 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line-2);
  }
  .pflicht__abo p { max-width: 52ch; }
</style>
