---
/**
 * /krane/hs-krananlagen – für Besitzer von HS-Krananlagen: Typen, Ersatzteile ab Lager,
 * Saison-Check, «So finden Sie Typ und Baujahr», Neuanlagen auf Anfrage.
 */
import Service from '../../layouts/Service.astro';
import SectionHead from '../../components/SectionHead.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import { hsKrananlagen, hsModules } from '../../content/krane';
import { site } from '../../config/site.mjs';
const m = hsModules;
---
<Service page={hsKrananlagen}>
  <section slot="module" class="section section--paper" aria-labelledby="ersatzteile">
    <div class="wrap">
      <div class="grid hs-row">
        <div class="col-6"><Photo id="ersatzteillager" sizes="(min-width: 960px) 50vw, 100vw" /></div>
        <div class="col-5 hs-row__text">
          <SectionHead eyebrow="Ersatzteile" title={m.parts.title} id="ersatzteile" class="head--flush" />
          <Rich as="p" text={m.parts.text} />
          <a class="arrow-link" href="/kontakt?typ=teile">Ersatzteil anfragen <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>

      <div class="grid hs-row" id="saison-check">
        <div class="col-6 hs-row__text">
          <SectionHead eyebrow="März bis Mai" title={m.season.title} class="head--flush" />
          <Rich as="p" text={m.season.text} />
          <a class="arrow-link" href={m.season.link.href}>{m.season.link.label} <Icon name="arrow-right" size={18} /></a>
        </div>
        <div class="col-6 hs-plate" id="typenschild">
          <h3>{m.plate.title}</h3>
          <div class="hs-plate__grid">
            <Photo id="typenschild-hs" sizes="(min-width: 960px) 22vw, 50vw" />
            <ol class="hs-plate__steps" role="list">
              {m.plate.steps.map((s, i) => (
                <li><span class="label">{String(i + 1).padStart(2, '0')}</span><Rich as="span" text={s} /></li>
              ))}
            </ol>
          </div>
        </div>
      </div>

      <div class="hs-new">
        <div>
          <h3>{m.newPlants.title}</h3>
          <Rich as="p" text={m.newPlants.text} />
        </div>
        <a class="btn btn--secondary" href="/kontakt?typ=kran&thema=neuanlage">Neuanlage anfragen <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
      <Rich as="p" class="small muted hs-abroad" text={`${site.area.abroad} ${site.area.abroadReview}`} />
    </div>
  </section>
</Service>

<style>
  .hs-row { align-items: center; }
  .hs-row + .hs-row { margin-top: var(--s-8); padding-top: var(--s-8); border-top: 1px solid var(--line-2); align-items: start; }
  .hs-row__text { display: grid; gap: var(--s-4); justify-items: start; }
  @media (min-width: 960px) { .hs-row:first-child .hs-row__text { grid-column: 8 / span 5; } }
  .head--flush { margin-bottom: 0; }
  .hs-plate { display: grid; gap: var(--s-4); }
  .hs-plate h3 { font-size: 1.25rem; }
  .hs-plate__grid { display: grid; gap: var(--s-5); }
  @media (min-width: 560px) { .hs-plate__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; } }
  .hs-plate__steps { list-style: none; padding: 0; display: grid; gap: var(--s-4); }
  .hs-plate__steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: var(--s-2); font-size: 0.97rem; }
  .hs-plate__steps .label { padding-top: 3px; }
  .hs-new {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4) var(--s-6);
    margin-top: var(--s-8); padding: var(--s-6) 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line-2);
  }
  .hs-new > div { display: grid; gap: var(--s-2); max-width: 60ch; }
  .hs-new h3 { font-size: 1.375rem; }
  .hs-abroad { margin-top: var(--s-5); }
</style>
