---
/**
 * /sonderloesungen – EINE Seite, gegliedert nach den drei Feldern, auf die Krane und
 * Fahrzeugbau verweisen (#krane, #fahrzeugbau, #stahlbau – Testnotiz #1206). Vorlage der
 * Unterseiten; Module: die drei Felder, Ablauf, Hintergrund. Texte: content/sonderloesungen.ts.
 */
import SubPage from '../layouts/SubPage.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import { sonderloesungen, sonderFields, sonderSteps as s, sonderBackground as b } from '../content/sonderloesungen';
---
<SubPage page={sonderloesungen}>
  <section slot="intro" class="section" aria-labelledby="felder">
    <div class="wrap">
      <SectionHead eyebrow="Drei Felder" title="Was wir nach Mass bauen" id="felder" />
      <div class="sf">
        {sonderFields.map((f, i) => (
          <article class:list={['sf__field', i % 2 === 1 && 'sf__field--flip']} id={f.id} aria-labelledby={`${f.id}-title`}>
            <div class="sf__media"><Photo id={f.photo} sizes="(min-width: 960px) 40vw, 100vw" /></div>
            <div class="sf__text">
              <p class="label">{f.eyebrow}</p>
              <h3 id={`${f.id}-title`} class="sf__title">{f.title}</h3>
              <Rich as="p" text={f.text} />
              <ul class="checklist" role="list">
                {f.items.map((it) => <li><Icon name="check" size={20} /><span>{it}</span></li>)}
              </ul>
              {f.link && <a class="arrow-link" href={f.link.href}>{f.link.label} <Icon name="arrow-right" size={18} /></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section slot="module" class="section section--dark" aria-labelledby="ablauf">
    <div class="wrap">
      <SectionHead eyebrow="Ablauf" title={s.title} lead={s.lead} id="ablauf" />
      <Steps steps={s.items} />
      <div class="btn-row so-cta">
        <a class="btn btn--primary" href="#anfrage">Anliegen schildern <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
    </div>
  </section>

  <section slot="module" class="section" aria-labelledby="hintergrund">
    <div class="wrap grid so-bg">
      <div class="col-4"><Photo id="portraet-clemens" sizes="(min-width: 960px) 30vw, 70vw" /></div>
      <div class="col-7 so-bg__text">
        <SectionHead eyebrow="Hintergrund" title={b.title} id="hintergrund" class="head--flush" />
        <Rich as="p" text={b.text} />
        <a class="arrow-link" href="/ueber-uns">Mehr über uns <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>
</SubPage>

<style>
  .sf { display: grid; gap: var(--s-8); }
  .sf__field { display: grid; gap: var(--s-5) var(--s-8); align-items: center; }
  @media (min-width: 960px) {
    .sf__field { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .sf__field--flip .sf__media { order: 2; }
  }
  .sf__media { overflow: hidden; border-radius: var(--r-lg); aspect-ratio: 4 / 3; background: var(--paper-2); }
  .sf__media :global(picture), .sf__media :global(img), .sf__media :global(.ph) { width: 100%; height: 100%; }
  .sf__media :global(img) { object-fit: cover; }
  .sf__text { display: grid; gap: var(--s-3); justify-items: start; }
  .sf__title { font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem); }
  .so-cta { margin-top: var(--s-7); }
  .so-bg { align-items: center; }
  .head--flush { margin-bottom: 0; }
  @media (min-width: 960px) { .so-bg__text { grid-column: 6 / span 7; } }
  .so-bg__text { display: grid; gap: var(--s-4); justify-items: start; }
</style>
