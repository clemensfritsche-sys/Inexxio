---
/** /sonderloesungen/baumaschinen (Auftrag 7.5): Umbauten, Nachrüstungen, Anbauteile, Reparaturen – mit Bezug zum Liebherr-Hintergrund. */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import { baumaschinen } from '../../content/sonderloesungen';
import { site } from '../../config/site.mjs';
const o = site.people.owner;
---
<SubPage page={baumaschinen}>
  <section slot="module" class="section section--paper" aria-labelledby="hintergrund">
    <div class="wrap grid bm">
      <div class="col-4"><Photo id="portraet-clemens" sizes="(min-width: 960px) 30vw, 70vw" /></div>
      <div class="col-7 bm__text">
        <SectionHead eyebrow="Hintergrund" title="Wir wissen, wie eine Baumaschine gebaut ist" id="hintergrund" class="head--flush" />
        <Rich as="p" text={`${o.name} hat als Maschinenbauingenieur bei Liebherr Baumaschinen entwickelt. Wer eine Maschine von innen kennt, baut sie so um, dass sie danach weiter zuverlässig arbeitet – und dokumentiert, was er verändert hat.`} />
        <a class="arrow-link" href="/ueber-uns">Mehr über {o.name} <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>
</SubPage>

<style>
  .bm { align-items: center; }
  .head--flush { margin-bottom: 0; }
  @media (min-width: 960px) { .bm__text { grid-column: 6 / span 7; } }
  .bm__text { display: grid; gap: var(--s-4); justify-items: start; }
</style>
