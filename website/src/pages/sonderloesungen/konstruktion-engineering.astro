---
/**
 * /sonderloesungen/konstruktion-engineering (Auftrag 7.5): Von der Idee bis zur Zeichnung.
 * Ablauf: Anliegen → Machbarkeit und Richtofferte → Konstruktion → Fertigung → Übergabe
 * mit Dokumentation.
 */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Steps from '../../components/Steps.astro';
import Icon from '../../components/Icon.astro';
import { konstruktion, konstruktionSteps as s } from '../../content/sonderloesungen';
---
<SubPage page={konstruktion}>
  <section slot="module" class="section section--dark" aria-labelledby="ablauf-konstruktion">
    <div class="wrap">
      <SectionHead eyebrow="Ablauf" title={s.title} lead="Eine Skizze, ein Foto oder ein Muster genügt für den Anfang – auch als PDF." id="ablauf-konstruktion" />
      <Steps steps={s.items} />
      <div class="btn-row ko-cta">
        <a class="btn btn--primary" href="#anfrage">Anliegen schildern <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
    </div>
  </section>
</SubPage>

<style>
  .ko-cta { margin-top: var(--s-7); }
</style>
