---
/**
 * /krantechnik/heukrananlagen – eigenes Layout nach dem Muster von Fahrzeugtechnik (Oktober 2026):
 * Kopf wie Porsche → Funk statt Kabine (#funk) → Saison-Check als Wandkalender (#saison-check, Ziel der
 * Saison-Aktion) → Bestehende HS-Anlagen → Bauformen als Bildkarten wie der Katalog (#neuanlage) → Ablauf
 * einer Neuanlage (Weg) → Fragen → Anfrage. Kein INEXXIO 365 – Heukrane laufen selten.
 * Texte: content/krantechnik.ts.
 */
import Base from '../../layouts/Base.astro';
import StageHero from '../../components/StageHero.astro';
import RadioControl from '../../components/kran/RadioControl.astro';
import SeasonCalendar from '../../components/SeasonCalendar.astro';
import Magazine from '../../components/Magazine.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import SolutionPath from '../../components/spezial/SolutionPath.astro';
import FaqStage from '../../components/FaqStage.astro';
import ContactSection from '../../components/ContactSection.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import { areaOf } from '../../config/site.mjs';
import { faqPage, product, service as serviceNode } from '../../lib/seo.mjs';
import { plain } from '../../lib/text.mjs';
import titel from '../../assets/illustrations/heukran-titel.webp';
import { heukrananlagen as page, heukranModules as m, radioControl as rc } from '../../content/krantechnik';

const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const area = areaOf(page.area);
const nodes = [
  serviceNode(siteUrl, { name: page.service.name, serviceType: page.service.serviceType, path: page.path, description: plain(page.summary) }),
  faqPage(page.faq),
  product(siteUrl, { name: 'Heukrananlage nach Mass', description: plain(page.summary), path: page.path }),
];
---
<Base title={page.title} description={page.description} crumbs={[{ name: area.label, path: area.href }, { name: page.crumb, path: page.path }]} og={page.area} jsonLd={nodes}>
  <StageHero
    word="Heukrane"
    image={titel}
    alt="Scheune als Konstruktionszeichnung, ein roter Heukran trägt einen vollen Greifer, darunter steht der Landwirt mit dem Funksender"
    title={page.hero.h1}
    lead={page.hero.lead}
    primary={page.hero.primary}
    secondary={{ label: 'Funk statt Kabine', href: '#funk' }}
  />

  <RadioControl {...rc} />

  <SeasonCalendar {...m.season} />

  <section class="v4-section" aria-labelledby="bestehende-anlagen">
    <div class="wrap hk-own">
      <span class="hk-own__ic" aria-hidden="true"><Icon name="handshake" size={26} /></span>
      <h2 class="v4-h2" id="bestehende-anlagen">{m.owners.title}</h2>
      <Rich as="p" class="v4-sub" text={m.owners.text} />
    </div>
  </section>

  <section class="v4-section" id="neuanlage" aria-labelledby="neuanlage-title">
    <div class="wrap">
      <header class="hk-head"><h2 class="v4-h2" id="neuanlage-title">{m.forms.title}</h2><p class="v4-sub">{m.forms.lead}</p></header>
      <Magazine square>
        {m.forms.items.map((f) => <li><PhotoCard illo={f.illo} alt={`Zeichnung: ${f.title}`} label={f.label} title={f.title} text={f.text} /></li>)}
        <li class="mag__end"><PhotoCard compact title={m.forms.missing.title} text={m.forms.missing.text} cta={m.forms.missing.cta} /></li>
      </Magazine>
    </div>
  </section>

  <SolutionPath id="ablauf-neuanlage" title={m.steps.title} start={m.steps.start} end={m.steps.end} items={m.steps.items} />

  <FaqStage items={page.faq} illo={'menu/heukrananlagen'} />

  <ContactSection />
</Base>

<style>
  .hk-head { margin-bottom: 40px; }
  @media (min-width: 960px) { .hk-head { margin-bottom: 56px; } }
  .hk-own { display: grid; justify-items: center; gap: 0; text-align: center; }
  .hk-own .v4-h2, .hk-own :global(.v4-sub) { margin-inline: auto; }
  .hk-own__ic { display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 24px; border-radius: 50%; background: var(--gray-100); color: var(--ink); }
</style>
