---
/**
 * /krantechnik/kranservice – der Kranservice (Rückmeldung 07.10.2026): Prüfung, Wartung
 * und die Jahrespakete auf EINER Seite. Zuerst die Pakete (was kann was), dann – über die
 * Vorlage – was wir prüfen, dann die Prüfpflicht mit Tabelle, Quellen und Prüfpflicht-Check.
 * Nicht behaupten, dass INEXXIO Kranexperten-Kontrollen durchführt oder von der Suva
 * anerkannt ist.
 */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServicePlans from '../../components/ServicePlans.astro';
import InspectionTable from '../../components/InspectionTable.astro';
import InspectionCheck from '../../components/InspectionCheck.astro';
import Sources from '../../components/Sources.astro';
import { kranservice, servicePlans as t } from '../../content/krantechnik';
import { inspection } from '../../config/inspection.mjs';
---
<SubPage page={kranservice}>
  <section slot="intro" class="section" id="pakete" aria-labelledby="pakete-title">
    <div class="wrap">
      <SectionHead eyebrow="Pakete" title={t.title} lead={t.lead} id="pakete-title" />
      <ServicePlans />
    </div>
  </section>

  <section slot="module" class="section" aria-labelledby="pruefpflicht">
    <div class="wrap">
      <SectionHead
        eyebrow="Prüfpflicht"
        title="Was die Prüfpflicht verlangt"
        lead="Kurz erklärt – nach Kranverordnung (SR 832.312.15) und EKAS-Richtlinie 6511."
        id="pruefpflicht"
      />
      <div class="grid pflicht">
        <div class="col-7 pflicht__text">
          <h3>Alle Krane</h3>
          <p>Regelmässige Überprüfung nach den Angaben des Herstellers durch ausgebildete Kranfachleute.</p>
          <h3>Fahrzeug- und Turmdrehkrane</h3>
          <p>
            Jährliche Überprüfung durch Kranfachleute, zusätzlich eine periodische Kontrolle durch einen von der Suva
            anerkannten Kranexperten: bis 20 Jahre alle 4 Jahre, mit 21 bis 30 Jahren alle 2 Jahre, ab 31 Jahren jährlich.
          </p>
          <h3>Kranbuch</h3>
          <p>Zu jedem Kran gehört ein Kranbuch.</p>
        </div>
        <aside class="col-5 pflicht__aside">
          <Sources items={inspection.sources} />
        </aside>
      </div>
      <h3 class="pflicht__h">Übersicht nach Kranart</h3>
      <InspectionTable />
      <h3 class="pflicht__h">Was ist bei Ihrem Kran fällig?</h3>
      <InspectionCheck />
      <p class="pflicht__who small">
        Wir übernehmen die Überprüfung durch Kranfachleute und die Wartung. Die periodische Kontrolle von Fahrzeug- und
        Turmdrehkranen macht ein von der Suva anerkannter Kranexperte – sie gehört nicht zu unserem Angebot.
      </p>
    </div>
  </section>
</SubPage>

<style>
  .pflicht { margin-bottom: var(--s-7); }
  .pflicht__text { display: grid; gap: var(--s-2); }
  .pflicht__text h3 { font-size: 1.125rem; margin-top: var(--s-3); }
  .pflicht__text h3:first-child { margin-top: 0; }
  @media (min-width: 960px) { .pflicht__aside { grid-column: 9 / span 4; padding-left: var(--s-5); border-left: 1px solid var(--line-2); } }
  .pflicht__h { font-size: 1.25rem; margin: var(--s-7) 0 var(--s-4); }
  .pflicht__h:first-of-type { margin-top: 0; }
  .pflicht__who { margin-top: var(--s-6); padding-top: var(--s-4); border-top: 1px solid var(--line-2); color: var(--ink-2); }
</style>
