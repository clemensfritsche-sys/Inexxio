---
/**
 * /krantechnik/krane-nach-mass – die Seite für schwierige Gebäude (Entscheid 23.10.2026), eigenes
 * Layout nach dem Muster von Fahrzeugtechnik: Kopf wie Porsche → Wo ein Katalogkran nicht passt (#situationen,
 * alle vier als Bildkarten wie im Katalog) → Für Scheune und Halle (zwei Bildkarten) → Häfen (#hafen) →
 * So geht's (#ablauf, Weg – zugleich, was zu jedem Kran gehört) → Belege (per Schalter) → Garantien →
 * Fragen → Anfrage mit Foto-Hilfe. Texte: content/krantechnik.ts.
 */
import Base from '../../layouts/Base.astro';
import StageHero from '../../components/StageHero.astro';
import Magazine from '../../components/Magazine.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import Harbour from '../../components/kran/Harbour.astro';
import SolutionPath from '../../components/spezial/SolutionPath.astro';
import References from '../../components/kran/References.astro';
import Guarantees from '../../components/home/Guarantees.astro';
import FaqStage from '../../components/FaqStage.astro';
import ContactSection from '../../components/ContactSection.astro';
import { areaOf } from '../../config/site.mjs';
import { faqPage, service as serviceNode } from '../../lib/seo.mjs';
import { plain } from '../../lib/text.mjs';
import titel from '../../assets/illustrations/nachmass-titel.webp';
import {
  kraneNachMass as page, craneSituations as sit, craneWorlds as wo, nachMassPath as p,
  nachMassPhotoHint as hint, craneReferences as refs, harbour,
} from '../../content/krantechnik';

const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const area = areaOf(page.area);
const nodes = [
  serviceNode(siteUrl, { name: page.service.name, serviceType: page.service.serviceType, path: page.path, description: plain(page.summary) }),
  faqPage(page.faq),
];
---
<Base title={page.title} description={page.description} crumbs={[{ name: area.label, path: area.href }, { name: page.crumb, path: page.path }]} og={page.area} jsonLd={nodes}>
  <StageHero
    word={page.crumb}
    image={titel}
    alt="Scheune als Konstruktionszeichnung, darunter eine rote Kranfahrbahn, die dem Dachstuhl in einem weichen Bogen folgt, mit Kettenzug und Greifer"
    title={page.hero.h1}
    lead={page.hero.lead}
    primary={page.hero.primary}
    secondary={{ label: 'Wo es passt', href: '#situationen' }}
  />

  <section class="v4-section" id="situationen" aria-labelledby="situationen-title">
    <div class="wrap">
      <header class="kn-head"><h2 class="v4-h2" id="situationen-title">{sit.title}</h2><p class="v4-sub">{sit.lead}</p></header>
      <Magazine art>
        {sit.items.map((it) => <li><PhotoCard photo={it.photo} illo={it.illo} alt={it.alt} label={it.label} title={it.title} text={it.text} /></li>)}
        <li class="mag__end"><PhotoCard compact title={sit.missing.title} text={sit.missing.text} cta={sit.missing.cta} /></li>
      </Magazine>
    </div>
  </section>

  <section class="v4-section" aria-labelledby="welten">
    <div class="wrap">
      <header class="v4-head--center"><h2 class="v4-h2" id="welten">{wo.title}</h2></header>
      <ul role="list" class="kn-worlds">
        {wo.items.map((it) => <li><PhotoCard photo={it.photo} label={it.label} title={it.title} text={it.text} cta={it.cta} /></li>)}
      </ul>
    </div>
  </section>

  <Harbour {...harbour} />

  <SolutionPath title={p.title} start={p.start} end={p.end} items={p.items} />

  <References title={refs.title} items={refs.items} />

  <Guarantees garantieHref="#fragen" />

  <FaqStage items={page.faq} illo={'heukran-angepasst'} />

  <ContactSection hint={hint} />
</Base>

<style>
  .kn-head { margin-bottom: 40px; }
  @media (min-width: 960px) { .kn-head { margin-bottom: 56px; } }
  .kn-worlds { list-style: none; padding: 0; display: grid; gap: 16px; margin-top: 40px; }
  @media (min-width: 960px) { .kn-worlds { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 56px; } }
</style>
