---
/**
 * /krantechnik/industriekrane (Auftrag 7.5): Neuanlagen und Service für bestehende Krane,
 * der Hinweis auf INEXXIO 365 mit den Branchen, Notfall-Service, Hinweis «Foto vom
 * Typenschild oder Schaden mitschicken».
 */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import { industriekrane, industrieModules as m } from '../../content/krantechnik';
import { site } from '../../config/site.mjs';
---
<SubPage page={industriekrane}>
  <section slot="intro" class="section section--dark" aria-labelledby="x365">
    <div class="wrap grid ik365">
      <div class="col-7">
        <SectionHead eyebrow="INEXXIO 365" title={m.inexxio365.title} id="x365" class="head--flush" />
      </div>
      <div class="col-5 ik365__text">
        <Rich as="p" text={m.inexxio365.text} />
        <a class="arrow-link" href={m.inexxio365.link.href}>{m.inexxio365.link.label} <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>
  <section slot="module" class="section" id="service" aria-labelledby="service-title">
    <div class="wrap grid ik">
      <div class="col-6 ik__text">
        <SectionHead eyebrow="Service und Reparatur" title={m.service.title} id="service-title" class="head--flush" />
        <Rich as="p" text={m.service.text} />
        <div class="btn-row">
          <a class="btn btn--secondary" href="/service#notfall">Zum Notfall-Service <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
          <a class="btn btn--secondary" href={`tel:${site.phone.e164}`} data-track="tel_click"><Icon name="phone" size={18} /> {site.phone.display}</a>
        </div>
      </div>
      <div class="col-5 ik__hint">
        <Photo id="typenschild-hs" sizes="(min-width: 960px) 40vw, 100vw" />
        <div class="ik__hintbox">
          <Icon name="camera" size={22} />
          <div>
            <h3>{m.photoHint.title}</h3>
            <Rich as="p" text={m.photoHint.text} />
          </div>
        </div>
      </div>
    </div>
  </section>
</SubPage>

<style>
  .ik365 { align-items: end; row-gap: var(--s-5); }
  .ik365__text { display: grid; gap: var(--s-4); justify-items: start; }
  .ik { align-items: start; }
  .ik__text { display: grid; gap: var(--s-4); justify-items: start; }
  .head--flush { margin-bottom: 0; }
  @media (min-width: 960px) { .ik__hint { grid-column: 8 / span 5; } }
  .ik__hint { display: grid; gap: var(--s-4); }
  .ik__hintbox { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--ink); }
  .ik__hintbox h3 { font-size: 1.125rem; margin-bottom: 4px; }
  .ik__hintbox :global(.icon) { color: var(--red); margin-top: 2px; }
</style>
