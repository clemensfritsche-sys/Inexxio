---
/**
 * /krantechnik/service-vertrag – das Kernangebot (STRATEGIE.md, 6.10.2026): ein fester
 * Preis pro Kran und Jahr, in drei Stufen. Kein Betrag (Fixpreise je Kranklasse folgen mit
 * der Offerte). Module: die drei Stufen, der Weg zum Vertrag.
 */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Steps from '../../components/Steps.astro';
import ContractTiers from '../../components/ContractTiers.astro';
import Icon from '../../components/Icon.astro';
import { serviceVertrag, contractTiers as t } from '../../content/krantechnik';
---
<SubPage page={serviceVertrag}>
  <section slot="intro" class="section" id="stufen" aria-labelledby="stufen-title">
    <div class="wrap">
      <SectionHead eyebrow="Drei Stufen" title={t.title} lead={t.lead} id="stufen-title" />
      <ContractTiers />
    </div>
  </section>

  <section slot="module" class="section section--dark" aria-labelledby="weg-title">
    <div class="wrap">
      <SectionHead eyebrow="Ablauf" title="So kommen Sie zum Vertrag" id="weg-title" />
      <Steps steps={t.steps} />
      <div class="btn-row sv-cta">
        <a class="btn btn--primary" href="#anfrage">Offerte anfragen <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
    </div>
  </section>
</SubPage>

<style>
  .sv-cta { margin-top: var(--s-7); }
</style>
