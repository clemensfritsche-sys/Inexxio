---
/**
 * Startseite: Hero mit Laufkran, drei gleichwertigen Bereichen und der Vertrauensleiste
 * (HomeHero) → die drei Versprechen (Promises) → Branchenzeile → Warum (Belege) → Übergabe → Ratgeber → Fragen → Anfrage (mit
 * Karte – darum keine zweite «Wo wir arbeiten»-Sektion). Texte: src/content/start.ts,
 * Bereiche aus src/config/site.mjs.
 */
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Promises from '../components/Promises.astro';
import SectionHead from '../components/SectionHead.astro';
import Photo from '../components/Photo.astro';
import Quote from '../components/Quote.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import { site } from '../config/site.mjs';
import { start } from '../content/start';
import { industryList } from '../content/promises';
import recycling from '../assets/illustrations/branche-recycling.svg?raw';
import holz from '../assets/illustrations/branche-holz.svg?raw';
import stahl from '../assets/illustrations/branche-stahl.svg?raw';
import beton from '../assets/illustrations/branche-beton.svg?raw';
import { article, formatDay } from '../lib/ratgeber';
import { faqPage } from '../lib/seo.mjs';

const teasers = start.ratgeber.slugs.map((slug) => article(slug));
const h = start.handover;
const ind = start.industries;
/** Branchen-Bilder im Stil der Heukran-Bauformen: grau der Bestand, rot die Last am Haken. */
const illos: Record<string, string> = { recycling, holz, stahl, beton };
---
<Base title="" titleFull={start.title} description={start.description} jsonLd={[faqPage(start.faq)]}>
  <HomeHero
    eyebrow={start.hero.eyebrow}
    title={start.hero.h1}
    lead={start.hero.lead}
    trust={start.hero.trust}
    areasTitle={start.areas.h2}
    more={start.areas.more}
    claims={start.entries}
  />

  <Promises />

  <section class="section start-ind" aria-labelledby="branchen">
    <div class="wrap start-ind__grid">
      <div class="start-ind__head">
        <p class="label">{ind.eyebrow}</p>
        <h2 id="branchen">{ind.title}</h2>
        <Rich as="p" class="start-ind__text" text={ind.text} />
        <a class="btn btn--secondary start-ind__btn" href={ind.link.href}>{ind.link.label}<Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
      <ul role="list" class="start-ind__list">
        {industryList.map((b) => (
          <li>
            <span class="start-ind__illo" aria-hidden="true" set:html={illos[b.key]} />
            <span class="start-ind__name">{b.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="warum">
    <div class="wrap">
      <SectionHead eyebrow={start.why.eyebrow} title={start.why.h2} id="warum" />
      <div class="grid">
        <ol class="col-8 start-why" role="list">
          {start.why.items.map((it) => (
            <li class="start-why__item">
              <Rich as="h3" class="start-why__title" text={it.title} />
              <Rich as="p" text={it.text} />
            </li>
          ))}
        </ol>
        <aside class="col-4 start-portrait" aria-label="Clemens Fritsche">
          <Photo id="portraet-clemens" sizes="(min-width: 960px) 30vw, 60vw" />
          <Rich as="p" class="start-portrait__text" text={start.why.portrait.text} />
          <p class="small muted">{site.people.owner.name}</p>
          <a class="arrow-link" href="/ueber-uns">{start.why.portrait.link} <Icon name="arrow-right" size={18} /></a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="uebergabe">
    <div class="wrap grid start-handover">
      <div class="col-6 start-handover__text">
        <SectionHead eyebrow={h.eyebrow} title={h.h2} lead={h.lead} id="uebergabe" class="head--flush" />
        {site.features.heiriAdvisory && <Rich as="p" text={site.people.founder.advisory} />}
        <Quote text={h.quote} author={site.people.founder.name} role={`${site.people.founder.role} von HS Steiner`} />
        <div class="start-handover__links">
          <a class="arrow-link" href="/ueber-uns#uebergabe">Die ganze Geschichte <Icon name="arrow-right" size={18} /></a>
          <a class="arrow-link" href="/ueber-uns#fragen">Fragen zur Übergabe <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
      <div class="col-6 start-handover__media">
        <Photo id="clemens-heiri-quer" sizes="(min-width: 960px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ratgeber">
    <div class="wrap">
      <SectionHead eyebrow={start.ratgeber.eyebrow} title={start.ratgeber.h2} id="ratgeber" />
      <div class="cols-3">
        {teasers.map((a) => (
          <ArticleCard href={a.path} title={a.title} text={a.kurz[0]} date={a.updated} dateLabel={formatDay(a.updated)} />
        ))}
      </div>
      <p class="start-more"><a class="arrow-link" href="/ratgeber">{start.ratgeber.all} <Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="fragen">
    <div class="wrap">
      <SectionHead eyebrow="Fragen" title="Häufige Fragen" id="fragen" />
      <div class="start-faq"><Faq items={start.faq} /></div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .head--flush { margin-bottom: 0; }
  /* Branchen: links die Aussage, rechts die vier Branchen mit Bild, durch Haarlinien getrennt. */
  .start-ind__grid { display: grid; gap: var(--s-7) var(--s-8); align-items: center; }
  @media (min-width: 960px) { .start-ind__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .start-ind__head { display: grid; gap: var(--s-4); justify-items: start; }
  .start-ind__text { color: var(--ink-2); }
  .start-ind__btn { margin-top: var(--s-2); }
  .start-ind__list { border-top: 1px solid var(--line-2); }
  .start-ind__list li {
    display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: var(--s-5); align-items: center;
    padding-block: 12px; border-bottom: 1px solid var(--line-2);
  }
  .start-ind__illo { display: block; width: 96px; height: 76px; overflow: hidden; border-radius: var(--r-md); background: var(--paper); }
  .start-ind__illo :global(svg) { display: block; width: 100%; height: 100%; max-width: none; }
  .start-ind__name {
    font-family: var(--font-display); font-weight: 600; letter-spacing: var(--tracking-snug); color: var(--ink);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem); line-height: 1.2;
  }
  @media (max-width: 479px) {
    .start-ind__list li { grid-template-columns: 72px minmax(0, 1fr); gap: var(--s-4); }
    .start-ind__illo { width: 72px; height: 57px; }
  }

  .start-handover { align-items: start; row-gap: var(--s-7); }
  .start-handover__text { display: grid; gap: var(--s-5); align-content: start; }
  .start-handover__links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); }

  .start-why { display: grid; gap: 0 var(--s-6); grid-template-columns: minmax(0, 1fr); align-content: start; }
  @media (min-width: 720px) { .start-why { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .start-why__item { display: grid; gap: var(--s-2); align-content: start; padding: var(--s-5) 0 var(--s-6); border-top: 1px solid var(--line-2); }
  .start-why__title { font-size: 1.25rem; }
  .start-portrait { display: grid; gap: var(--s-3); align-content: start; justify-items: start; }
  .start-portrait :global(.ph), .start-portrait :global(picture) { max-width: 320px; }
  .start-portrait__text { font-size: 1.125rem; line-height: 1.45; color: var(--ink); font-weight: 500; letter-spacing: -0.01em; }
  @media (min-width: 960px) { .start-portrait { padding-left: var(--s-5); border-left: 1px solid var(--line); } }

  .start-more { margin-top: var(--s-6); }
  .start-faq { max-width: 52rem; }
</style>
