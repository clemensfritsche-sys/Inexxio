---
/**
 * Startseite – Reihenfolge nach Auftrag Kap. 7.3: Hero mit Vertrauensleiste → die drei
 * Bereiche → Übergabe → Warum → Ausgewählte Arbeiten (Schalter) → Wo wir arbeiten → Ratgeber →
 * Fragen → Anfrage. Texte: src/content/start.ts, Bereiche aus src/config/site.mjs.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SeasonNotice from '../components/SeasonNotice.astro';
import SectionHead from '../components/SectionHead.astro';
import Photo from '../components/Photo.astro';
import Quote from '../components/Quote.astro';
import AreaCard from '../components/AreaCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import { site } from '../config/site.mjs';
import { start } from '../content/start';
import { article, formatDay } from '../lib/ratgeber';
import { faqPage } from '../lib/seo.mjs';

const teasers = start.ratgeber.slugs.map((slug) => article(slug));
const h = start.handover;
---
<Base title="" titleFull={start.title} description={start.description} jsonLd={[faqPage(start.faq)]}>
  <Hero
    size="lg"
    eyebrow={start.hero.eyebrow}
    title={start.hero.h1}
    lead={start.hero.lead}
    photo="pruefung-hallenkran"
    primary={{ label: site.cta.label, href: '#anfrage' }}
    trust={start.hero.trust}
  />

  <section class="section" aria-labelledby="bereiche">
    <div class="wrap">
      <SectionHead eyebrow="Bereiche" title={start.areas.h2} lead={start.summary} id="bereiche" />
      <div class="cardgrid cardgrid--2 home-areas">
        {site.areas.map((a, i) => (
          <AreaCard
            title={a.label}
            href={a.href}
            text={a.text}
            photo={a.photo}
            links={a.children}
            more={start.areas.more}
            wide={i === site.areas.length - 1}
          />
        ))}
      </div>
      <div class="home-season"><SeasonNotice page="/" /></div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="uebergabe">
    <div class="wrap grid start-handover">
      <div class="col-6 start-handover__text">
        <SectionHead eyebrow={h.eyebrow} title={h.h2} lead={h.lead} id="uebergabe" class="head--flush" />
        {site.features.heiriAdvisory && <Rich as="p" text={site.people.founder.advisory} />}
        <Quote text={h.quote} author={site.people.founder.name} role={`${site.people.founder.role} von HS Steiner`} />
      </div>
      <div class="col-6 start-handover__media">
        <Photo id="clemens-heiri-quer" sizes="(min-width: 960px) 50vw, 100vw" />
      </div>
      <div class="col-12 start-handover__lists">
        <div>
          <h3 class="start-handover__h">Was bleibt</h3>
          <ul class="checklist" role="list">
            {h.stays.map((s) => <li><Icon name="check" size={20} /><Rich as="span" text={s} /></li>)}
          </ul>
        </div>
        <div>
          <h3 class="start-handover__h">Was neu ist</h3>
          <ul class="checklist" role="list">
            {h.news.map((s) => <li><Icon name="plus" size={20} /><Rich as="span" text={s} /></li>)}
          </ul>
        </div>
        <div class="start-handover__links">
          <a class="arrow-link" href="/uebergabe">Die ganze Geschichte <Icon name="arrow-right" size={18} /></a>
          <a class="arrow-link" href="/uebergabe#fragen">Fragen zur Übergabe <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="warum">
    <div class="wrap">
      <SectionHead eyebrow={start.why.eyebrow} title={start.why.h2} id="warum" />
      <div class="grid">
        <ol class="col-8 start-why" role="list">
          {start.why.items.map((it) => (
            <li class="start-why__item">
              <Rich as="h3" class="start-why__title" text={it.title} />
              <Rich as="p" text={it.text} />
            </li>
          ))}
        </ol>
        <aside class="col-4 start-portrait" aria-label="Clemens Fritsche">
          <Photo id="portraet-clemens" sizes="(min-width: 960px) 30vw, 60vw" />
          <Rich as="p" class="start-portrait__text" text={start.why.portrait.text} />
          <p class="small muted">{site.people.owner.name}, {site.people.owner.role}</p>
          <a class="arrow-link" href="/ueber-uns">{start.why.portrait.link} <Icon name="arrow-right" size={18} /></a>
        </aside>
      </div>
    </div>
  </section>

  {site.features.projects && (
    <section class="section section--paper" aria-labelledby="arbeiten">
      <div class="wrap">
        <SectionHead eyebrow={start.projects.eyebrow} title={start.projects.h2} id="arbeiten" />
        <ul role="list" class="cols-3 start-projects">
          {start.projects.items.map((p) => (
            <li>
              <Photo id={p.photo} sizes="(min-width: 1024px) 33vw, 100vw" />
              <p class="label">{p.area}</p>
              <Rich as="h3" text={p.title} />
              <Rich as="p" text={p.text} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class:list={['section', site.features.projects ? '' : 'section--paper']} aria-labelledby="wo-wir-arbeiten">
    <div class="wrap grid start-area">
      <div class="col-6 start-area__text">
        <SectionHead eyebrow={start.area.eyebrow} title={start.area.h2} id="wo-wir-arbeiten" class="head--flush" />
        <Rich as="p" text={start.area.text} />
        <Rich as="p" class="small muted" text={start.area.note} />
        <a class="arrow-link" href="/ueber-uns#wo-wir-arbeiten">{start.area.link} <Icon name="arrow-right" size={18} /></a>
      </div>
      <div class="col-6 start-area__media"><Photo id="arbeit-werkstatt" sizes="(min-width: 960px) 50vw, 100vw" /></div>
    </div>
  </section>

  <section class:list={['section', site.features.projects ? 'section--paper' : '']} aria-labelledby="ratgeber">
    <div class="wrap">
      <SectionHead eyebrow={start.ratgeber.eyebrow} title={start.ratgeber.h2} id="ratgeber" />
      <div class="cols-3">
        {teasers.map((a) => (
          <ArticleCard href={a.path} title={a.title} text={a.kurz[0]} date={a.updated} dateLabel={formatDay(a.updated)} />
        ))}
      </div>
      <p class="start-more"><a class="arrow-link" href="/ratgeber">{start.ratgeber.all} <Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="fragen">
    <div class="wrap">
      <SectionHead eyebrow="Fragen" title="Häufige Fragen" id="fragen" />
      <div class="start-faq"><Faq items={start.faq} /></div>
    </div>
  </section>

  <CtaBlock title={start.cta.h2} lead={start.cta.lead} kind="waehlen" />
</Base>

<style>
  .head--flush { margin-bottom: 0; }
  /* Krantechnik und Fahrzeugtechnik gleich gross nebeneinander, Sonderlösungen darunter breit. */
  .home-areas > :global(:last-child) { grid-column: 1 / -1; }
  .home-season :global(.season) { margin-top: var(--s-6); }

  .start-handover { align-items: start; row-gap: var(--s-7); }
  .start-handover__text { display: grid; gap: var(--s-5); align-content: start; }
  .start-handover__lists { display: grid; gap: var(--s-6); padding-top: var(--s-6); border-top: 1px solid var(--line-dark); }
  @media (min-width: 720px) { .start-handover__lists { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .start-handover__h { font-size: 1.125rem; margin-bottom: var(--s-4); }
  .start-handover__links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); }
  @media (min-width: 720px) { .start-handover__links { grid-column: 1 / -1; } }

  .start-why { display: grid; gap: 0 var(--s-6); grid-template-columns: minmax(0, 1fr); align-content: start; }
  @media (min-width: 720px) { .start-why { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .start-why__item { display: grid; gap: var(--s-2); align-content: start; padding: var(--s-5) 0 var(--s-6); border-top: 1px solid var(--line-2); }
  .start-why__title { font-size: 1.25rem; }
  .start-portrait { display: grid; gap: var(--s-3); align-content: start; justify-items: start; }
  .start-portrait :global(.ph), .start-portrait :global(picture) { max-width: 320px; }
  .start-portrait__text { font-size: 1.125rem; line-height: 1.45; color: var(--ink); font-weight: 500; letter-spacing: -0.01em; }
  @media (min-width: 960px) { .start-portrait { padding-left: var(--s-5); border-left: 1px solid var(--line); } }

  .start-projects { list-style: none; padding: 0; }
  .start-projects li { display: grid; gap: var(--s-2); align-content: start; }

  .start-area { align-items: center; }
  .start-area__text { display: grid; gap: var(--s-4); justify-items: start; }

  .start-more { margin-top: var(--s-6); }
  .start-faq { max-width: 52rem; }
</style>
