---
/**
 * /kontakt/danke – Ziel nach einer Anfrage OHNE JavaScript (der Server leitet mit 303 hierher).
 * Mit JavaScript erscheint dieselbe Bestätigung direkt am Formular.
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import { kontakt as k } from '../../content/kontakt';
---
<Base title={k.danke.title} description={k.description} crumbs={[{ name: 'Kontakt', path: '/kontakt' }, { name: 'Danke', path: '/kontakt/danke' }]} noindex>
  <section class="section danke" data-hero>
    <div class="wrap"><div class="danke__wrap">
      <Icon name="check" size={32} class="danke__icon" />
      <h1 class="danke__title">{k.danke.title}</h1>
      <Rich as="p" class="lead" text={k.danke.lead} />
      <ol role="list" class="danke__next">
        {k.danke.next.map((n, i) => (
          <li><span class="label">{String(i + 1).padStart(2, '0')}</span><Rich as="span" text={n} /></li>
        ))}
      </ol>
      <a class="arrow-link" href="/">Zur Startseite <Icon name="arrow-right" size={18} /></a>
    </div></div>
  </section>
</Base>

<style>
  .danke__wrap { display: grid; gap: var(--s-4); justify-items: start; max-width: 760px; }
  .danke__icon { color: var(--ok); }
  .danke__title { font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.5rem); }
  .danke__next { list-style: none; padding: 0; display: grid; gap: var(--s-3); margin-top: var(--s-3); border-top: 1px solid var(--line-2); padding-top: var(--s-4); }
  .danke__next li { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: var(--s-2); }
  .danke__next .label { padding-top: 4px; }
</style>
