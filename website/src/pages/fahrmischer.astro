---
/** /fahrmischer – Übersicht: Service, Reparatur, Trommel-Revision, Verschleissteile, Markenliste. */
import Service from '../layouts/Service.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Rich from '../components/Rich.astro';
import { fahrmischer } from '../content/fahrmischer';
import { site } from '../config/site.mjs';
---
<Service page={fahrmischer}>
  <section slot="intro" class="section" aria-labelledby="leistungen">
    <div class="wrap">
      <SectionHead
        eyebrow="Leistungen"
        title="Ein Ort für Ihre Fahrmischer"
        lead="Service, Reparatur, Revision und Verschleissteile – für alle gängigen Marken."
        id="leistungen"
      />
      <ServiceIndex items={fahrmischer.services} />
      <div class="fm-brands" aria-labelledby="marken">
        <h3 class="label fm-brands__title" id="marken">Marken</h3>
        <ul role="list" class="fm-brands__list">
          {site.marks.mixers.map((m) => <li>{m}</li>)}
          <li class="fm-brands__more">und weitere auf Anfrage</li>
        </ul>
        <Rich as="p" class="small muted" text={`${site.marks.mixerNotice} ${site.marks.mixerReview}`} />
      </div>
    </div>
  </section>
</Service>

<style>
  .fm-brands { display: grid; gap: var(--s-3); margin-top: var(--s-7); }
  .fm-brands__list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .fm-brands__list li { font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.375rem); font-weight: 650; color: var(--ink); letter-spacing: -0.015em; }
  .fm-brands__list .fm-brands__more { font-weight: 400; color: var(--ink-3); }
</style>
