---
/**
 * /spezialloesungen – eigenes Layout, weil die Seite in Sekunden sagen muss, worum es geht:
 * Seitenkopf (Aussage + Bild) mit vier
 * belegten Fakten → Das Prinzip (warum, was Sie davon haben) → Drei Felder, ein Prinzip
 * (Krane · Fahrzeuge · Baumaschinen) → Ablauf → Wer dahintersteht →
 * Garantie → Fragen → Anfrage. Texte: content/spezialloesungen.ts.
 */
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import Faq from '../components/Faq.astro';
import Promises from '../components/Promises.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../config/site.mjs';
import { faqPage, service as serviceNode } from '../lib/seo.mjs';
import { plain } from '../lib/text.mjs';
import krane from '../assets/illustrations/spezial-krane.svg?raw';
import fahrzeuge from '../assets/illustrations/spezial-fahrzeuge.svg?raw';
import baumaschinen from '../assets/illustrations/spezial-baumaschinen.svg?raw';
import {
  spezialloesungen as page, specialFacts as facts, specialPrinciple as pr, specialFields as fields,
  specialSteps as s, specialBackground as b,
} from '../content/spezialloesungen';

const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const nodes = [
  serviceNode(siteUrl, { name: page.service.name, serviceType: page.service.serviceType, path: page.path, description: plain(page.summary) }),
  faqPage(page.faq),
];
const ILLO = { krane, fahrzeuge, baumaschinen };
const illo = (k: keyof typeof ILLO, label: string) => ILLO[k].replace('<svg ', `<svg role="img" aria-label="${label}" `);
---
<Base title={page.title} description={page.description} crumbs={[{ name: page.crumb, path: page.path }]} og="spezialloesungen" jsonLd={nodes}>
  <section class="sx-hero" aria-labelledby="sx-title">
    <div class="wrap sx-hero__grid">
      <div class="sx-hero__text" data-hero>
        <p class="label">{page.hero.eyebrow}</p>
        <Rich as="h1" id="sx-title" class="hero__title sx-hero__title" text={page.hero.h1} />
        <Rich as="p" class="sx-hero__lead" text={page.hero.lead} />
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#anfrage">{page.hero.primary.label} <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
          <a class="btn btn--secondary btn--lg" href={`tel:${site.phone.e164}`} data-track="tel_click"><Icon name="phone" size={18} />{site.phone.display}</a>
        </div>
      </div>
      <figure class="sx-hero__fig">
        <div class="sx-hero__illo" set:html={illo('baumaschinen', 'Baumaschine mit Anbaugerät nach Mass')} />
      </figure>
    </div>
    <div class="wrap">
      <ul role="list" class="sx-facts" aria-label="Kurz gesagt">
        {facts.map((f) => <li><span class="sx-facts__v">{f.value}</span><span class="sx-facts__l">{f.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="prinzip">
    <div class="wrap">
      <div class="sx-principle">
        <p class="label">{pr.eyebrow}</p>
        <h2 id="prinzip" class="sx-principle__title">{pr.title}</h2>
        <Rich as="p" class="lead" text={pr.lead} />
      </div>
      <ul role="list" class="sx-gains">
        {pr.gains.map((g, i) => (
          <li class="sx-gains__item">
            <span class="sx-gains__n tnum">{String(i + 1).padStart(2, '0')}</span>
            <h3>{g.title}</h3>
            <Rich as="p" text={g.text} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--paper" id="felder" aria-labelledby="felder-title">
    <div class="wrap">
      <SectionHead eyebrow="Für jeden Bereich" title="Drei Felder, ein Prinzip" lead="Ob Kran, Fahrzeug oder Baumaschine: Wir nehmen, was die Serie kann, und bauen dazu, was Ihre Aufgabe braucht." id="felder-title" />
      <ul role="list" class="sx-fields">
        {fields.map((f) => (
          <li class="sx-field" id={f.id}>
            <div class="sx-field__illo" set:html={illo(f.illo, f.title)} />
            <div class="sx-field__body">
              <h3>{f.title}</h3>
              <Rich as="p" text={f.text} />
              <ul role="list" class="checklist sx-field__list">
                {f.examples.map((e) => <li><Icon name="check" size={18} /><span>{e}</span></li>)}
              </ul>
              {f.link && <a class="arrow-link sx-field__link" href={f.link.href}>{f.link.label} <Icon name="arrow-right" size={18} /></a>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="ablauf">
    <div class="wrap">
      <SectionHead eyebrow="Ablauf" title={s.title} lead={s.lead} id="ablauf" />
      <Steps steps={s.items} />
      <div class="btn-row sx-cta">
        <a class="btn btn--primary" href="#anfrage">Aufgabe schildern <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="hintergrund">
    <div class="wrap grid sx-bg">
      <div class="col-4"><Photo id="portraet-clemens" sizes="(min-width: 960px) 30vw, 70vw" /></div>
      <div class="col-7 sx-bg__text">
        <SectionHead eyebrow={b.eyebrow} title={b.title} id="hintergrund" class="head--flush" />
        <Rich as="p" text={b.text} />
        <ul role="list" class="checklist">
          {b.facts.map((f) => <li><Icon name="check" size={20} /><Rich as="span" text={f} /></li>)}
        </ul>
        <a class="arrow-link" href="/ueber-uns">Mehr über uns <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <Promises only={page.promises} lead={false} />

  <section class="section section--rule" aria-labelledby="fragen">
    <div class="wrap grid">
      <div class="col-4"><SectionHead eyebrow="Fragen" title="Häufige Fragen" id="fragen" /></div>
      <div class="col-8"><Faq items={page.faq} /></div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .head--flush { margin-bottom: 0; }

  /* Seitenkopf: Aussage links, Bild rechts, Fakten darunter an einer Haarlinie. */
  .sx-hero { padding-top: var(--s-8); padding-bottom: var(--s-7); }
  .sx-hero__grid { display: grid; gap: var(--s-7) var(--s-8); align-items: center; }
  @media (min-width: 960px) { .sx-hero__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); } }
  .sx-hero__text { display: grid; gap: var(--s-5); justify-items: start; }
  .sx-hero__title { margin: 0; font-size: clamp(2.25rem, 1.8rem + 1.4vw, 3rem); line-height: 1.083; }
  .sx-hero__lead { font-size: 1.125rem; line-height: 1.556; color: var(--ink-2); max-width: 34em; }
  .sx-hero__fig { margin: 0; display: grid; gap: var(--s-3); }
  .sx-hero__illo { aspect-ratio: 4 / 3; }
  .sx-hero__illo :global(svg), .sx-field__illo :global(svg) { display: block; width: 100%; height: 100%; max-width: none; }
  .sx-facts { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: var(--s-8); border-top: 1px solid var(--line); }
  .sx-facts li { display: grid; gap: 2px; padding-block: var(--s-5); }
  .sx-facts li + li { border-top: 1px solid var(--line); }
  @media (min-width: 560px) {
    .sx-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sx-facts li + li { border-top: 0; }
    .sx-facts li:nth-child(even) { border-left: 1px solid var(--line); padding-left: var(--s-5); }
    .sx-facts li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (min-width: 960px) {
    .sx-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sx-facts li:nth-child(n + 3) { border-top: 0; }
    .sx-facts li + li { border-left: 1px solid var(--line); padding-left: var(--s-5); }
  }
  .sx-facts__v { font-family: var(--font-display); font-size: 1.75rem; line-height: 1.15; font-weight: 600; letter-spacing: -0.03em; color: var(--ink); }
  .sx-facts__l { font-size: 0.875rem; color: var(--ink-3); }

  /* Das Prinzip: ein grosser Satz, darunter drei Gewinne an einer schwarzen Linie. */
  .sx-principle { display: grid; gap: var(--s-4); max-width: 56rem; }
  .sx-principle__title { max-width: 22em; }
  .sx-gains { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: var(--s-8); border-top: 1px solid var(--ink); }
  .sx-gains__item { display: grid; gap: var(--s-2); align-content: start; padding: var(--s-6) 0; }
  .sx-gains__item + .sx-gains__item { border-top: 1px solid var(--line-2); }
  @media (min-width: 900px) {
    .sx-gains { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sx-gains__item { padding-inline: var(--s-6); }
    .sx-gains__item:first-child { padding-left: 0; }
    .sx-gains__item:last-child { padding-right: 0; }
    .sx-gains__item + .sx-gains__item { border-top: 0; border-left: 1px solid var(--line-2); }
  }
  .sx-gains__n { font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.08em; color: var(--red); }
  .sx-gains__item h3 { font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); }
  .sx-gains__item p { color: var(--ink-2); }

  /* Drei Felder: Bild oben, gleich gross, gleich gegliedert. */
  .sx-fields { display: grid; gap: var(--s-4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .sx-fields { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .sx-field { display: flex; flex-direction: column; overflow: hidden; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); scroll-margin-top: calc(var(--header-h) + var(--s-5)); }
  .sx-field__illo { aspect-ratio: 4 / 3; background: var(--paper); border-bottom: 1px solid var(--line); }
  .sx-field__body { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); flex: 1; }
  .sx-field__body h3 { font-family: var(--font-sans); font-size: 1.125rem; line-height: 1.556; letter-spacing: -0.006em; }
  .sx-field__body > p { color: var(--ink-2); }
  .sx-field__link { margin-top: auto; padding-top: var(--s-3); }

  .sx-cta { margin-top: var(--s-8); justify-content: center; }
  .sx-bg { align-items: center; }
  @media (min-width: 960px) { .sx-bg__text { grid-column: 6 / span 7; } }
  .sx-bg__text { display: grid; gap: var(--s-4); justify-items: start; }

  /* Ein Hintergrund für die ganze Seite – Abschnitte trennt der Weissraum, nicht die Fläche. */
  :global(body:has(.sx-hero) main) { background: var(--paper); }
  :global(body:has(.sx-hero) main .section),
  :global(body:has(.sx-hero) main .pr) { background: transparent; border-top: 0; border-bottom: 0; padding-block: clamp(64px, 4rem + 2.5vw, 96px); }
  :global(body:has(.sx-hero) main .contact__title) { font-size: 2rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.015em; }
  :global(body:has(.sx-hero) main .pr__claim) { font-size: 1.5rem; line-height: 1.333; letter-spacing: -0.015em; }
  :global(body:has(.sx-hero) main :is(.steps__title, .pr__test-title, .faq__title)) { font-family: var(--font-sans); font-size: 1.125rem; line-height: 1.556; letter-spacing: -0.006em; }

  /* Ablauf als Weg: Nummern auf einer Linie, die zum Ziel hin rot wird. */
  @media (min-width: 900px) {
    :global(body:has(.sx-hero) .steps) { padding: 0; column-gap: var(--s-4); margin-top: var(--s-2); }
    :global(body:has(.sx-hero) .steps__rail) { top: 20px; height: 2px; left: 10%; right: 10%; }
    :global(body:has(.sx-hero) .steps__line) { top: 0; height: 2px; background: linear-gradient(90deg, var(--line-2), var(--red)); }
    :global(body:has(.sx-hero) .steps__cat) { display: none; }
    :global(body:has(.sx-hero) .steps__item) { position: relative; justify-items: center; text-align: center; padding: 0; }
    :global(body:has(.sx-hero) .steps__no) {
      position: relative; z-index: 1; display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: var(--s-5);
      border-radius: 999px; background: var(--white); border: 1px solid var(--line-2); color: var(--ink);
      font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.04em;
      transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
    }
    :global(body:has(.sx-hero) .steps__item:last-child .steps__no) { background: var(--red); border-color: var(--red); color: var(--white); }
    :global(body:has(.sx-hero) .steps__item:not(:last-child):hover .steps__no) { border-color: var(--red); color: var(--red); }
    :global(body:has(.sx-hero) .steps__title) { margin-bottom: var(--s-1); }
    :global(body:has(.sx-hero) .steps__text) { font-size: 0.875rem; line-height: 1.43; color: var(--ink-3); max-width: 22ch; }
  }
</style>
