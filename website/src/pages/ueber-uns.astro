---
/**
 * /ueber-uns – eigenes Layout nach dem Muster von Startseite und Speziallösungen (Oktober 2026):
 * Kopf wie Porsche (StageHero, Zeichnung des Betriebs) → ein Betrieb aus der Praxis (Zahlen) →
 * drei Bereiche (Baustein der Startseite) → Geschichte als Weg (SolutionPath, Jahre statt
 * Nummern) → die Übergabe (Heiri und Clemens) mit «Was bleibt / was neu ist» → Werte →
 * Garantien (Baustein der Startseite) → mehr von uns (Ratgeber, Karriere) → Fragen → Anfrage.
 * Der Standort steht im Kontaktbereich (Karte). Texte: content/ueber-uns.ts, content/uebergabe.ts.
 * Soll auch bei «HS Steiner Tuttwil», «HS Steiner Nachfolge» und «HS Krananlagen» gefunden werden.
 */
import Base from '../layouts/Base.astro';
import StageHero from '../components/StageHero.astro';
import AreaTrio from '../components/home/AreaTrio.astro';
import SolutionPath from '../components/spezial/SolutionPath.astro';
import Guarantees from '../components/home/Guarantees.astro';
import Handover from '../components/home/Handover.astro';
import FaqStage from '../components/FaqStage.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import { ueberUns as u } from '../content/ueber-uns';
import { handover as h } from '../content/uebergabe';
import { faqPage, owner } from '../lib/seo.mjs';
import { plain } from '../lib/text.mjs';
import titel from '../assets/illustrations/ueber-titel.webp';
import ratgeber from '../assets/illustrations/menu/ratgeber.svg?url';
import karriere from '../assets/illustrations/menu/karriere.svg?url';

const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const faq = [...h.faq, ...u.areaFaq];
const ART = { ratgeber, karriere };
const history = u.history.items.map((s) => ({ ...s, no: plain(s.no), title: plain(s.title) }));
---
<Base title={u.title} description={u.description} crumbs={[{ name: 'Über uns', path: '/ueber-uns' }]} jsonLd={[owner(siteUrl), faqPage(faq)]}>
  <StageHero
    word="Über uns"
    image={titel}
    alt="Zeichnung: der Betrieb in Tuttwil, vor dem offenen Tor ein Mitarbeiter mit rotem Helm"
    title={u.hero.h1}
    lead={u.hero.lead}
    primary={{ label: 'Kontakt aufnehmen', href: '#anfrage' }}
    secondary={{ label: 'Unsere Geschichte', href: '#geschichte' }}
    narrow
  />

  <section class="v4-section" aria-labelledby="wir">
    <div class="wrap uu-team">
      <div class="uu-team__text">
        <h2 class="v4-h2" id="wir">{u.team.title}</h2>
        <Rich as="p" class="v4-sub" text={u.team.text} />
      </div>
      <dl class="uu-figs">
        {u.team.figures.map((f) => (
          <div class="uu-fig">
            <dt class="uu-fig__num tnum">{plain(f.figure)}</dt>
            <Rich as="dd" text={f.text} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <AreaTrio />

  <SolutionPath id="geschichte" title={u.history.title} start={plain(u.history.start)} end={plain(u.history.end)} items={history} />

  <Handover title={u.people.title} lead={u.people.lead}>
    <ul role="list" class="uu-voices">
      {u.people.voices.map((v) => <li><strong>«{v.q}»</strong> <span>– {plain(v.who)}</span></li>)}
    </ul>
    <dl class="uu-change">
      <div><dt><Icon name="check" size={16} />Bleibt</dt><Rich as="dd" text={u.people.stays} /></div>
      <div><dt><Icon name="plus" size={16} />Neu</dt><Rich as="dd" text={u.people.news} /></div>
    </dl>
  </Handover>

  <section class="v4-section" aria-labelledby="werte">
    <div class="wrap">
      <h2 class="uu-values__h" id="werte">{u.values.title}</h2>
      <ul role="list" class="uu-values">
        {u.values.items.map((v) => <li><strong>{v.title}</strong> <Rich as="span" text={v.text} /></li>)}
      </ul>
    </div>
  </section>

  <Guarantees garantieHref="#fragen" />

  <section class="v4-section" aria-labelledby="mehr">
    <div class="wrap">
      <header class="v4-head--center"><h2 class="v4-h2" id="mehr">{u.more.title}</h2></header>
      <ul role="list" class="uu-more">
        {u.more.items.map((m) => (
          <li><a class="uu-more__card" href={m.href}>
            <img src={ART[m.illo]} alt="" width="320" height="200" loading="lazy" decoding="async" />
            <span class="uu-more__title">{m.title}</span>
            <Rich as="span" class="uu-more__text" text={m.text} />
            <span class="garrow garrow--sm garrow--ink" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <FaqStage items={faq} illo={'menu/ueber'} />

  <ContactSection />
</Base>

<style>
  /* Ein Betrieb aus der Praxis: links der Satz, rechts vier Zahlen mit Haarlinie (wie technische Daten). */
  .uu-team { display: grid; gap: 40px; }
  .uu-figs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; margin: 0; }
  .uu-fig { display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: 1px solid var(--line-2); }
  .uu-fig__num { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem); line-height: 1; white-space: nowrap; letter-spacing: -0.04em; color: var(--ink); }
  .uu-fig :global(dd) { margin: 0; font-size: 0.9375rem; line-height: 1.45; color: var(--gray-500); }
  @media (min-width: 960px) {
    .uu-team { grid-template-columns: 5fr 7fr; gap: 80px; align-items: end; }
    .uu-figs { gap: 48px 40px; }
  }

  /* Die Übergabe (Baustein der Startseite): zwei Stimmen, darunter knapp, was bleibt und was neu ist. */
  .uu-voices { list-style: none; padding: 0; display: grid; gap: 6px; margin-top: 16px; font-size: 0.9375rem; }
  .uu-voices span { color: var(--gray-500); }
  .uu-change { display: grid; gap: 8px; margin: 20px 0 0; padding-top: 16px; border-top: 1px solid var(--line); font-size: 0.875rem; }
  .uu-change div { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 8px; }
  .uu-change dt { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--ink); }
  .uu-change :global(dd) { margin: 0; color: var(--ink-2); }

  /* Werte, locker: grosse Zeilen – das Wort dunkel, der halbe Satz dahinter leise. Beim Zeigen wird der Satz dunkel. */
  .uu-values__h { font-size: 0.9375rem; font-weight: 600; color: var(--gray-500); }
  .uu-values { list-style: none; padding: 0; margin-top: 20px; display: grid; gap: 6px; }
  .uu-values li { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.5rem); line-height: 1.12; letter-spacing: -0.035em; color: var(--ink); }
  .uu-values li :global(span) { color: var(--gray-500); transition: color 0.4s var(--ease); }
  .uu-values li:hover :global(span) { color: var(--ink-2); }
  @media (min-width: 960px) { .uu-values li:nth-child(even) { padding-left: 8%; } }

  /* Mehr von uns: zwei graue Karten mit der Zeichnung aus dem Menü. */
  .uu-more { list-style: none; padding: 0; display: grid; gap: 16px; margin-top: 40px; }
  @media (min-width: 720px) { .uu-more { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  .uu-more__card { position: relative; display: grid; gap: 6px; padding: 24px 28px 28px; border-radius: 24px; background: var(--gray-100); color: var(--ink); text-decoration: none; }
  .uu-more__card img { width: 100%; height: 200px; object-fit: contain; margin-bottom: 12px; transition: transform 0.6s var(--ease); }
  .uu-more__card:hover img { transform: translateY(-6px); }
  .uu-more__title { font-family: var(--font-display); font-weight: 600; font-size: 1.625rem; letter-spacing: -0.02em; }
  .uu-more__card :global(.uu-more__text) { color: var(--gray-500); padding-right: 56px; }
  .uu-more__card .garrow { position: absolute; right: 24px; bottom: 24px; }
</style>
