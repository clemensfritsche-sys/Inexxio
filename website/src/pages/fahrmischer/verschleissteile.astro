---
/** /fahrmischer/verschleissteile – Katalog aus der Konfiguration, gruppiert, ohne Filter, ohne Preise, ohne Shop. */
import Service from '../../layouts/Service.astro';
import SectionHead from '../../components/SectionHead.astro';
import PartCatalog from '../../components/PartCatalog.astro';
import Rich from '../../components/Rich.astro';
import { verschleissteile } from '../../content/fahrmischer';
import { catalog } from '../../config/catalog.mjs';
---
<Service page={verschleissteile}>
  <section slot="module" class="section section--paper" id="katalog" aria-labelledby="katalog-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Katalog"
        title="Verschleissteile nach Teileart"
        lead="Je Teil: kurze Beschreibung, Material und passende Marken. «Teil anfragen» öffnet die Anfrage mit dem Teil schon eingetragen."
        id="katalog-title"
      />
      <Rich as="p" class="small cat-note" text={`${catalog.priceNote} ${catalog.review}`} />
      <PartCatalog />
    </div>
  </section>
</Service>

<style>
  .cat-note { margin: calc(var(--s-5) * -1) 0 var(--s-6); }
</style>
