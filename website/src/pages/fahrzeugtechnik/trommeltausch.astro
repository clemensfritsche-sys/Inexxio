---
/**
 * /fahrzeugtechnik/trommeltausch – das erste eigene Produkt der Fahrzeugtechnik
 * (STRATEGIE.md): neue Trommel auf dem bestehenden Fahrgestell statt eines neuen
 * Fahrmischers. Modul: Vergleich Trommeltausch ↔ Neukauf (qualitativ, ohne Zahlen).
 */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import { trommeltausch, drumCompare as c } from '../../content/fahrzeugtechnik';
import { product } from '../../lib/seo.mjs';
import { plain } from '../../lib/text.mjs';
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const productNode = product(siteUrl, { name: 'Trommeltausch für Fahrmischer', description: plain(trommeltausch.summary), path: trommeltausch.path });
---
<SubPage page={trommeltausch} jsonLd={[productNode]}>
  <section slot="module" class="section" aria-labelledby="vergleich">
    <div class="wrap">
      <SectionHead eyebrow="Ohne Investition" title={c.title} lead={c.lead} id="vergleich" />
      <div class="cmp" role="table" aria-label={c.title}>
        <div class="cmp__row cmp__row--head" role="row">
          <span role="columnheader"></span>
          <span role="columnheader" class="cmp__swap">Trommeltausch</span>
          <span role="columnheader">Neuer Fahrmischer</span>
        </div>
        {c.rows.map((r) => (
          <div class="cmp__row" role="row">
            <span role="rowheader" class="cmp__topic">{r.topic}</span>
            <span role="cell" class="cmp__swap"><Icon name="check" size={18} />{r.swap}</span>
            <span role="cell">{r.buy}</span>
          </div>
        ))}
      </div>
      <div class="btn-row cmp__cta">
        <a class="btn btn--primary" href="#anfrage">Trommeltausch anfragen <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
    </div>
  </section>
</SubPage>

<style>
  .cmp { display: grid; border-top: 2px solid var(--ink); }
  .cmp__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px var(--s-4); padding: var(--s-3) 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 720px) { .cmp__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1.4fr); align-items: baseline; } }
  .cmp__row--head { font-size: 0.875rem; font-weight: 700; color: var(--ink); }
  @media (max-width: 719px) { .cmp__row--head { display: none; } }
  .cmp__topic { font-weight: 600; color: var(--ink); }
  .cmp__swap { display: inline-flex; gap: 8px; align-items: baseline; color: var(--ink); font-weight: 500; }
  .cmp__swap :global(.icon) { color: var(--ok); flex: none; align-self: center; }
  .cmp__cta { margin-top: var(--s-6); }
</style>
