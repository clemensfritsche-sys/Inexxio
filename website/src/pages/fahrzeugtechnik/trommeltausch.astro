---
/**
 * /fahrzeugtechnik/trommeltausch – das stärkste Angebot der Fahrzeugtechnik, eigenes Layout nach
 * dem Muster von Speziallösungen (Oktober 2026): Kopf wie Porsche → Tauschen, überholen – oder neu?
 * (#wahl, die eine dunkle Karte) → Was zum Tausch gehört (Weg) → Im Winter (#winter, Ziel der
 * Saison-Aktion) → Marken → Garantien → Fragen → Anfrage. Texte: content/fahrzeugtechnik.ts.
 */
import Base from '../../layouts/Base.astro';
import StageHero from '../../components/StageHero.astro';
import DrumChoice from '../../components/fahrzeug/DrumChoice.astro';
import SolutionPath from '../../components/spezial/SolutionPath.astro';
import WinterBand from '../../components/fahrzeug/WinterBand.astro';
import BrandBand from '../../components/fahrzeug/BrandBand.astro';
import Guarantees from '../../components/home/Guarantees.astro';
import FaqStage from '../../components/FaqStage.astro';
import ContactSection from '../../components/ContactSection.astro';
import { areaOf } from '../../config/site.mjs';
import { faqPage, product, service as serviceNode } from '../../lib/seo.mjs';
import { plain } from '../../lib/text.mjs';
import titel from '../../assets/illustrations/menu/trommeltausch.svg';
import { trommeltausch as page, drumOptions as d, drumPath as p, winterSlot as w } from '../../content/fahrzeugtechnik';

const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const area = areaOf(page.area);
const nodes = [
  serviceNode(siteUrl, { name: page.service.name, serviceType: page.service.serviceType, path: page.path, description: plain(page.summary) }),
  faqPage(page.faq),
  product(siteUrl, {
    name: 'Trommeltausch für Fahrmischer',
    description: 'Neue Mischtrommel auf dem bestehenden Fahrgestell statt eines neuen Fahrmischers – für alle gängigen Marken.',
    path: page.path,
    category: 'Fahrmischer-Trommel',
    og: 'fahrzeugtechnik',
  }),
];
---
<Base title={page.title} description={page.description} crumbs={[{ name: area.label, path: area.href }, { name: page.crumb, path: page.path }]} og={page.area} jsonLd={nodes}>
  <StageHero
    word="Trommeltausch"
    image={titel}
    alt="Zeichnung: Fahrmischer mit neuer Trommel, die alte Trommel liegt daneben"
    title={page.hero.h1}
    lead={page.hero.lead}
    primary={page.hero.primary}
    secondary={{ label: 'Tauschen oder überholen?', href: '#wahl' }}
    narrow
  />

  <DrumChoice title={d.title} lead={d.lead} topics={d.topics} options={d.options} cta={d.cta} />

  <SolutionPath title={p.title} start={p.start} end={p.end} items={p.items} />

  <WinterBand {...w} />

  <BrandBand />

  <Guarantees garantieHref="#fragen" />

  <FaqStage items={page.faq} illo={'menu/trommeltausch'} />

  <ContactSection />
</Base>
