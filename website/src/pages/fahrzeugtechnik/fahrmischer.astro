---
/**
 * /fahrzeugtechnik/fahrmischer – Trommeltausch, Trommel-Revision, Service und Reparatur auf
 * EINER Seite. Zuerst die Trommel (#trommel, gleich nach den Versprechen), dann
 * der Winter als Zeitpunkt (#winter-revision) und das Marken-Band.
 */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import { fahrmischer, drumOptions as d, winterRevision as w } from '../../content/fahrzeugtechnik';
import { site } from '../../config/site.mjs';
import { product } from '../../lib/seo.mjs';
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const productNode = product(siteUrl, {
  name: 'Trommeltausch für Fahrmischer',
  description: 'Neue Mischtrommel auf dem bestehenden Fahrgestell statt eines neuen Fahrmischers – für alle gängigen Marken.',
  path: `${fahrmischer.path}#trommel`,
  category: 'Fahrmischer-Trommel',
  og: 'fahrzeugtechnik',
});
const LOGOS = import.meta.glob<string>('../../assets/marken/*.svg', { eager: true, query: '?raw', import: 'default' });
---
<SubPage page={fahrmischer} jsonLd={[productNode]}>
  <section slot="intro" class="section" id="trommel" aria-labelledby="trommel-title">
    <div class="wrap">
      <SectionHead eyebrow="Trommel" title={d.title} lead={d.lead} id="trommel-title" />
      <ul role="list" class="drum">
        {d.options.map((o) => (
          <li class:list={['drum__opt', o.own && 'drum__opt--own']}>
            <h3 class="drum__name">{o.name}</h3>
            <dl class="drum__list">
              {d.topics.map((t, i) => (
                <div><dt>{t}</dt><dd>{o.values[i]}</dd></div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
      <div class="btn-row drum__cta">
        <a class="btn btn--primary" href="#anfrage">Trommel prüfen lassen <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
      </div>
    </div>
  </section>

  <section slot="module" class="section section--dark" id="winter-revision" aria-labelledby="winter-title">
    <div class="wrap grid wr">
      <div class="col-6 wr__text">
        <SectionHead eyebrow="November bis Februar" title={w.title} lead={w.text} id="winter-title" class="head--flush" />
        <div class="btn-row">
          <a class="btn btn--primary" href="#anfrage">{w.cta} <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
        </div>
      </div>
      <div class="col-5 wr__list">
        <h3 class="label">Was wir überholen</h3>
        <ul class="checklist" role="list">
          {w.items.map((i) => <li><Icon name="check" size={20} /><span>{i}</span></li>)}
        </ul>
      </div>
      <div class="col-12 wr__brands">
        <h3 class="label">Marken</h3>
        <!-- Referenz-Band (#1185): je Marke eine Kachel; liegt ihr Logo in src/assets/marken/<name>.svg, steht es dort, sonst der Schriftzug. -->
        <ul class="wr__brandlist" role="list">
          {site.marks.mixers.map((b) => {
            const logo = LOGOS[`../../assets/marken/${b.toLowerCase()}.svg`];
            return <li class="wr__brand" title={b}>{logo ? <span class="wr__logo" set:html={logo} aria-label={b} role="img" /> : <span class="wr__word">{b}</span>}</li>;
          })}
          <li class="wr__brand wr__brand--more">und weitere auf Anfrage</li>
        </ul>
        <Rich as="p" class="small" text={site.marks.mixerNotice} />
      </div>
    </div>
  </section>
</SubPage>

<style>
  .drum { display: grid; gap: var(--s-4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 860px) { .drum { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .drum__opt { display: grid; gap: var(--s-3); align-content: start; padding: var(--s-5); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--white); }
  .drum__opt--own { border: 2px solid var(--ink); }
  .drum__name { font-size: 1.375rem; }
  .drum__list { display: grid; gap: var(--s-3); }
  .drum__list dt { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); }
  .drum__list dd { margin: 2px 0 0; color: var(--ink); }
  .drum__cta { margin-top: var(--s-6); }

  .wr { row-gap: var(--s-7); }
  .wr__text { display: grid; gap: var(--s-5); justify-items: start; }
  .head--flush { margin-bottom: 0; }
  @media (min-width: 960px) { .wr__list { grid-column: 8 / span 5; } }
  .wr__list { display: grid; gap: var(--s-4); align-content: start; }
  .wr__brands { display: grid; gap: var(--s-3); padding-top: var(--s-6); border-top: 1px solid var(--line-dark); }
  .wr__brandlist { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); border-radius: var(--r-md); overflow: hidden; }
  .wr__brand { display: grid; place-items: center; min-height: 84px; padding: var(--s-4); background: var(--ink); text-align: center; }
  .wr__word { font-family: var(--font-display, inherit); font-weight: 700; font-size: 1.125rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--white); opacity: 0.85; }
  .wr__logo { display: block; width: 100%; max-width: 120px; color: var(--white); }
  .wr__logo :global(svg) { display: block; width: 100%; height: auto; max-height: 40px; }
  .wr__brand--more { font-size: 0.875rem; color: rgba(244, 243, 241, 0.65); }
</style>
