---
/**
 * /fahrzeugtechnik/verschleissteile – der Teilekatalog nach Teileart (#katalog). «Teil
 * anfragen» öffnet die Anfrage mit dem Teil schon eingetragen. Keine Preise, kein «ab Lager».
 */
import SubPage from '../../layouts/SubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Rich from '../../components/Rich.astro';
import PartCatalog from '../../components/PartCatalog.astro';
import { verschleissteile } from '../../content/fahrzeugtechnik';
import { catalog } from '../../config/catalog.mjs';
---
<SubPage page={verschleissteile}>
  <section slot="intro" class="section" id="katalog" aria-labelledby="katalog-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Katalog"
        title="Verschleissteile nach Teileart"
        lead="Je Teil: kurze Beschreibung, Material und passende Marken. «Teil anfragen» öffnet die Anfrage mit dem Teil schon eingetragen."
        id="katalog-title"
      />
      <Rich as="p" class="small cat-note" text={catalog.priceNote} />
      <PartCatalog />
    </div>
  </section>
</SubPage>

<style>
  .cat-note { margin: calc(var(--s-5) * -1) 0 var(--s-6); }
</style>
