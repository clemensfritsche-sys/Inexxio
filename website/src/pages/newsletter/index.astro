---
/**
 * /newsletter – Anmeldung zu «Post von INEXXIO» (v4, components/NewsletterStage). Ohne JavaScript:
 * der Server schickt die Bitte um Bestätigung und leitet mit 303 auf /newsletter/danke (Double
 * Opt-in). Das Feld trägt den roten Pfeil wie das Anfrage-Feld (styles/form.css, `.iform__send`).
 */
import Base from '../../layouts/Base.astro';
import NewsletterStage from '../../components/NewsletterStage.astro';
import Icon from '../../components/Icon.astro';
import { currentLang, SOURCE } from '../../config/languages.mjs';
import { newsletterPages as n } from '../../content/newsletter';
import '../../styles/form.css';
import { t } from '../../i18n/t.mjs';
---
<Base title={t('seiten', 'Newsletter')} description={n.description} crumbs={[{ name: t('seiten', 'Newsletter'), path: '/newsletter' }]} noindex>
  <NewsletterStage word={n.signup.eyebrow} eyebrow={n.signup.eyebrow} title={n.signup.title} lead={n.signup.lead}>
    <form class="nlf" method="post" action={`/api/v1/newsletter${currentLang().code === SOURCE ? '' : `?lang=${currentLang().code}`}`}>
      <div class="iform__hp" aria-hidden="true">
        <label>{t('ui', 'Bitte leer lassen')} <input type="text" name="hp" tabindex="-1" autocomplete="off" /></label>
      </div>
      <label class="visually-hidden" for="nl-email">{n.signup.label}</label>
      <div class="nlf__field">
        <input id="nl-email" name="email" type="email" required maxlength="160" autocomplete="email" placeholder={n.signup.label} />
        <button type="submit" class="iform__send" aria-label={n.signup.button}><Icon name="send" size={22} /></button>
      </div>
    </form>
    <p class="nlf__small">{n.signup.small} <a class="link" href="/datenschutz">{t('ui', 'Datenschutz')}</a>.</p>
  </NewsletterStage>
</Base>

<style>
  .nlf__field {
    display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 20px; border: 1px solid var(--line-2); border-radius: var(--r-xl);
    background: var(--white); box-shadow: 0 6px 18px rgba(10, 10, 11, 0.05); transition: box-shadow 0.2s var(--ease);
  }
  .nlf__field:focus-within { box-shadow: var(--focus-ring); }
  .nlf__field input { flex: 1; min-width: 0; min-height: 52px; border: 0; outline: 0; background: transparent; font-size: 1.0625rem; color: var(--ink); }
  .nlf__field input::placeholder { color: var(--gray-500); }
  .nlf__small { margin-top: 14px; max-width: 520px; font-size: 0.8125rem; line-height: 1.5; color: var(--ink-3); }
</style>
