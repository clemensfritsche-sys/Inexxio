---
/**
 * Ablauf in Schritten (Anfrage → Abklärung → Umsetzung → Bericht): grosse rote Ziffer,
 * Titel, ein Satz – nebeneinander auf breitem Schirm, darunter gestapelt. Verbunden durch die
 * Kranbahn-Linie (Auftrag 9.6): eine feine Linie mit einem kleinen roten Quadrat am Ende, wie
 * eine Laufkatze auf der Kranbahn. Sie zeichnet sich beim Hineinscrollen einmal ein
 * (scripts/reveal.ts) und ist das einzige Element mit «Persönlichkeit» – darum nur hier und
 * im Zeitstrahl, höchstens dreimal je Seite (check-site prüft es).
 */
import Rich from './Rich.astro';

interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---
<ol class="steps" role="list" style={`--n: ${steps.length}`}>
  <li class="steps__rail" aria-hidden="true" data-kranbahn><span class="steps__line"></span><span class="steps__cat"></span></li>
  {steps.map((s, i) => (
    <li class="steps__item">
      <span class="steps__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <Rich as="h3" class="steps__title" text={s.title} />
      <Rich as="p" class="steps__text" text={s.text} />
    </li>
  ))}
</ol>

<style>
  /* Mobil: die Linie läuft links senkrecht an den Schritten entlang. */
  .steps { position: relative; list-style: none; padding: 0 0 0 30px; margin: 0; display: grid; }
  .steps__rail { position: absolute; left: 0; top: 10px; bottom: 10px; width: 11px; }
  .steps__line { position: absolute; left: 5px; top: 0; bottom: 0; width: 1px; background: var(--ink); transform-origin: top center; }
  .steps__cat { position: absolute; left: 0; bottom: 0; width: 11px; height: 11px; background: var(--red); }
  .steps__item {
    display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: var(--s-4); row-gap: var(--s-2);
    align-content: start; padding: var(--s-5) 0; border-bottom: 1px solid var(--line);
  }
  .steps__item:nth-child(2) { padding-top: 0; }
  .steps__no {
    grid-row: 1 / span 2; font-family: var(--font-display); font-weight: 600; font-size: 1.75rem;
    line-height: 1; letter-spacing: var(--tracking-tight); color: var(--red); font-variant-numeric: tabular-nums;
  }
  .steps__title { font-size: 1.1875rem; }
  .steps__text { color: var(--ink-2); max-width: 36ch; }
  :global(.section--paper) .steps__no { color: var(--red-deep); }
  :global(.section--dark) .steps__item { border-color: var(--line-dark); }
  :global(.section--dark) .steps__line { background: rgba(255, 255, 255, 0.5); }
  :global(.section--dark) .steps__no { color: var(--red-bright); }
  /* Der Schrittext trägt eine eigene Farbe (ink-2) – auf dunklem Grund wäre das 2:1 (axe). */
  :global(.section--dark) .steps__text { color: rgba(244, 243, 241, 0.72); }

  .steps__rail:global(.is-armed) .steps__line { transform: scaleY(0); }
  .steps__rail:global(.is-armed) .steps__cat { opacity: 0; }
  .steps__rail:global(.is-drawn) .steps__line { transform: none; transition: transform 800ms var(--ease); }
  .steps__rail:global(.is-drawn) .steps__cat { opacity: 1; transition: opacity 300ms var(--ease) 650ms; }

  /* Breit: die Linie läuft oben waagrecht über alle Schritte, die Laufkatze am Ende. */
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); padding: 34px 0 0; column-gap: var(--s-5); }
    .steps__rail { left: 0; right: 0; top: 0; bottom: auto; width: auto; height: 11px; }
    .steps__line { left: 0; right: 0; top: 5px; bottom: auto; width: auto; height: 1px; transform-origin: left center; }
    .steps__cat { left: auto; right: 0; bottom: auto; top: 0; }
    .steps__rail:global(.is-armed) .steps__line { transform: scaleX(0); }
    .steps__item, .steps__item:nth-child(2) { grid-template-columns: minmax(0, 1fr); padding: 0; border-bottom: 0; }
    .steps__no { grid-row: auto; margin-bottom: var(--s-3); }
  }
</style>
