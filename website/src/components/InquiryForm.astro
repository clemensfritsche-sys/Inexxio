---
/**
 * DAS Anfrage-Formular – auf /kontakt und am Ende jeder Seite dasselbe (#1107/#1129).
 *
 * ►►► v4: zwei Schritte (Vorlage «Startseite v4»): erst das Anliegen, dann wie wir Sie
 * erreichen. ◄◄◄ Schritt 1 ist EIN Feld (Glas über der Karte) mit «Foto anhängen» und
 * «Weiter»; Schritt 2 nennt das Anliegen in einer Zeile («Ändern») und fragt Name, E-Mail,
 * Telefon und Firma. Ist jemand angemeldet, stehen diese schon da (scripts/form.ts).
 *
 * Ohne JavaScript ist es EIN Formular mit allen Feldern, klassisch an den Server (multipart,
 * Prüfung dort). Das Skript führt die Schritte, prüft am Feld und sendet im Hintergrund;
 * schlägt das Senden fehl, steht ein vorausgefüllter mailto-Link da.
 */
import { contactEmail } from '../config/site.mjs';
import { inquiry } from '../config/inquiry.mjs';
import { newsletter } from '../config/newsletter.mjs';
import { plain } from '../lib/text.mjs';
import { formVocab } from '../lib/inquiry-vocab.mjs';
import Icon from './Icon.astro';
import FormResult from './FormResult.astro';
import '../styles/form.css';

interface Props {
  id?: string;
  /** 2 = Formular direkt unter der H1 (/kontakt), 3 = in einer Sektion mit H2. */
  resultLevel?: 2 | 3;
}
const { id = 'anfrage-form', resultLevel = 3 } = Astro.props;
const L = inquiry.limits;
/** Vokabular für Prüfung und mailto im Browser – dasselbe, das der Server bekommt. */
const vocab = JSON.stringify(formVocab());
const f = (name: string) => `${id}-${name}`;
---
<div class="iform-wrap" data-inquiry-root>
  <FormResult level={resultLevel} />
  <form
    id={id}
    class="iform"
    method="post"
    action="/api/v1/contact"
    enctype="multipart/form-data"
    data-inquiry
    data-step="1"
    data-min-seconds={inquiry.minSeconds}
    data-max-files={inquiry.photos.max}
    data-max-bytes={inquiry.photos.maxTotalBytes}
    data-extensions={inquiry.photos.extensions.join(',')}
    data-mail={contactEmail()}
    data-vocab={vocab}
  >
    <input type="hidden" name="source" value={Astro.url.pathname.replace(/\.html$/, '')} />
    <input type="hidden" name="t" value="" />
    <div class="iform__hp" aria-hidden="true">
      <label>Bitte leer lassen <input type="text" name="hp" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="iform__step iform__step--1">
      <div class="field">
        <label class="visually-hidden" for={f('message')}>Worum geht es?</label>
        <textarea class="textarea iform__ask" id={f('message')} name="message" rows="5" required placeholder="Worum geht es? Zum Beispiel: Unser Heukran ruckelt beim Heben." maxlength={L.message} aria-describedby={f('message-error')}></textarea>
        <p class="field__error" id={f('message-error')} data-error-for="message" hidden></p>
      </div>
      <div class="iform__bar">
        <label class="iform__attach" for={f('photos')}>
          <Icon name="camera" size={18} /> Foto anhängen <span class="iform__opt">optional</span>
          <input class="iform__attach-input" id={f('photos')} name="photos" type="file" multiple accept={inquiry.photos.accept} aria-describedby={`${f('photos-hint')} ${f('photos-error')}`} />
        </label>
        <button type="button" class="btn btn--primary btn--lg iform__next" data-next>Weiter <Icon name="arrow-right" size={18} class="btn__arrow" /></button>
      </div>
      <p class="visually-hidden" id={f('photos-hint')}>Bis zu {inquiry.photos.max} Bilder, zusammen höchstens {inquiry.photos.maxTotalBytes / 1024 / 1024} MB.</p>
      <ul class="iform__files" data-file-list hidden></ul>
      <p class="field__error" id={f('photos-error')} data-error-for="photos" hidden></p>
    </div>

    <div class="iform__step iform__step--2">
      <p class="iform__recap">Ihr Anliegen: <strong data-recap></strong> · <button type="button" class="iform__edit" data-edit>Ändern</button></p>
      <div class="iform__row">
        <div class="field">
          <label class="field__label" for={f('name')}>Name</label>
          <input class="input" id={f('name')} name="name" type="text" required maxlength={L.name} autocomplete="name" aria-describedby={f('name-error')} />
          <p class="field__error" id={f('name-error')} data-error-for="name" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for={f('email')}>E-Mail</label>
          <input class="input" id={f('email')} name="email" type="email" maxlength={L.email} autocomplete="email" required aria-describedby={f('email-error')} />
          <p class="field__error" id={f('email-error')} data-error-for="email" hidden></p>
        </div>
      </div>
      <div class="iform__row">
        <div class="field">
          <label class="field__label" for={f('phone')}>Telefon <span class="field__opt">optional</span></label>
          <input class="input" id={f('phone')} name="phone" type="tel" maxlength={L.phone} autocomplete="tel" aria-describedby={f('phone-error')} />
          <p class="field__error" id={f('phone-error')} data-error-for="phone" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for={f('company')}>Firma <span class="field__opt">optional</span></label>
          <input class="input" id={f('company')} name="company" type="text" maxlength={L.company} autocomplete="organization" />
        </div>
      </div>

      {/* Der Newsletter: nie vorausgewählt, nie Bedingung – angemeldet ist erst, wer in der
          Eingangsbestätigung klickt (Double Opt-in). Der Satz ist der Wortlaut des Nachweises. */}
      <label class="iform__consent">
        <input type="checkbox" name="newsletter" value="1" />
        <span>{plain(newsletter.consent)}</span>
      </label>

      <div class="iform__foot">
        <span class="iform__count">Schritt 2 von 2</span>
        <button type="submit" class="btn btn--primary btn--lg iform__submit" data-submit>Anfrage senden <Icon name="arrow-right" size={18} class="btn__arrow" /></button>
      </div>
      <p class="iform__privacy">Ihre Angaben verwenden wir nur für diese Anfrage – <a class="link" href="/datenschutz">Datenschutz</a>.</p>
    </div>
  </form>
</div>

<script>
  import { initInquiryForms } from '../scripts/form';
  initInquiryForms();
</script>
