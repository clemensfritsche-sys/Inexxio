---
/** Direkte Kontakte: Telefon und E-Mail gleich gross (#1101) – eine Nummer für alles, auch bei Stillstand. */
import { site, contactEmail, isMissing } from '../config/site.mjs';
import Rich from './Rich.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<div class:list={['cpanel', compact && 'cpanel--compact']}>
  <div class="cpanel__block">
    <p class="label">Telefon</p>
    <a class="cpanel__num tnum" href={`tel:${site.phone.e164}`} data-track="tel_click">{site.phone.display}</a>
  </div>
  <div class="cpanel__block">
    <p class="label">E-Mail</p>
    <a class="cpanel__mail" href={`mailto:${contactEmail()}`} data-track="mailto_click">{contactEmail()}</a>
    {isMissing(site.email.primary) && <Rich as="p" class="small muted" text={site.email.primary} />}
  </div>
</div>

<style>
  .cpanel { display: grid; gap: 0; border-top: 1px solid var(--ink); }
  .cpanel__block { display: grid; gap: 4px; padding: var(--s-5) 0; border-bottom: 1px solid var(--line-2); }
  .cpanel__block .label { display: inline-flex; align-items: center; gap: 6px; }
  /* Telefon und E-Mail in EINER Grösse (#1101): zwei gleichwertige Wege, kein Haupt- und
     Nebenweg. Die E-Mail darf umbrechen, die Nummer nie. */
  .cpanel__num, .cpanel__mail {
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem); font-weight: 700; letter-spacing: -0.02em;
    color: var(--ink); text-decoration: none; line-height: 1.2; width: fit-content;
    display: inline-flex; align-items: center; min-height: 44px;
  }
  .cpanel__num { white-space: nowrap; }
  .cpanel__mail { overflow-wrap: anywhere; }
  .cpanel__num:hover, .cpanel__mail:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  :global(.section--dark) .cpanel, :global(.section--dark) .cpanel__block { border-color: var(--line-dark); }
  :global(.section--dark) .cpanel__num, :global(.section--dark) .cpanel__mail { color: var(--white); }
  .cpanel--compact .cpanel__block { padding: var(--s-4) 0; }
</style>
