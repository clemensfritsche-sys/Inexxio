---
/**
 * Direkte Kontakte: Telefon und E-Mail gleich gross (#1101), darunter die Anschrift mit
 * «Route anzeigen» (#1144). Alles aus dem ERP (scripts/contact.ts tauscht die Vorgabe dieses
 * Builds); die Route öffnet Google Maps in einem NEUEN Tab – die Website bleibt offen (#1145).
 */
import { site, contactEmail, isMissing } from '../config/site.mjs';
import { plain } from '../lib/text.mjs';
import Icon from './Icon.astro';
import Rich from './Rich.astro';

const a = site.address;
const route = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${a.street}, ${a.zip} ${a.city}`)}`;
---
<div class="cpanel">
  <div class="cpanel__block">
    <p class="label">Telefon</p>
    <a class="cpanel__num tnum" href={`tel:${site.phone.e164}`} data-track="tel_click">{site.phone.display}</a>
  </div>
  <div class="cpanel__block">
    <p class="label">E-Mail</p>
    <a class="cpanel__mail" href={`mailto:${contactEmail()}`} data-track="mailto_click">{contactEmail()}</a>
    {isMissing(site.email.primary) && <Rich as="p" class="small muted" text={site.email.primary} />}
  </div>
  <div class="cpanel__block">
    <p class="label">Anschrift</p>
    <address class="cpanel__addr" data-erp="address">{plain(site.brand.legalName)}<br />{a.street}<br />{a.zip} {a.city}</address>
    <a class="arrow-link" href={route} data-erp="route" target="_blank" rel="noopener">Route anzeigen <Icon name="external-link" size={16} /></a>
  </div>
</div>

<style>
  .cpanel { display: grid; gap: 0; border-top: 1px solid var(--ink); }
  .cpanel__block { display: grid; gap: 4px; padding: var(--s-5) 0; border-bottom: 1px solid var(--line-2); justify-items: start; }
  .cpanel__block .label { display: inline-flex; align-items: center; gap: 6px; }
  /* Telefon und E-Mail in EINER Grösse (#1101): zwei gleichwertige Wege, kein Haupt- und
     Nebenweg. Die E-Mail darf umbrechen, die Nummer nie. */
  .cpanel__num, .cpanel__mail {
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem); font-weight: 700; letter-spacing: -0.02em;
    color: var(--ink); text-decoration: none; line-height: 1.2; width: fit-content;
    display: inline-flex; align-items: center; min-height: 44px;
  }
  .cpanel__num { white-space: nowrap; }
  .cpanel__mail { overflow-wrap: anywhere; }
  .cpanel__num:hover, .cpanel__mail:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .cpanel__addr { font-style: normal; color: var(--ink); font-size: 1.0625rem; line-height: 1.55; margin-bottom: var(--s-2); }
  :global(.section--dark) .cpanel, :global(.section--dark) .cpanel__block { border-color: var(--line-dark); }
  :global(.section--dark) .cpanel__num, :global(.section--dark) .cpanel__mail, :global(.section--dark) .cpanel__addr { color: var(--white); }
</style>
