---
/** Direkte Kontakte: Telefon gross, Pikett, E-Mail, Öffnungszeiten – alles aus der Konfiguration. */
import { site, contactEmail } from '../config/site.mjs';
import Icon from './Icon.astro';
import Rich from './Rich.astro';

interface Props {
  /** Pikett hervorheben (Störungsseiten). */
  pikettFirst?: boolean;
  compact?: boolean;
}
const { pikettFirst = false, compact = false } = Astro.props;
const pikett = site.features.pikett;
---
<div class:list={['cpanel', compact && 'cpanel--compact']}>
  {pikett && pikettFirst && (
    <div class="cpanel__block cpanel__block--pikett">
      <p class="label label--red"><Icon name="siren" size={16} /> Pikett bei Stillstand</p>
      <a class="cpanel__num tnum" href={`tel:${site.pikett.e164}`} data-track="pikett_click">{site.pikett.display}</a>
      <Rich as="p" class="small" text={`${site.pikett.hours} ${site.pikett.review}`} />
    </div>
  )}
  <div class="cpanel__block">
    <p class="label">Telefon</p>
    <a class="cpanel__num tnum" href={`tel:${site.phone.e164}`} data-track="tel_click">{site.phone.display}</a>
    <Rich as="p" class="small muted" text={`${site.hours.text} ${site.hours.review}`} />
  </div>
  {pikett && !pikettFirst && (
    <div class="cpanel__block">
      <p class="label">Notfall – Pikett</p>
      <a class="cpanel__num cpanel__num--sm tnum" href={`tel:${site.pikett.e164}`} data-track="pikett_click">{site.pikett.display}</a>
      <Rich as="p" class="small muted" text={`${site.pikett.hours} ${site.pikett.review}`} />
    </div>
  )}
  <div class="cpanel__block">
    <p class="label">E-Mail</p>
    <a class="cpanel__mail" href={`mailto:${contactEmail()}`} data-track="mailto_click">{contactEmail()}</a>
    <Rich as="p" class="small muted" text={site.email.primary} />
  </div>
</div>

<style>
  .cpanel { display: grid; gap: 0; border-top: 1px solid var(--ink); }
  .cpanel__block { display: grid; gap: 4px; padding: var(--s-5) 0; border-bottom: 1px solid var(--line-2); }
  .cpanel__block--pikett { --overline: var(--red-deep); background: var(--paper); padding: var(--s-5); border-bottom: 0; border-left: 3px solid var(--red); margin-bottom: var(--s-2); }
  :global(.section--paper) .cpanel__block--pikett { background: var(--white); }
  .cpanel__block .label { display: inline-flex; align-items: center; gap: 6px; }
  .cpanel__num {
    font-size: clamp(1.625rem, 1.4rem + 1vw, 2.25rem); font-weight: 700; letter-spacing: -0.02em;
    color: var(--ink); text-decoration: none; line-height: 1.15; width: fit-content;
    display: inline-flex; align-items: center; min-height: 44px;
  }
  .cpanel__num--sm { font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem); }
  .cpanel__num:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .cpanel__mail { color: var(--ink); font-weight: 600; word-break: break-all; display: inline-flex; align-items: center; min-height: 44px; }
  :global(.section--dark) .cpanel, :global(.section--dark) .cpanel__block { border-color: var(--line-dark); }
  :global(.section--dark) .cpanel__num, :global(.section--dark) .cpanel__mail { color: var(--white); }
  .cpanel--compact .cpanel__block { padding: var(--s-4) 0; }
</style>
