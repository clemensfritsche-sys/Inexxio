---
/**
 * Direkter Kontakt unter dem Formular (v4): links der Ansprechpartner mit Foto, rechts eine
 * Liste aus Haarlinien – Telefon, E-Mail, Anschrift mit «Route öffnen».
 * Alles aus dem ERP (scripts/contact.ts tauscht die Vorgabe dieses Builds); die Route öffnet
 * Google Maps in einem NEUEN Tab – die Website bleibt offen (#1145).
 */
import { site, contactEmail } from '../config/site.mjs';
import { plain } from '../lib/text.mjs';
import { kontakt } from '../content/kontakt';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
const a = site.address;
const route = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${a.street}, ${a.zip} ${a.city}`)}`;
---
<div class="cpanel">
  <div class="cpanel__who">
    <Photo id="portraet-clemens" sizes="64px" class="cpanel__img" />
    <span class="cpanel__name"><strong>{site.people.owner.name}</strong><span>{kontakt.person.label}</span></span>
  </div>
  <ul role="list" class="cpanel__list">
    <li>
      <Icon name="phone" size={18} />
      <span><a class="cpanel__strong tnum" href={`tel:${site.phone.e164}`}>{site.phone.display}</a><span class="cpanel__hint">{kontakt.person.text}</span></span>
    </li>
    <li>
      <Icon name="mail" size={18} />
      <span><a class="cpanel__strong" href={`mailto:${contactEmail()}`}>{contactEmail()}</a></span>
    </li>
    <li>
      <Icon name="map-pin" size={18} />
      <span><span data-erp="address-line">{plain(site.brand.legalName)}, {a.street}, {a.zip} {a.city}</span><span class="cpanel__hint"><a class="cpanel__route" href={route} data-erp="route" target="_blank" rel="noopener">Route öffnen</a></span></span>
    </li>
  </ul>
</div>

<style>
  .cpanel { display: grid; gap: 14px 24px; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 768px) { .cpanel { grid-template-columns: 170px minmax(0, 1fr); } }
  .cpanel__who { display: flex; gap: 14px; align-items: center; }
  @media (min-width: 768px) { .cpanel__who { flex-direction: column; align-items: flex-start; gap: 10px; } }
  .cpanel__who :global(.cpanel__img), .cpanel__who :global(picture), .cpanel__who :global(.ph) { flex: none; width: 64px; height: 64px; border-radius: 50%; overflow: hidden; }
  .cpanel__who :global(img) { width: 64px; height: 64px; object-fit: cover; object-position: 50% 0; border-radius: 50%; background: var(--paper-2); transform: scale(1.7); transform-origin: 50% 12%; }
  .cpanel__name { display: grid; font-size: 0.9375rem; line-height: 1.4; }
  .cpanel__name span { color: var(--gray-500); }
  .cpanel__list { list-style: none; padding: 0; border-bottom: 1px solid var(--line); }
  .cpanel__list li { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-top: 1px solid var(--line); font-size: 0.9375rem; line-height: 1.45; color: var(--ink); }
  .cpanel__list li > :global(.icon) { flex: none; margin-top: 2px; }
  .cpanel__list li > span { min-width: 0; overflow-wrap: anywhere; }
  .cpanel__strong { font-weight: 600; color: var(--ink); text-decoration: none; }
  .cpanel__strong:hover { text-decoration: underline; }
  .cpanel__hint { display: block; font-size: 0.8125rem; color: var(--gray-500); }
  .cpanel__route { font-weight: 600; color: var(--ink); text-decoration: underline; }
</style>
