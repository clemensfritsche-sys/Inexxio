---
/**
 * Seitenkopf: links Text (Eyebrow, H1, Lead, Hauptaktion), rechts ein grosses echtes Foto.
 * Asymmetrisch, kein Slider, kein Video. Markiert sich als data-hero (mobile Aktionsleiste
 * erscheint, sobald er aus dem Bild ist).
 */
import { site } from '../config/site.mjs';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Rich from './Rich.astro';

interface Action { label: string; href: string; track?: string }
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  photo: string;
  primary: Action;
  /** Zweite Aktion; Standard: die Telefonnummer. */
  secondary?: Action | false;
  note?: string;
  size?: 'lg' | 'md';
}
const { eyebrow, title, lead, photo, primary, secondary, note, size = 'md' } = Astro.props;
const second = secondary === false ? null : (secondary ?? { label: site.phone.display, href: `tel:${site.phone.e164}`, track: 'tel_click' });
---
<section class:list={['hero', `hero--${size}`]} data-hero>
  <div class="wrap hero__grid">
    <div class="hero__text">
      <Rich as="p" class="label hero__eyebrow" text={eyebrow} />
      <Rich as="h1" class="hero__title" text={title} />
      <Rich as="p" class="lead hero__lead" text={lead} />
      <div class="btn-row hero__actions">
        <a class="btn btn--primary" href={primary.href} data-track={primary.track}>
          {primary.label} <Icon name="arrow-right" size={18} class="btn__arrow" />
        </a>
        {second && (
          <a class="btn btn--secondary" href={second.href} data-track={second.track}>
            {second.href.startsWith('tel:') && <Icon name="phone" size={18} />}{second.label}
          </a>
        )}
      </div>
      {note && <Rich as="p" class="hero__note" text={note} />}
      <slot />
    </div>
    <div class="hero__media">
      <Photo id={photo} priority sizes="(min-width: 960px) 56vw, 100vw" />
    </div>
    {Astro.slots.has('after') && <div class="hero__after"><slot name="after" /></div>}
  </div>
</section>

<style>
  .hero { padding-block: var(--s-6) var(--s-8); }
  .hero__grid { display: grid; gap: var(--s-6); align-items: center; }
  .hero__text { display: grid; gap: var(--s-4); justify-items: start; }
  .hero__eyebrow { color: var(--ink-2); }
  .hero__lead { margin-top: var(--s-1); }
  .hero__actions { margin-top: var(--s-3); }
  .hero__note { font-size: 0.9375rem; color: var(--ink-2); }
  .hero__note :global(a) { font-weight: 650; color: var(--ink); white-space: nowrap; }
  /* Mobil: Einstiege direkt unter dem Text, das Foto danach – sie sind der Zweck der Seite. */
  .hero__text { order: 1; }
  .hero__after { order: 2; min-width: 0; }
  .hero__media { order: 3; }
  @media (min-width: 960px) {
    .hero__text, .hero__media { order: 0; grid-row: 1; }
    .hero__after { order: 0; grid-row: 2; grid-column: 1 / -1; margin-top: var(--s-6); }
    .hero { padding-block: var(--s-7) var(--s-9); }
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-5); }
    .hero__text { grid-column: 1 / span 6; padding-right: var(--s-5); }
    .hero__media { grid-column: 7 / span 6; }
    .hero--lg .hero__text { grid-column: 1 / span 6; }
  }
  @media (min-width: 1200px) {
    .hero--md .hero__title { font-size: clamp(2.5rem, 1.6rem + 2.4vw, 3.75rem); }
  }
</style>
