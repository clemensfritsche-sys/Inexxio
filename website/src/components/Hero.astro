---
/**
 * Seitenkopf der Unterseiten (v4, Porsche-Muster): eine grosse Bildkarte (16 px Radius) über
 * die Breite des Inhalts, der Text liegt unten links auf dem Bild über einem dunklen Verlauf –
 * eine Zeile darüber, die H1, ein Satz, die rote Anfrage und das Telefon in Glas.
 * Unter dem Bild: optional `note` und der Slot. Video: beim Foto in src/config/photos.mjs
 * `video` eintragen. Die Textspalte ist der Seitenkopf (data-hero): ist sie aus dem Bild,
 * erscheint die mobile Aktionsleiste.
 */
import { site } from '../config/site.mjs';
import Icon from './Icon.astro';
import Media from './Media.astro';
import Rich from './Rich.astro';

interface Action { label: string; href: string }
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  photo: string;
  primary: Action;
  /** Zweite Aktion; Standard: die Telefonnummer. */
  secondary?: Action | false;
  note?: string;
  size?: 'lg' | 'md';
  /** Kurze Fakten unter dem Bild – nur belegte. */
  trust?: string[];
  caption?: string;
}
const { eyebrow, title, lead, photo, primary, secondary, note, trust } = Astro.props;
const isTel = (href: string) => href.startsWith('tel:');
const second = secondary === false ? null : (secondary ?? { label: site.phone.display, href: `tel:${site.phone.e164}` });
---
<section class="phero">
  <div class="wrap">
    <div class="phero__card" data-hero>
      <Media id={photo} motion priority sizes="(min-width: 1312px) 1264px, 100vw" class="phero__media" />
      <span class="phero__shade" aria-hidden="true"></span>
      <div class="phero__text">
        <Rich as="p" class="phero__eyebrow" text={eyebrow} />
        <Rich as="h1" class="phero__title" text={title} />
        <Rich as="p" class="phero__lead" text={lead} />
        <div class="phero__btns">
          <a class="btn btn--primary phero__btn" href={primary.href}>
            {isTel(primary.href) && <Icon name="phone" size={18} />}{primary.label}
            {!isTel(primary.href) && <Icon name="arrow-right" size={18} class="btn__arrow" />}
          </a>
          {second && (
            <a class="btn phero__btn phero__btn--glass" href={second.href}>
              {isTel(second.href) && <Icon name="phone" size={18} />}<span class="tnum">{second.label}</span>
            </a>
          )}
        </div>
      </div>
    </div>
    {(note || (trust && trust.length > 0) || Astro.slots.has('default')) && (
      <div class="phero__after">
        {note && <Rich as="p" class="phero__note" text={note} />}
        {trust && trust.length > 0 && <ul role="list" class="phero__trust">{trust.map((t) => <Rich as="li" text={t} />)}</ul>}
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  .phero { padding-top: 8px; }
  @media (min-width: 960px) { .phero { padding-top: 16px; } }
  .phero__card {
    position: relative; display: flex; align-items: flex-end; overflow: hidden; border-radius: var(--r-xl);
    min-height: min(640px, 82svh); background: var(--dark-2); color: var(--white); isolation: isolate;
  }
  @media (max-width: 767px) { .phero__card { min-height: min(620px, 86svh); margin-inline: calc(var(--gutter) * -1 + 8px); } }
  @media (min-width: 960px) { .phero__card { min-height: min(720px, 80svh); } }
  .phero__card :global(.phero__media .photo) { animation: phero-zoom 18s ease-in-out infinite alternate; }
  @keyframes phero-zoom { from { transform: scale(1); } to { transform: scale(1.06); } }
  .phero__shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(10, 10, 11, 0.25) 0%, rgba(10, 10, 11, 0) 30%, rgba(10, 10, 11, 0.15) 50%, rgba(10, 10, 11, 0.78) 100%); }
  .phero__text { position: relative; z-index: 2; padding: 24px 20px; max-width: 900px; }
  @media (min-width: 960px) { .phero__text { padding: 56px 56px 56px; } }
  .phero__text :global(.phero__eyebrow) { font-size: 0.875rem; font-weight: 500; color: rgba(255, 255, 255, 0.85); }
  @media (min-width: 960px) { .phero__text :global(.phero__eyebrow) { font-size: 1rem; } }
  .phero__text :global(.phero__title) {
    margin-top: 10px; color: var(--white); font-family: var(--font-display); font-weight: 600;
    font-size: 2.25rem; line-height: 1.05; letter-spacing: -0.03em;
  }
  @media (min-width: 960px) { .phero__text :global(.phero__title) { font-size: 4rem; line-height: 1.03; } }
  .phero__text :global(.phero__lead) { margin-top: 12px; font-size: 1.0625rem; line-height: 1.5; color: rgba(255, 255, 255, 0.88); max-width: 40em; }
  @media (min-width: 960px) { .phero__text :global(.phero__lead) { font-size: 1.25rem; } }
  .phero__btns { margin-top: 24px; display: grid; gap: 10px; }
  @media (min-width: 600px) { .phero__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; } }
  .phero__btn { --btn-h: 52px; padding: 0 24px; font-size: 1rem; font-weight: 600; }
  .phero__btn--glass {
    font-weight: 500; color: var(--white); border: 1px solid rgba(255, 255, 255, 0.35); background: rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
  }
  .phero__btn--glass:hover { background: rgba(255, 255, 255, 0.22); }
  .phero__after { display: grid; gap: 12px; margin-top: 20px; }
  .phero__after :global(.phero__note) { font-size: 0.9375rem; color: var(--ink-2); }
  .phero__after :global(.phero__note a) { font-weight: 600; color: var(--ink); }
  .phero__trust { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 0.875rem; font-weight: 600; color: var(--ink); }
</style>
