---
/**
 * Kurzformular für Leistungsseiten und Startseite: Typ und Thema sind vorausgewählt,
 * gefragt wird nur nach Anliegen, Ort, Name, Telefon, E-Mail. Gleiche Verarbeitung,
 * gleiche Ergebnis-Flächen wie das Hauptformular.
 */
import { contactEmail } from '../config/site.mjs';
import { inquiry } from '../config/inquiry.mjs';
import Icon from './Icon.astro';
import FormResult from './FormResult.astro';
import '../styles/form.css';

interface Props {
  id?: string;
  /** Vorausgewählter Typ – oder 'waehlen', dann fragt das Formular danach (Startseite). */
  kind: 'kran' | 'fahrmischer' | 'teile' | 'abo' | 'anderes' | 'waehlen';
  need?: string;
  urgency?: 'dringend' | 'wochen' | 'planung';
  /** Beschriftung des Anliegen-Felds. */
  messageLabel?: string;
  submitLabel?: string;
}
const { id = 'kurzanfrage', kind, need, urgency, messageLabel = 'Ihr Anliegen', submitLabel = 'Anfrage senden' } = Astro.props;
const choose = kind === 'waehlen';
if (!choose && !inquiry.kinds.some((k) => k.value === kind)) throw new Error(`Unbekannter Anfrage-Typ «${kind}»`);
if (need && !(inquiry.needs as Record<string, { value: string }[]>)[kind]?.some((n) => n.value === need)) {
  throw new Error(`Thema «${need}» passt nicht zu «${kind}»`);
}
const L = inquiry.limits;
/** Beschriftungen für den mailto-Text im Fehlerfall – dieselben wie im Formular. */
const vocab = JSON.stringify({
  kind: Object.fromEntries(inquiry.kinds.map((k) => [k.value, k.label])),
  kindSubject: Object.fromEntries(inquiry.kinds.map((k) => [k.value, k.subject])),
  need: Object.fromEntries(Object.values(inquiry.needs).flat().map((n) => [n.value, n.label])),
  urgency: Object.fromEntries(inquiry.urgencies.map((u) => [u.value, u.label])),
  urgencySubject: Object.fromEntries(inquiry.urgencies.map((u) => [u.value, u.subject])),
  pref: Object.fromEntries(inquiry.contactPrefs.map((p) => [p.value, p.label])),
});
const f = (name: string) => `${id}-${name}`;
---
<div class="iform-wrap" data-inquiry-root>
  <FormResult />
  <form
    id={id}
    class="iform iform--short"
    method="post"
    action="/api/v1/contact"
    enctype="multipart/form-data"
    data-form="kurz"
    data-inquiry
    data-min-seconds={inquiry.minSeconds}
    data-mail={contactEmail()}
    data-vocab={vocab}
  >
    <input type="hidden" name="form" value="kurz" />
    <input type="hidden" name="source" value={Astro.url.pathname.replace(/\.html$/, '')} />
    <input type="hidden" name="t" value="" />
    {!choose && <input type="hidden" name="kind" value={kind} />}
    {need && <input type="hidden" name="need" value={need} />}
    {urgency && <input type="hidden" name="urgency" value={urgency} />}
    <div class="iform__hp" aria-hidden="true">
      <label>Bitte leer lassen <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    {choose && (
      <fieldset class="iform__sub iform__plain">
        <legend class="iform__grouptitle">Worum geht es?</legend>
        <div class="chips">
          {inquiry.kinds.map((k) => (
            <label class="chip">
              <input type="radio" name="kind" value={k.value} required aria-describedby={f('kind-error')} />
              <span>{k.label}</span>
            </label>
          ))}
        </div>
        <p class="field__error" id={f('kind-error')} data-error-for="kind" hidden></p>
      </fieldset>
    )}
    <div class="field">
      <label class="field__label" for={f('message')}>{messageLabel}</label>
      <textarea class="textarea" id={f('message')} name="message" rows="4" required maxlength={L.message} aria-describedby={f('message-error')}></textarea>
      <p class="field__error" id={f('message-error')} data-error-for="message" hidden></p>
    </div>
    {kind === 'abo' && (
      <div class="field field--narrow">
        <label class="field__label" for={f('cranes')}>Anzahl Krane</label>
        <input class="input" id={f('cranes')} name="cranes" type="number" min="1" max="999" inputmode="numeric" required aria-describedby={f('cranes-error')} />
        <p class="field__error" id={f('cranes-error')} data-error-for="cranes" hidden></p>
      </div>
    )}
    <div class="iform__row">
      <div class="field">
        <label class="field__label" for={f('place')}>PLZ und Ort</label>
        <input class="input" id={f('place')} name="place" type="text" required maxlength={L.place} aria-describedby={f('place-error')} />
        <p class="field__error" id={f('place-error')} data-error-for="place" hidden></p>
      </div>
      <div class="field">
        <label class="field__label" for={f('name')}>Name</label>
        <input class="input" id={f('name')} name="name" type="text" required maxlength={L.name} autocomplete="name" aria-describedby={f('name-error')} />
        <p class="field__error" id={f('name-error')} data-error-for="name" hidden></p>
      </div>
    </div>
    <div class="iform__row">
      <div class="field">
        <label class="field__label" for={f('phone')}>Telefon</label>
        <input class="input" id={f('phone')} name="phone" type="tel" maxlength={L.phone} autocomplete="tel" aria-describedby={`${f('contact-hint')} ${f('phone-error')}`} />
        <p class="field__error" id={f('phone-error')} data-error-for="phone" hidden></p>
      </div>
      <div class="field">
        <label class="field__label" for={f('email')}>E-Mail</label>
        <input class="input" id={f('email')} name="email" type="email" maxlength={L.email} autocomplete="email" aria-describedby={`${f('contact-hint')} ${f('email-error')}`} />
        <p class="field__error" id={f('email-error')} data-error-for="email" hidden></p>
      </div>
    </div>
    <p class="field__hint" id={f('contact-hint')}>Telefon oder E-Mail genügt.</p>
    <div class="iform__foot">
      <button type="submit" class="btn btn--primary" data-submit>{submitLabel} <Icon name="arrow-right" size={18} class="btn__arrow" /></button>
      <p class="small muted">
        Ihre Angaben verwenden wir nur für diese Anfrage – <a class="link" href="/datenschutz">Datenschutz</a>.
      </p>
    </div>
  </form>
</div>

<script>
  import { initInquiryForms } from '../scripts/form';
  initInquiryForms();
</script>
