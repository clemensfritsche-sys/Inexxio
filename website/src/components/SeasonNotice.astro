---
/**
 * Saison-Aktion aus der Konfiguration (Datumsbereich MM-TT, über den Jahreswechsel erlaubt).
 * Der Build rendert alle zur Seite passenden Aktionen und zeigt die zur Build-Zeit gültige;
 * das Skript prüft am Gerät das heutige Datum nach (eine statische Seite wird nicht täglich
 * neu gebaut). Ohne JavaScript gilt der Stand des Builds.
 */
import { site } from '../config/site.mjs';
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { t } from '../i18n/t.mjs';
const T = t('ui', { season: 'Saison-Aktion' });

/** `note`: ein fester Hinweis im selben Kleid (ohne Datum), z. B. für bestehende HS-Kunden auf der Startseite. */
interface Props { page: string; note?: { text: string; label: string; href: string; icon?: 'calendar-check' | 'shield-check' }; seasons?: boolean }
const { page, note, seasons: withSeasons = true } = Astro.props;
const today = new Date();
const md = `${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
const active = (from: string, to: string) => (from <= to ? md >= from && md <= to : md >= from || md <= to);
const seasons = withSeasons ? site.seasons.filter((s) => s.pages.includes(page)) : [];
---
{(seasons.length > 0 || note) && (
  <div class="season-wrap">
    {note && (
      <aside class="season season--note">
        <Icon name={note.icon ?? 'shield-check'} size={22} class="season__icon" />
        <Rich as="p" class="season__text" text={note.text} />
        <a class="arrow-link season__link" href={note.href}>{note.label} <Icon name="arrow-right" size={18} /></a>
      </aside>
    )}
    {seasons.map((s) => (
      <aside class="season" data-season data-from={s.from} data-to={s.to} hidden={!active(s.from, s.to)} aria-label={T.season}>
        <Icon name="calendar-check" size={22} class="season__icon" />
        <Rich as="p" class="season__text" text={s.text} />
        <a class="arrow-link season__link" href={s.href}>{s.label} <Icon name="arrow-right" size={18} /></a>
      </aside>
    ))}
  </div>
)}

<script>
  import { initSeasons } from '../scripts/season';
  initSeasons();
</script>

<style>
  .season {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4);
    padding: var(--s-4) var(--s-5); background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg);
  }
  :global(.section--paper) .season { background: var(--white); }
  .season__icon { flex: none; color: var(--ink); }
  .season__text { flex: 1 1 22rem; color: var(--ink); font-weight: 500; max-width: none; }
  .season__link { flex: none; }
  .season--note { border-color: transparent; background: var(--gray-100); }
  .season--note + .season { margin-top: var(--s-3); }
</style>
