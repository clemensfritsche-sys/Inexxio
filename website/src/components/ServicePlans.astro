---
/**
 * Die Pakete des Kranservice als Tabelle «was kann was» (content/krantechnik.ts →
 * servicePlans). Spalten = Pakete, Zeilen = Leistungen, ein Haken ab dem Paket, in dem die
 * Leistung dazukommt. Eine echte <table>: Kopf und Zeilen sind für Screenreader verbunden.
 * `compact` (Startseite): «Auf Abruf» und die drei Pakete je mit einem Satz – die Tabelle
 * steht EINMAL, auf der Kranservice-Seite.
 */
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { servicePlans as t } from '../content/krantechnik';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
{compact ? (
  <ul role="list" class="plans-mini">
    {[t.single, ...t.plans].map((p) => (
      <li><span class="plans-mini__name">{p.name}</span><span class="plans-mini__claim">{p.claim}</span><span class="plans-mini__short">{p.short}</span></li>
    ))}
  </ul>
) : (
  <div class="plans">
    <table class="plans__table">
      <caption class="visually-hidden">{t.title}</caption>
      <thead>
        <tr>
          <td></td>
          {t.plans.map((p) => (
            <th scope="col"><span class="plans__name">{p.name}</span><span class="plans__claim">{p.claim}</span></th>
          ))}
        </tr>
      </thead>
      <tbody>
        {t.rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {t.plans.map((p, i) => (
              <td>{i >= r.from ? <Icon name="check" size={20} label={`In ${p.name} enthalten`} /> : <span class="plans__no" aria-label={`Nicht in ${p.name}`}>–</span>}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <aside class="plans__single">
      <p class="plans__single-title">{t.single.title}</p>
      <Rich as="p" text={t.single.text} />
    </aside>
    <Rich as="p" class="plans__price" text={t.price} />
  </div>
)}

<style>
  .plans { display: grid; gap: var(--s-5); }
  .plans__table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .plans__table th, .plans__table td { padding: var(--s-3) 4px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .plans__table thead th, .plans__table thead td { border-bottom: 2px solid var(--ink); vertical-align: bottom; }
  .plans__table thead th { text-align: center; }
  .plans__table thead td, .plans__table tbody th { width: 44%; }
  .plans__table tbody th { text-align: left; font-weight: 500; color: var(--ink); padding-left: 0; }
  .plans__table tbody td { text-align: center; }
  .plans__table tbody td :global(.icon) { display: block; margin-inline: auto; color: var(--ok); }
  .plans__name { display: block; font-family: var(--font-display); font-size: 1rem; font-weight: 700; letter-spacing: var(--tracking-tight); color: var(--ink); }
  .plans__claim { display: none; margin-top: 4px; font-size: 0.875rem; font-weight: 400; color: var(--ink-3); }
  .plans__no { color: var(--ink-4); }
  @media (min-width: 720px) {
    .plans__table th, .plans__table td { padding-inline: var(--s-2); }
    .plans__name { font-size: 1.25rem; }
    .plans__claim { display: block; }
    .plans__table thead td, .plans__table tbody th { width: 40%; }
  }
  .plans__single { display: grid; gap: 4px; padding: var(--s-4) var(--s-5); border-left: 2px solid var(--ink); background: var(--white); }
  .plans__single-title { font-weight: 700; color: var(--ink); }
  .plans__price { max-width: 46rem; font-size: 0.9375rem; color: var(--ink-3); }

  .plans-mini { display: grid; gap: var(--s-4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 720px) { .plans-mini { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .plans-mini { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .plans-mini li { display: grid; gap: 4px; align-content: start; padding-top: var(--s-3); border-top: 2px solid var(--ink); }
  .plans-mini li:first-child { border-top-color: var(--line-2); }
  .plans-mini__name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; letter-spacing: var(--tracking-tight); color: var(--ink); }
  .plans-mini__claim { color: var(--ink); font-weight: 500; }
  .plans-mini__short { font-size: 0.9375rem; color: var(--ink-3); }
</style>
