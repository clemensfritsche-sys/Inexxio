---
/**
 * Die Garantien (content/promises.ts) als v4-Karten in einer Reihe: Zufriedenheitsgarantie
 * hell mit dem Schema der halben Rechnung, INEXXIO 365 als die eine dunkle Karte mit dem
 * Jahresband, die Gratis-Inspektion als Bildkarte. Text auf der Karte, runder Pfeil.
 * Ohne `only` alles, mit `only` nur, was für eine Unterseite gilt. Die Startseite setzt sie
 * freier (components/home/Guarantees.astro) – Texte von derselben Stelle.
 */
import Icon from './Icon.astro';
import Media from './Media.astro';
import Rich from './Rich.astro';
import { promises, type PromiseItem, type PromiseKey } from '../content/promises';
import half from '../assets/schema/garantie-haelfte.svg?raw';
import year from '../assets/schema/inexxio-365-jahr.svg?raw';

interface Props { only?: PromiseKey[]; id?: string; /** false: ohne Einleitungssatz unter dem Titel. */ lead?: boolean; photo?: string }
const { only, id = 'versprechen', lead = true, photo = 'arbeit-werkstatt' } = Astro.props;
const keys = (['garantie', 'inexxio365', 'erstservice'] as PromiseKey[]).filter((k) => !only || only.includes(k));
const both = keys.includes('garantie') && keys.includes('inexxio365');
const title = both ? promises.title : keys.length === 1 && keys[0] !== 'erstservice' ? promises.eyebrowOne : promises.eyebrow;
const href = (k: PromiseKey) => (promises.items[k] as PromiseItem).link?.href ?? (k === 'garantie' ? '#fragen' : '#anfrage');
---
<section class="section pr" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="head">
      <div class="head__in">
        <h2 class="v4-h2" id={`${id}-title`}>{title}</h2>
        {both && lead && <Rich as="p" class="v4-sub" text={promises.lead} />}
      </div>
    </header>
    <ul role="list" class:list={['pr__cards', `pr__cards--${keys.length}`]}>
      {keys.map((k) => {
        const p = promises.items[k];
        return (
          <li>
            <a class:list={['pr__card', `pr__card--${k}`, k === 'erstservice' && 'zoom-on-hover']} href={href(k)}>
              {k === 'garantie' && <span class="pr__art" aria-hidden="true" set:html={half} />}
              {k === 'inexxio365' && <span class="pr__art pr__art--year" aria-hidden="true" set:html={year} />}
              {k === 'erstservice' && <><Media id={photo} sizes="(min-width: 960px) 33vw, 100vw" /><span class="pr__shade" aria-hidden="true"></span></>}
              <span class="pr__text">
                <span><span class="pr__label">{p.label}</span><Rich as="span" class="pr__title" text={p.title} /></span>
                <span class:list={['garrow garrow--sm', k === 'garantie' && 'garrow--ink']} aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .pr__cards { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 760px) { .pr__cards--2, .pr__cards--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .pr__cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
  .pr__card { position: relative; display: block; height: 420px; border-radius: var(--r-xl); overflow: hidden; text-decoration: none; isolation: isolate; }
  @media (min-width: 960px) { .pr__card { height: 480px; } }
  .pr__card--garantie { background: var(--gray-100); color: var(--ink); }
  .pr__card--inexxio365 { background: var(--black); color: var(--white); }
  .pr__card--erstservice { background: var(--dark-2); color: var(--white); }
  .pr__art { position: absolute; left: 0; right: 0; top: 28px; display: flex; justify-content: center; transition: transform 0.6s var(--ease); }
  .pr__card:hover .pr__art { transform: translateY(-6px); }
  .pr__art :global(svg) { width: min(340px, 86%); height: auto; max-width: none; }
  .pr__art--year { top: 64px; }
  .pr__shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(10, 10, 11, 0) 45%, rgba(10, 10, 11, 0.75) 100%); }
  .pr__text { position: absolute; left: 24px; right: 24px; bottom: 24px; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .pr__label { display: block; font-size: 0.875rem; font-weight: 600; opacity: 0.72; }
  .pr__text :global(.pr__title) { display: block; margin-top: 4px; font-family: var(--font-display); font-weight: 600; font-size: 1.375rem; line-height: 1.15; letter-spacing: -0.02em; }
</style>
