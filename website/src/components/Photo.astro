---
/**
 * Bildstelle aus der Fotoliste (src/config/photos.mjs).
 * Mit Datei: <picture> mit AVIF/WebP, srcset, festen Massen, Lazy Loading (Hero: eager +
 * fetchpriority="high"). Ohne Datei: grauer Rahmen im richtigen Seitenverhältnis mit der
 * Bildbeschreibung – im Modus «live» ein Fehler.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { photo } from '../config/photos.mjs';
import { isLive } from '../lib/text.mjs';

interface Props {
  id: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { id, sizes = '(min-width: 960px) 50vw, 100vw', priority = false, class: cls } = Astro.props;
const p = photo(id);
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const src = p.file ? files[`../assets/photos/${p.file}`]?.default : undefined;
if (p.file && !src) throw new Error(`Foto «${id}»: Datei src/assets/photos/${p.file} fehlt.`);
if (!src && isLive()) throw new Error(`Foto «${id}» fehlt – im Modus «live» nicht erlaubt.`);
---
{src ? (
  <Picture
    src={src}
    alt={p.alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= src.width)}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class:list={['photo', cls]}
  />
) : (
  <div class:list={['ph', cls]} data-ratio={p.ratio} data-photo-missing={id} role="img" aria-label={p.alt}>
    <span class="ph__label" aria-hidden="true">Foto fehlt</span>
    <span class="ph__brief" aria-hidden="true">{p.brief}</span>
  </div>
)}

<style>
  .photo { width: 100%; height: auto; display: block; }
  .ph {
    position: relative; width: 100%; display: flex; flex-direction: column; justify-content: flex-end;
    gap: 6px; padding: var(--s-5); background: var(--paper-2); border: 1px solid var(--line-2);
    color: var(--ink-3); overflow: hidden;
  }
  .ph[data-ratio='3/2'] { aspect-ratio: 3 / 2; }
  .ph[data-ratio='4/3'] { aspect-ratio: 4 / 3; }
  .ph[data-ratio='4/5'] { aspect-ratio: 4 / 5; }
  .ph[data-ratio='1/1'] { aspect-ratio: 1 / 1; }
  .ph[data-ratio='16/9'] { aspect-ratio: 16 / 9; }
  .ph__label {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-2);
  }
  .ph__brief { font-size: 0.9375rem; line-height: 1.45; color: var(--ink-2); max-width: 36ch; }
</style>
