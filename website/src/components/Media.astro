---
/**
 * Bild ODER Video, das seine Fläche füllt (v4: Bühne, Bildkarten, Collage).
 * Das Foto kommt aus der Fotoliste (Photo.astro). Trägt der Eintrag in src/config/photos.mjs ein
 * `video` (Datei in public/video/) und steht die Stelle in der Bühne (`motion`), gibt es statt des
 * Fotos ein gewöhnliches Video: stumm, in Schleife, inline, mit Standbild (`poster` = erstes Bild
 * des Videos, gleicher Name als .webp).
 *
 * **Jede Bildschirmbreite bekommt ihre Fassung**: liegt neben `<name>.mp4` ein `<name>-schmal.mp4`
 * (hochkant geschnitten), bekommen schmale Bildschirme (VIDEO_NARROW) diese, alle anderen die
 * breite. Bei «reduzierter Bewegung» passt keine Quelle (VIDEO_MOTION): es bleibt beim Standbild,
 * ohne dass ein Byte Video geladen wird – abspielen lässt es sich dann mit dem Knopf der Bühne
 * (scripts/media.ts liest die Adressen aus `data-src-*`). `preload="metadata"`: vor dem Abspielen
 * nur der Kopf. Anhalten und Abspielen: der Knopf der Bühne (WCAG 2.2.2).
 */
import { createHash } from 'node:crypto';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { photo } from '../config/photos.mjs';
import Photo from './Photo.astro';
import { VIDEO_MOTION, VIDEO_NARROW } from '../scripts/media';

interface Props {
  id: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  /** Video zeigen (nur Bühne und Seitenkopf) – sonst bleibt es beim Foto. */
  motion?: boolean;
}
const { id, sizes = '100vw', priority = false, class: cls, motion = false } = Astro.props;
const video = motion ? photo(id).video : undefined;
const cuts = motion ? photo(id).cuts : undefined;
const poster = video?.replace(/\.mp4$/, '.webp');
/** Hochkant-Fassung für schmale Bildschirme, falls vorhanden. */
const narrow = video && existsSync(resolve(process.cwd(), 'public/video', video.replace(/\.mp4$/, '-schmal.mp4'))) ? video.replace(/\.mp4$/, '-schmal.mp4') : undefined;
for (const f of video ? [video, poster] : []) {
  if (!existsSync(resolve(process.cwd(), 'public/video', f!))) throw new Error(`Video «${video}» (Foto «${id}»): «${f}» fehlt in public/video/.`);
}
/** Adresse mit Fingerabdruck der Datei: eine neue Fassung ist eine neue Adresse – kein Browser zeigt eine alte. */
const url = (f: string) => `/video/${f}?v=${createHash('sha256').update(readFileSync(resolve(process.cwd(), 'public/video', f))).digest('hex').slice(0, 10)}`;
---
<span class:list={['fill-media', cls]}>
  {video ? (
    <video autoplay muted loop playsinline disablepictureinpicture preload="metadata" poster={url(poster!)} aria-hidden="true" data-media-video data-src-wide={url(video)} data-src-narrow={narrow ? url(narrow) : undefined} data-cuts={cuts?.join(' ')}>
      {narrow && <source src={url(narrow)} type="video/mp4" media={`${VIDEO_NARROW} and ${VIDEO_MOTION}`} />}
      <source src={url(video)} type="video/mp4" media={VIDEO_MOTION} />
    </video>
  ) : (
    <Photo id={id} sizes={sizes} priority={priority} />
  )}
</span>
