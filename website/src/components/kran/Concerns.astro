---
/**
 * Was Sie vorher wissen wollen (v4): drei Sorgen vor einer Anfrage – je ein Symbol im Kreis, die Frage
 * gross, die Antwort leise, an einer Haarlinie. Breit drei nebeneinander, schmal untereinander.
 * Texte: content/krantechnik.ts (`craneConcerns`).
 */
import Icon, { type IconName } from '../Icon.astro';
import Rich from '../Rich.astro';

interface Props { title: string; items: { icon: IconName; q: string; a: string }[] }
const { title, items } = Astro.props;
---
<section class="v4-section" aria-labelledby="vorher">
  <div class="wrap">
    <header class="v4-head--center"><h2 class="v4-h2" id="vorher">{title}</h2></header>
    <ul role="list" class="cn">
      {items.map((c) => (
        <li>
          <span class="cn__ic"><Icon name={c.icon} size={22} /></span>
          <h3 class="cn__q">{c.q}</h3>
          <Rich as="p" class="cn__a" text={c.a} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cn { list-style: none; padding: 0; display: grid; gap: 32px; max-width: 1100px; margin: 40px auto 0; }
  .cn li { display: grid; gap: 10px; align-content: start; padding-top: 24px; border-top: 1px solid var(--ink); }
  .cn__ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--gray-100); color: var(--ink); }
  .cn__q { margin-top: 8px; font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; line-height: 1.2; letter-spacing: -0.02em; }
  .cn :global(.cn__a) { color: var(--ink-3); line-height: 1.55; }
  @media (min-width: 960px) { .cn { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; margin-top: 56px; } .cn__q { font-size: 1.75rem; } }
</style>
