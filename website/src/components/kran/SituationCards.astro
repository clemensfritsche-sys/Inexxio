---
/**
 * Wo ein Katalogkran nicht passt (v4): vier Situationen als graue Karten, oben die Strichzeichnung
 * (Draufsicht oder Schnitt, Gebäude grau, die Lösung rot), darunter Titel, das Problem leise und die
 * Lösung mit Pfeil. Breit vier nebeneinander, schmal eine Reihe zum Wischen. Darunter eine Zeile zur
 * Anfrage. Texte: content/krantechnik.ts (`craneSituations`).
 */
import Icon from '../Icon.astro';
import { illustration } from '../../lib/illustrations';

interface Item { id: string; illo: string; title: string; problem: string; solution: string }
interface Props { title: string; lead: string; items: Item[]; more: string; id?: string }
const { title, lead, items, more, id = 'situationen' } = Astro.props;
---
<section class="v4-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="v4-head--center">
      <h2 class="v4-h2" id={`${id}-title`}>{title}</h2>
      <p class="v4-sub">{lead}</p>
    </header>
  </div>
  <div class="wrap sc-wrap">
    <ul role="list" class="sc">
      {items.map((s) => (
        <li class="sc__card" id={s.id}>
          <img class="sc__art" src={illustration(s.illo, 'Situationen')} alt={`Zeichnung: ${s.title}`} width="400" height="300" loading="lazy" decoding="async" />
          <h3 class="sc__title">{s.title}</h3>
          <p class="sc__problem">{s.problem}</p>
          <p class="sc__solution"><Icon name="arrow-right" size={18} /><span>{s.solution}</span></p>
        </li>
      ))}
    </ul>
  </div>
  <div class="wrap"><p class="sc__more"><a href="#anfrage">{more} <Icon name="arrow-right" size={18} /></a></p></div>
</section>

<style>
  .sc { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 48px; }
  .sc__card { display: flex; flex-direction: column; padding: 20px 24px 28px; border-radius: 24px; background: var(--gray-100); scroll-margin-top: calc(var(--header-h) + 24px); }
  .sc__art { display: block; width: 100%; height: auto; margin-bottom: 12px; border-radius: 16px; background: var(--white); transition: transform 0.6s var(--ease); }
  .sc__card:hover .sc__art { transform: translateY(-4px); }
  .sc__title { margin-top: 8px; font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; letter-spacing: -0.02em; }
  .sc__problem { margin-top: 8px; font-size: 0.9375rem; line-height: 1.5; color: var(--ink-3); }
  .sc__solution { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; margin-top: auto; padding-top: 16px; font-size: 0.9375rem; line-height: 1.5; font-weight: 500; color: var(--ink); }
  .sc__solution :global(.icon) { margin-top: 3px; color: var(--red); }
  .sc__more { display: flex; justify-content: center; max-width: none; margin-top: 32px; }
  .sc__more a { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1099px) {
    .sc-wrap { padding-inline: 0; }
    .sc { display: flex; gap: 12px; margin-top: 32px; padding: 0 var(--gutter) 8px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none; }
    .sc::-webkit-scrollbar { display: none; }
    .sc__card { flex: 0 0 78%; max-width: 340px; scroll-snap-align: start; }
  }
</style>
