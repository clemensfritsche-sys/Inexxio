---
/**
 * Bildkarte (v4): Foto füllt die Karte (16 px Radius), Titel und Satz liegen unten auf dem
 * Bild über einem dunklen Verlauf, rechts ein runder Glas-Pfeil. Unterseiten als Links (falls
 * angegeben) stehen darunter als ruhige Zeilen – kein Kasten im Kasten.
 */
import Icon from './Icon.astro';
import Media from './Media.astro';
import Rich from './Rich.astro';

interface Props {
  title: string;
  href: string;
  text: string;
  photo: string;
  links?: { href: string; label: string }[];
  more: string;
  wide?: boolean;
  level?: 'h2' | 'h3';
}
const { title, href, text, photo, links = [], more, level = 'h3' } = Astro.props;
const H = level;
---
<article class="acard">
  <a href={href} class="acard__img zoom-on-hover" aria-label={more}>
    <Media id={photo} sizes="(min-width: 960px) 40vw, 100vw" />
    <span class="acard__shade" aria-hidden="true"></span>
    <span class="acard__text">
      <span>
        <H class="acard__title">{title}</H>
        <Rich as="span" class="acard__sub" text={text} />
      </span>
      <span class="garrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
    </span>
  </a>
  {links.length > 0 && (
    <ul role="list" class="acard__links">
      {links.map((l) => <li><a href={l.href}><span>{l.label}</span><Icon name="arrow-right" size={16} /></a></li>)}
    </ul>
  )}
</article>

<style>
  .acard { display: flex; flex-direction: column; height: 100%; }
  .acard__img { position: relative; display: block; min-height: 440px; flex: 1; border-radius: var(--r-xl); overflow: hidden; color: var(--white); text-decoration: none; background: var(--dark-2); isolation: isolate; }
  @media (min-width: 960px) { .acard__img { min-height: 520px; } }
  .acard__shade { position: absolute; left: 0; right: 0; bottom: 0; height: 60%; z-index: 1; background: linear-gradient(180deg, rgba(10, 10, 11, 0) 0%, rgba(10, 10, 11, 0.75) 100%); }
  .acard__text { position: absolute; left: 24px; right: 24px; bottom: 24px; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  @media (min-width: 960px) { .acard__text { left: 32px; right: 32px; bottom: 32px; } }
  .acard__title { font-family: var(--font-display); font-weight: 600; font-size: 1.625rem; line-height: 1.08; letter-spacing: -0.025em; color: var(--white); }
  @media (min-width: 960px) { .acard__title { font-size: 1.875rem; } }
  .acard__text :global(.acard__sub) { display: block; margin-top: 6px; font-size: 0.9375rem; line-height: 1.4; color: rgba(255, 255, 255, 0.85); max-width: 32em; }
  .acard__links { list-style: none; padding: 0; margin-top: 12px; }
  .acard__links li { border-top: 1px solid var(--line); }
  .acard__links a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 46px; color: var(--ink-2); text-decoration: none; font-size: 0.9375rem; font-weight: 500; }
  .acard__links a:hover { color: var(--ink); }
</style>
