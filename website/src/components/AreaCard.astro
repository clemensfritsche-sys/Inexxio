---
/**
 * Bereichskarte (Startseite, Auftrag 7.3): Foto, Titel, ein Satz, die Unterseiten als Links,
 * «Zum Bereich». `wide`: breite, flachere Karte – Foto links, Text rechts.
 * Ohne Links (Unterseiten-Karte auf einer Bereichsseite): Foto, Titel, Satz, Pfeil.
 */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Rich from './Rich.astro';

interface Props {
  title: string;
  href: string;
  text: string;
  photo: string;
  links?: { href: string; label: string }[];
  more: string;
  wide?: boolean;
  level?: 'h2' | 'h3';
}
const { title, href, text, photo, links = [], more, wide = false, level = 'h3' } = Astro.props;
const H = level;
---
<article class:list={['acard', wide && 'acard--wide']}>
  <a href={href} class="acard__media" tabindex="-1" aria-hidden="true">
    <Photo id={photo} sizes={wide ? '(min-width: 960px) 40vw, 100vw' : '(min-width: 760px) 50vw, 100vw'} />
  </a>
  <div class="acard__body">
    <H class="acard__title"><a href={href}>{title}</a></H>
    <Rich as="p" class="acard__text" text={text} />
    {links.length > 0 && (
      <ul role="list" class="acard__links">
        {links.map((l) => <li><a href={l.href}><span>{l.label}</span><Icon name="arrow-right" size={16} /></a></li>)}
      </ul>
    )}
    <a class="arrow-link acard__more" href={href}>{more} <Icon name="arrow-right" size={18} /></a>
  </div>
</article>

<style>
  /* Karte des Website-Kits: Bild oben (16:10, beim Zeigen leicht vergrössert), Text darunter. */
  .acard { display: flex; flex-direction: column; height: 100%; transition: background-color 200ms var(--ease); }
  .acard:hover { background: var(--paper); }
  .acard__media { position: relative; display: block; overflow: hidden; aspect-ratio: 16 / 10; text-decoration: none; color: inherit; }
  .acard__media :global(picture), .acard__media :global(.photo), .acard__media :global(.ph) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .acard__media :global(.photo) { object-fit: cover; }
  .acard__media :global(img), .acard__media :global(.ph) { transition: transform 600ms var(--ease); }
  @media (prefers-reduced-motion: no-preference) {
    .acard:hover .acard__media :global(img), .acard:hover .acard__media :global(.ph) { transform: scale(1.03); }
  }
  .acard__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); padding: 26px 28px 30px; flex: 1; }
  .acard__title { font-size: clamp(1.5rem, 1.3rem + 0.9vw, 2.125rem); letter-spacing: var(--tracking-tight); font-weight: 700; }
  .acard__title a { color: var(--ink); text-decoration: none; }
  .acard__title a:hover { color: var(--red-deep); }
  .acard__text { color: var(--ink-2); }
  .acard__links { list-style: none; padding: 0; width: 100%; margin-top: auto; }
  .acard__links li { border-top: 1px solid var(--line); }
  .acard__links a {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 46px;
    color: var(--ink-2); text-decoration: none; font-size: 0.9375rem; font-weight: 500;
  }
  .acard__links a :global(.icon) { color: var(--red); flex: none; transition: transform 200ms var(--ease); }
  .acard__links a:hover { color: var(--ink); }
  .acard__links a:hover :global(.icon) { transform: translateX(3px); }
  .acard__more { margin-top: var(--s-2); }
  .acard:not(:has(.acard__links)) .acard__more { margin-top: auto; }
  @media (max-width: 599px) { .acard__body { padding: 22px 18px 24px; } }

  /* Breit: Foto links (5/12), Text rechts – flacher als die beiden Hauptkarten. */
  @media (min-width: 900px) {
    .acard--wide { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .acard--wide .acard__media { aspect-ratio: auto; min-height: 280px; }
  }
</style>
