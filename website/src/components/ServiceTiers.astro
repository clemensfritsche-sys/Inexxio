---
/**
 * Die vier Stufen des Kranservice (content/krantechnik.ts → serviceTiers): Auf Abruf ·
 * Basis · Plus · INEXXIO 365. Jede Stufe nennt nur, was dazukommt; INEXXIO 365 ist die
 * dunkle Karte. Keine Preise. v4: graue Karten wie ein Modellvergleich, schmal eine Reihe zum Wischen.
 */
import Icon from './Icon.astro';
import { serviceTiers as t } from '../content/krantechnik';
---
<ol role="list" class="tiers">
  {t.tiers.map((tier, i) => (
    <li class:list={['tiers__item', { 'tiers__item--featured': tier.featured }]}>
      <p class="tiers__step tnum">Stufe {i + 1}</p>
      <h3 class="tiers__name">{tier.name}</h3>
      <p class="tiers__claim">{tier.claim}</p>
      {i > 0 && <p class="tiers__plus">Alles aus «{t.tiers[i - 1].name}», dazu:</p>}
      <ul role="list" class="tiers__list">
        {tier.items.map((it) => <li><Icon name="check" size={18} />{it}</li>)}
      </ul>
    </li>
  ))}
</ol>

<style>
  .tiers { list-style: none; padding: 0 var(--gutter) 4px; margin: 40px calc(var(--gutter) * -1) 0; display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none; }
  .tiers::-webkit-scrollbar { display: none; }
  .tiers__item { flex: 0 0 80%; scroll-snap-align: start; display: flex; flex-direction: column; gap: 8px; padding: 28px; border-radius: 24px; background: var(--gray-100); }
  .tiers__step { font-size: 0.8125rem; font-weight: 600; color: var(--gray-500); }
  .tiers__name { font-family: var(--font-display); font-weight: 600; font-size: 1.625rem; line-height: 1.15; letter-spacing: -0.02em; }
  .tiers__claim { font-weight: 500; color: var(--ink); }
  .tiers__plus { margin-top: 12px; font-size: 0.8125rem; color: var(--ink-3); }
  .tiers__list { list-style: none; padding: 0; display: grid; gap: 0; margin-top: 4px; }
  .tiers__list li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; padding: 10px 0; border-top: 1px solid var(--line-2); font-size: 0.9375rem; color: var(--ink-2); }
  .tiers__list :global(.icon) { margin-top: 3px; color: var(--ink); }
  .tiers__item--featured { background: var(--dark); }
  .tiers__item--featured .tiers__name, .tiers__item--featured .tiers__claim { color: var(--white); }
  .tiers__item--featured .tiers__step, .tiers__item--featured .tiers__plus { color: rgba(255, 255, 255, 0.6); }
  .tiers__item--featured .tiers__list li { border-top-color: var(--line-dark); color: rgba(255, 255, 255, 0.86); }
  .tiers__item--featured .tiers__list :global(.icon) { color: var(--white); }
  @media (min-width: 1100px) {
    .tiers { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 56px 0 0; padding: 0; overflow: visible; }
    .tiers__item { padding: 32px; }
  }
</style>
