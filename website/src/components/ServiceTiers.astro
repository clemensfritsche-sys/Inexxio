---
/**
 * Die vier Stufen des Kranservice (content/krantechnik.ts → serviceTiers) als Treppe (v4): breit vier
 * Karten nebeneinander, jede eine Stufe höher als die vorherige – INEXXIO 365 ist die oberste und die
 * dunkle (Anker #inexxio-365). Jede Stufe nennt nur, was dazukommt. Keine Preise.
 * Schmal: untereinander, jede Stufe ein Stück weiter eingerückt.
 */
import Icon from './Icon.astro';
import { serviceTiers as t } from '../content/krantechnik';
---
<ol role="list" class="tiers">
  {t.tiers.map((tier, i) => (
    <li class:list={['tiers__item', { 'tiers__item--featured': tier.featured }]} id={tier.featured ? 'inexxio-365' : undefined} style={`--i:${i}`}>
      <p class="tiers__step tnum">Stufe {i + 1}</p>
      <h3 class="tiers__name">{tier.name}</h3>
      <p class="tiers__claim">{tier.claim}</p>
      <ul role="list" class="tiers__list">
        {tier.items.map((it) => <li><Icon name={i > 0 ? 'plus' : 'check'} size={16} />{it}</li>)}
      </ul>
    </li>
  ))}
</ol>

<style>
  .tiers { list-style: none; padding: 0; display: grid; gap: 12px; margin-top: 40px; }
  .tiers__item { display: flex; flex-direction: column; gap: 8px; margin-left: calc(var(--i) * 16px); padding: 24px; border-radius: 24px; background: var(--gray-100); color: var(--ink); scroll-margin-top: calc(var(--header-h) + 24px); }
  .tiers__step { font-size: 0.8125rem; font-weight: 600; color: var(--gray-500); }
  .tiers__name { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; line-height: 1.15; letter-spacing: -0.02em; }
  .tiers__claim { font-size: 0.9375rem; color: var(--ink-3); }
  .tiers__list { list-style: none; padding: 16px 0 0; margin-top: auto; display: grid; gap: 8px; border-top: 1px solid var(--line); font-size: 0.9375rem; line-height: 1.4; }
  .tiers__list li { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 10px; align-items: start; }
  .tiers__list :global(svg) { margin-top: 2px; color: var(--ink-3); }
  .tiers__item--featured { background: var(--black); color: var(--white); }
  .tiers__item--featured .tiers__name { color: var(--white); }
  .tiers__item--featured .tiers__step, .tiers__item--featured .tiers__claim, .tiers__item--featured .tiers__list :global(svg) { color: rgba(255, 255, 255, 0.64); }
  .tiers__item--featured .tiers__list { border-top-color: rgba(255, 255, 255, 0.16); }
  /* Breit: eine Treppe – die Karten stehen unten bündig, jede 64 px höher als die vorherige. */
  @media (min-width: 960px) {
    .tiers { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; align-items: end; margin-top: 64px; }
    .tiers__item { margin-left: 0; min-height: calc(340px + var(--i) * 64px); padding: 28px; }
    .tiers__name { font-size: 1.625rem; }
  }
</style>
