---
/**
 * Drei versetzte Karten, die Überschrift dazwischen – wie eine Zeitschrift (v4). Karte A hell und breit mit
 * Schema (SVG) oder freigestelltem Bild auf Weiss, Karte B dunkel und hoch mit Schema oder Foto, Karte C ein
 * Foto. Jede Karte: leises Wort, ein Satz gross,
 * bei einem Ziel der Pfeil. Breit frei gesetzt auf einer Fläche 1264 × 1160 (skaliert mit der Breite),
 * schmal untereinander, leicht versetzt.
 * Gebraucht von den Garantien (home/Guarantees) und von «Funk statt Kabine» (kran/RadioControl).
 */
import Icon from '../Icon.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import Rich from '../Rich.astro';

interface Card { label: string; title: string; href?: string }
interface Props {
  /** Id der Überschrift. */
  id: string;
  /** Sprungziel des Abschnitts. */
  anchor?: string;
  title: string;
  lead: string;
  /** Hell, breit – `art` ist ein SVG als Text (…svg?raw), `image` ein Bild auf Weiss (wird mit der Fläche verrechnet). */
  a: Card & ({ art: string; image?: never } | { image: ImageMetadata; alt: string; art?: never });
  /** Dunkel, hoch. */
  b: Card & ({ art: string; photo?: never } | { photo: string; art?: never });
  /** Foto (config/photos.mjs). */
  c: Card & { photo: string };
}
const { id, anchor, title, lead, a, b, c } = Astro.props;
const A = a.href ? 'a' : 'div';
const B = b.href ? 'a' : 'div';
const C = c.href ? 'a' : 'div';
---
<section class="v4-section gar-sec" id={anchor} aria-labelledby={id}>
  <div class="wrap gar-box">
    <div class="gar">
      <header class="gar__head">
        <Rich as="h2" class="v4-h2" id={id} text={title} />
        <Rich as="p" class="v4-sub" text={lead} />
      </header>
      <A class="gv gv--light gar__a" href={a.href}>
        {a.image
          ? <span class="gv__img"><Picture src={a.image} alt={a.alt} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="(min-width: 960px) 60vw, 100vw" fallbackFormat="webp" /></span>
          : <span class="gv__art gv__art--a" aria-hidden="true" set:html={a.art} />}
        <span class="gv__text"><span><span class="gv__label">{a.label}</span><Rich as="span" class="gv__title" text={a.title} /></span>{a.href && <span class="garrow garrow--sm garrow--ink" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>}</span>
      </A>
      <B class="gv gv--dark gar__b" href={b.href}>
        {b.photo
          ? <><Media id={b.photo} sizes="(min-width: 960px) 40vw, 100vw" /><span class="gv__shade" aria-hidden="true"></span></>
          : <span class="gv__art gv__art--b" aria-hidden="true" set:html={b.art} />}
        <span class="gv__text"><span><span class="gv__label">{b.label}</span><Rich as="span" class="gv__title" text={b.title} /></span>{b.href && <span class="garrow garrow--sm" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>}</span>
      </B>
      <C class:list={['gv gv--photo gar__c', c.href && 'zoom-on-hover']} href={c.href}>
        <Media id={c.photo} sizes="(min-width: 960px) 40vw, 100vw" />
        <span class="gv__shade" aria-hidden="true"></span>
        <span class="gv__text"><span><span class="gv__label">{c.label}</span><Rich as="span" class="gv__title" text={c.title} /></span>{c.href && <span class="garrow garrow--sm" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>}</span>
      </C>
    </div>
  </div>
</section>

<style>
  /* Schmal: Überschrift, dann die Karten untereinander, leicht versetzt. */
  .gar { display: grid; gap: 12px; }
  .gar__head { margin-bottom: 16px; }
  .gv { position: relative; display: block; border-radius: var(--r-xl); overflow: hidden; text-decoration: none; isolation: isolate; }
  .gv--light { background: var(--gray-100); color: var(--ink); height: 340px; }
  .gv--dark { background: var(--black); color: var(--white); height: 420px; margin-left: 40px; }
  .gv--photo { color: var(--white); height: 320px; margin-right: 40px; background: var(--dark-2); }
  .gv__art { position: absolute; left: 0; right: 0; display: flex; justify-content: center; transition: transform 0.6s var(--ease); }
  .gv:hover .gv__art { transform: translateY(-6px); }
  .gv__art :global(svg) { display: block; max-width: none; }
  .gv__art--a { top: 16px; } .gv__art--a :global(svg) { width: 300px; height: 200px; }
  .gv__art--b { top: 56px; } .gv__art--b :global(svg) { width: 290px; height: 196px; }
  /* Ein Bild auf Weiss: mit der grauen Fläche verrechnet, das Weiss verschwindet. */
  .gv__img { position: absolute; left: 0; right: 0; top: 0; bottom: 22%; display: flex; justify-content: center; transition: transform 0.6s var(--ease); }
  .gv:hover .gv__img { transform: translateY(-6px); }
  .gv__img :global(picture), .gv__img :global(img) { display: block; width: 100%; height: 100%; }
  .gv__img :global(img) { object-fit: contain; mix-blend-mode: multiply; }
  .gv__shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(10, 10, 11, 0) 45%, rgba(10, 10, 11, 0.75) 100%); }
  .gv__text { position: absolute; left: 20px; right: 20px; bottom: 16px; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .gv__label { display: block; font-size: 0.875rem; font-weight: 600; opacity: 0.72; }
  .gv__text :global(.gv__title) { display: block; margin-top: 4px; font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.15; letter-spacing: -0.02em; }

  /* Breit: frei gesetzt auf einer Fläche 1264 × 1160 (skaliert mit der Breite). */
  @media (min-width: 960px) {
    .gar-box { container-type: inline-size; }
    .gar { display: block; position: relative; height: calc(1160 / 1264 * 100cqw); }
    .gar > * { position: absolute; margin: 0; }
    .gar__a { left: 0; top: 0; width: calc(860 / 1264 * 100cqw); height: calc(420 / 1264 * 100cqw); }
    .gar__b { left: calc(720 / 1264 * 100cqw); top: calc(250 / 1264 * 100cqw); width: calc(480 / 1264 * 100cqw); height: calc(660 / 1264 * 100cqw); }
    .gar__head { left: calc(64 / 1264 * 100cqw); top: calc(500 / 1264 * 100cqw); width: calc(560 / 1264 * 100cqw); }
    .gar__c { left: calc(150 / 1264 * 100cqw); top: calc(790 / 1264 * 100cqw); width: calc(520 / 1264 * 100cqw); height: calc(370 / 1264 * 100cqw); }
    .gv__art--a { top: calc(28 / 1264 * 100cqw); } .gv__art--a :global(svg) { width: calc(440 / 1264 * 100cqw); height: calc(290 / 1264 * 100cqw); }
    .gv__art--b { top: calc(130 / 1264 * 100cqw); } .gv__art--b :global(svg) { width: calc(420 / 1264 * 100cqw); height: calc(284 / 1264 * 100cqw); }
    .gv__text { left: 32px; right: 32px; bottom: 28px; }
    .gv__text :global(.gv__title) { font-size: 1.625rem; }
  }
</style>
