---
/**
 * Zwei Wege (v4): zwei grosse Karten nebeneinander, die eine hell, die andere dunkel (`dark`) – wie die
 * Garantie-Karten. Je ein kleines Wort, ein Satz als Titel und ein Satz Erklärung; darunter die rote
 * Anfrage. Gebraucht für «Kaufen – oder ohne Kauf nutzen» (Krane nach Mass) und «Zwei Wege zu
 * INEXXIO 365» (Kranservice).
 */
import Rich from './Rich.astro';

interface Way { label: string; title: string; text: string; dark?: boolean }
interface Props { title: string; lead: string; ways: Way[]; cta: { label: string; href: string }; id?: string }
const { title, lead, ways, cta, id = 'wege' } = Astro.props;
---
<section class="v4-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="v4-head--center">
      <h2 class="v4-h2" id={`${id}-title`}>{title}</h2>
      <Rich as="p" class="v4-sub" text={lead} />
    </header>
    <ul role="list" class="wp">
      {ways.map((w) => (
        <li class:list={['wp__card', w.dark && 'wp__card--dark']}>
          <span class="wp__label">{w.label}</span>
          <h3 class="wp__title">{w.title}</h3>
          <Rich as="p" class="wp__text" text={w.text} />
        </li>
      ))}
    </ul>
    <p class="wp__act"><a class="btn btn--primary btn--lg" href={cta.href}>{cta.label}</a></p>
  </div>
</section>

<style>
  .wp { list-style: none; padding: 0; display: grid; gap: 12px; margin-top: 40px; }
  .wp__card { display: grid; align-content: end; gap: 10px; min-height: 240px; padding: 28px; border-radius: 24px; background: var(--gray-100); color: var(--ink); }
  .wp__card--dark { background: var(--dark); color: var(--white); }
  .wp__label { font-size: 0.8125rem; font-weight: 600; color: var(--gray-500); }
  .wp__card--dark .wp__label { color: rgba(255, 255, 255, 0.6); }
  .wp__title { font-family: var(--font-display); font-weight: 600; font-size: 1.75rem; line-height: 1.15; letter-spacing: -0.02em; color: inherit; }
  .wp :global(.wp__text) { color: var(--ink-3); max-width: 32em; }
  .wp__card--dark :global(.wp__text) { color: rgba(255, 255, 255, 0.78); }
  .wp__act { display: flex; justify-content: center; max-width: none; margin-top: 32px; }
  .wp__act .btn { --btn-h: 52px; padding: 0 24px; font-size: 1rem; }
  @media (min-width: 960px) {
    .wp { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 56px; }
    .wp__card { min-height: 320px; padding: 40px; }
    .wp__title { font-size: 2.25rem; }
  }
</style>
