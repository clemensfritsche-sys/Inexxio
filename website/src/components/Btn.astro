---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  /** Symbol vor dem Text (z. B. 'phone'); der Pfeil hinten ist Standard bei primary. */
  icon?: IconName;
  arrow?: boolean;
  track?: string;
  block?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const { href, variant = 'primary', size = 'md', icon, arrow = variant === 'primary', track, block, class: cls, ...rest } = Astro.props;
---
<a
  href={href}
  class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', block && 'btn--block', cls]}
  data-track={track}
  {...rest}
>
  {icon && <Icon name={icon} size={18} />}
  <slot />
  {arrow && <Icon name="arrow-right" size={18} class="btn__arrow" />}
</a>
