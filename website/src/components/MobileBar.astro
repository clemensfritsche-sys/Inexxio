---
/**
 * Feste Aktionsleiste unten – nur mobil: [Anrufen] [Anfrage], 56 px hoch.
 * Erscheint, sobald der Seitenkopf aus dem Bild ist: das EINE Element mit data-hero – H1 und
 * die erste Handlung, nie der ganze Artikel (sonst käme sie erst am Seitenende; check-site
 * prüft es). Ohne JS ist sie immer da.
 */
import { site } from '../config/site.mjs';
import Icon from './Icon.astro';
---
<nav class="mobilebar" aria-label="Schnellkontakt" data-mobilebar>
  <a class="mobilebar__btn mobilebar__btn--tel" href={`tel:${site.phone.e164}`}>
    <Icon name="phone" size={20} /> Anrufen
  </a>
  <a class="mobilebar__btn mobilebar__btn--cta" href={site.cta.href}>
    Anfrage <Icon name="arrow-right" size={20} />
  </a>
</nav>

<style>
  /* v4: zwei schwebende Knöpfe mit 12 px Rand, ohne gemeinsame Fläche – links «Anrufen» in
     Glas, rechts die rote Anfrage; jeder trägt seinen eigenen Schatten. */
  .mobilebar {
    position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 40;
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
    transition: transform 320ms var(--ease), opacity 320ms var(--ease), visibility 0s linear 0s;
  }
  /* Versteckt heisst auch: nicht fokussierbar. `visibility` schaltet erst um, wenn die Leiste
     draussen ist (Verzögerung = Dauer der Bewegung). */
  :global(.js) .mobilebar:not(.is-visible),
  :global(html.menu-open) .mobilebar {
    transform: translateY(calc(100% + 24px)); opacity: 0; visibility: hidden;
    transition: transform 320ms var(--ease), opacity 320ms var(--ease), visibility 0s linear 320ms;
  }
  .mobilebar__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; border-radius: 14px;
    font-weight: 600; font-size: 1rem; text-decoration: none; box-shadow: 0 10px 28px rgba(10, 10, 11, 0.16), 0 2px 6px rgba(10, 10, 11, 0.06);
  }
  .mobilebar__btn--tel {
    color: var(--ink); background: rgba(255, 255, 255, 0.62); border: 1px solid rgba(255, 255, 255, 0.95);
    -webkit-backdrop-filter: blur(24px) saturate(180%); backdrop-filter: blur(24px) saturate(180%);
  }
  .mobilebar__btn--cta { background: var(--red); color: var(--white); box-shadow: 0 10px 28px rgba(229, 26, 20, 0.28), 0 2px 6px rgba(10, 10, 11, 0.08); }
  .mobilebar__btn:active { transform: scale(0.98); }
  @media (min-width: 768px) { .mobilebar { display: none; } }
</style>
