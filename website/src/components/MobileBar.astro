---
/**
 * Feste Aktionsleiste unten – nur mobil: [Anrufen] [Anfrage], 56 px hoch.
 * Erscheint, sobald der Seitenkopf (data-hero) aus dem Bild ist. Ohne JS ist sie immer da.
 */
import { site } from '../config/site.mjs';
import Icon from './Icon.astro';
---
<div class="mobilebar" data-mobilebar>
  <a class="mobilebar__btn mobilebar__btn--tel" href={`tel:${site.phone.e164}`} data-track="tel_click">
    <Icon name="phone" size={20} /> Anrufen
  </a>
  <a class="mobilebar__btn mobilebar__btn--cta" href={site.cta.href} data-track="cta_click">
    Anfrage <Icon name="arrow-right" size={20} />
  </a>
</div>

<style>
  .mobilebar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: grid; grid-template-columns: 1fr 1fr; height: calc(56px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom); background: var(--white); border-top: 1px solid var(--line-2);
    transition: transform 260ms var(--ease);
  }
  :global(.js) .mobilebar:not(.is-visible) { transform: translateY(100%); }
  :global(html.menu-open) .mobilebar { transform: translateY(100%); }
  .mobilebar__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font-weight: 600; font-size: 1rem; text-decoration: none; min-height: 56px;
  }
  .mobilebar__btn--tel { color: var(--ink); }
  .mobilebar__btn--cta { background: var(--red); color: var(--white); }
  @media (min-width: 768px) { .mobilebar { display: none; } }
</style>
