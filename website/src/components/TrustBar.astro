---
/** Vertrauensleiste: kurze, belegbare Fakten in einer Zeile. */
import Rich from './Rich.astro';

interface Props { items: string[]; review?: string }
const { items, review } = Astro.props;
---
<div class="trust">
  <ul role="list" class="trust__list">
    {items.map((it) => <Rich as="li" text={it} />)}
  </ul>
  {review && <Rich as="p" class="small" text={review} />}
</div>

<style>
  .trust { display: grid; gap: var(--s-2); }
  .trust__list {
    list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px;
    font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2);
  }
  .trust__list li { display: inline-flex; align-items: center; gap: 10px; }
  .trust__list li::before { content: ''; flex: none; width: 5px; height: 5px; background: var(--ink-3); }
</style>
