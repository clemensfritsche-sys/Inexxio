---
/**
 * Drei Felder, ein Prinzip (v4, Muster Porsche-Modellvergleich): der Text steht in einer grauen
 * Karte, die Zeichnung liegt gross darüber und ragt oben hinaus; beim Zeigen hebt sie sich.
 * Schmal: ein Karussell zum Wischen, es beginnt in der Mitte (scripts/carousel.ts, data-start).
 */
import Rich from '../Rich.astro';
import krane from '../../assets/illustrations/spezial-krane.svg?url';
import fahrzeuge from '../../assets/illustrations/spezial-fahrzeuge.svg?url';
import baumaschinen from '../../assets/illustrations/spezial-baumaschinen.svg?url';

interface Field {
  id: string;
  illo: 'krane' | 'fahrzeuge' | 'baumaschinen';
  title: string;
  tags: string[];
  text: string;
  examples: string[];
  link?: { href: string; label: string };
}
interface Props { title: string; lead: string; items: Field[]; cta: { label: string; href: string } }
const { title, lead, items, cta } = Astro.props;
const ART = { krane, fahrzeuge, baumaschinen };
---
<section class="v4-section" id="felder" aria-labelledby="felder-title">
  <div class="wrap">
    <header class="v4-head--center">
      <h2 class="v4-h2" id="felder-title">{title}</h2>
      <Rich as="p" class="v4-sub" text={lead} />
    </header>
  </div>
  <div class="wrap fc-wrap" data-carousel data-start={Math.floor(items.length / 2)}>
    <ul role="list" class="fc" data-rail>
      {items.map((f) => (
        <li class="fc__card" id={f.id} data-item>
          <div class="fc__art"><img src={ART[f.illo]} alt={`Zeichnung: Speziallösung ${f.title.toLowerCase()}`} width="1000" height="560" loading="lazy" decoding="async" /></div>
          <h3 class="fc__title">{f.title}</h3>
          <p class="fc__tags">{f.tags.map((t) => <Rich as="span" text={t} />)}</p>
          <Rich as="p" class="fc__text" text={f.text} />
          <ul role="list" class="fc__list">{f.examples.map((e) => <li>{e}</li>)}</ul>
          <div class="fc__act">
            {f.link ? <a class="fc__link" href={f.link.href}>{f.link.label}</a> : <span class="fc__link" aria-hidden="true"></span>}
            <a class="btn btn--glass fc__btn" href={cta.href}>{cta.label}</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { initCarousels } from '../../scripts/carousel';
  initCarousels();
</script>

<style>
  .fc { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 150px; }
  .fc__card { position: relative; display: flex; flex-direction: column; padding: 150px 32px 32px; border-radius: 24px; background: var(--gray-100); scroll-margin-top: calc(var(--header-h) + 140px); }
  .fc__art { position: absolute; left: -6%; right: -6%; top: -130px; height: 270px; display: flex; justify-content: center; pointer-events: none; transition: transform 0.6s var(--ease); }
  .fc__card:hover .fc__art { transform: translateY(-8px); }
  .fc__art img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 22px 22px rgba(10, 10, 11, 0.1)); }
  .fc__title { font-family: var(--font-display); font-weight: 600; font-size: 1.875rem; letter-spacing: -0.02em; }
  .fc__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .fc__tags :global(span) { padding: 4px 10px; border-radius: 6px; background: var(--white); font-size: 0.8125rem; font-weight: 500; color: var(--ink-2); }
  .fc__card :global(.fc__text) { margin-top: 20px; min-height: 3em; font-size: 1rem; line-height: 1.5; color: var(--ink); }
  .fc__list { list-style: none; padding: 0; margin-top: 24px; }
  .fc__list li { padding: 10px 0; border-top: 1px solid var(--line-2); font-size: 0.9375rem; color: var(--ink-2); }
  .fc__act { margin-top: auto; padding-top: 28px; display: grid; gap: 20px; }
  .fc__link { min-height: 22px; font-size: 0.9375rem; font-weight: 500; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .fc__btn { --btn-h: 52px; font-size: 1rem; }
  @media (max-width: 959px) {
    .fc-wrap { padding-inline: 0; }
    .fc { display: flex; gap: 12px; margin-top: 0; padding: 150px var(--gutter) 8px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none; }
    .fc::-webkit-scrollbar { display: none; }
    .fc__card { flex: 0 0 78%; scroll-snap-align: center; padding: 130px 22px 22px; }
    .fc__art { top: -120px; height: 230px; }
    .fc__title { font-size: 1.625rem; }
  }
</style>
