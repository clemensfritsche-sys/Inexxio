---
/**
 * Vom Problem zur Lösung (v4): ein senkrechter Weg. Oben «Ihr Problem», unten der rote Punkt
 * «Ihre Lösung», dazwischen fünf Stationen abwechselnd links und rechts – grosse Nummer
 * gegenüber, Symbol im Knoten, graue Karte mit «wer». Ein roter Punkt wandert den Weg hinunter
 * (nicht bei reduzierter Bewegung). Schmal: die Linie links, die Karten rechts.
 */
import Icon, { type IconName } from '../Icon.astro';
import Rich from '../Rich.astro';

/** `no`: was gross neben der Station steht (sonst die laufende Nummer) – auf «Über uns» das Jahr. */
interface Station { icon: IconName; who: string; title: string; text: string; tags?: string[]; check?: string; no?: string }
interface Props { title: string; start: string; end: string; items: Station[]; id?: string }
const { title, start, end, items, id = 'ablauf' } = Astro.props;
---
<section class="v4-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="v4-head--center"><h2 class="v4-h2" id={`${id}-title`}>{title}</h2></header>
    <div class="sp">
      <span class="sp__line" aria-hidden="true"></span>
      <span class="sp__dot" aria-hidden="true"></span>
      <p class="sp__end"><span class="sp__tag glass-light"><i></i>{start}</span></p>
      <ol class="sp__list">
        {items.map((s, i) => (
          <li class:list={['sp__st', i % 2 === 1 && 'sp__st--r', i === items.length - 1 && 'sp__st--last']}>
            <span class="sp__no tnum" aria-hidden="true">{s.no ?? String(i + 1).padStart(2, '0')}</span>
            <span class="sp__node glass-light"><Icon name={s.icon} size={24} /></span>
            <div class="sp__card">
              <span class="sp__who">{s.who}</span>
              <h3 class="sp__title">{s.title}</h3>
              <Rich as="p" class="sp__text" text={s.text} />
              {s.tags && <p class="sp__tags">{s.tags.map((t) => <span>{t}</span>)}</p>}
              {s.check && <p class="sp__check"><Icon name="check" size={18} />{s.check}</p>}
            </div>
          </li>
        ))}
      </ol>
      <p class="sp__end"><span class="sp__tag sp__tag--end">{end}</span></p>
    </div>
  </div>
</section>

<style>
  .sp { position: relative; max-width: 1040px; margin: 40px auto 0; }
  .sp__line { position: absolute; left: 31px; top: 28px; bottom: 28px; width: 2px; margin-left: -1px; background: repeating-linear-gradient(180deg, var(--line-2) 0 8px, transparent 8px 14px); }
  .sp__dot { position: absolute; left: 31px; top: 28px; width: 12px; height: 12px; margin-left: -6px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 6px rgba(229, 26, 20, 0.15); animation: sp-go 7s cubic-bezier(0.45, 0, 0.2, 1) 2; }
  @keyframes sp-go { 0% { top: 28px; opacity: 0; } 6%, 88% { opacity: 1; } 100% { top: calc(100% - 40px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .sp__dot { display: none; } }
  .sp__end { position: relative; display: flex; max-width: none; }
  .sp__tag { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; font-size: 0.875rem; font-weight: 600; color: var(--ink); }
  .sp__tag i { width: 8px; height: 8px; border-radius: 50%; background: var(--ink-4); }
  .sp__tag--end { background: var(--red); color: var(--white); }
  .sp__list { list-style: none; padding: 0; margin: 8px 0; }
  .sp__st { position: relative; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 16px; align-items: start; padding: 12px 0; }
  .sp__node { grid-column: 1; grid-row: 1; position: relative; z-index: 1; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; color: var(--ink); }
  .sp__st--last .sp__node { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .sp__card { grid-column: 2; grid-row: 1; padding: 22px; border-radius: 24px; background: var(--gray-100); transition: transform 0.5s var(--ease); }
  .sp__card:hover { transform: translateY(-4px); }
  .sp__no { grid-column: 2; grid-row: 1; justify-self: end; z-index: 1; margin: 16px 18px 0 0; font-family: var(--font-display); font-weight: 600; font-size: 2.75rem; line-height: 1; letter-spacing: -0.05em; color: var(--line-2); pointer-events: none; }
  .sp__who { font-size: 0.8125rem; font-weight: 600; color: var(--gray-500); }
  .sp__title { margin-top: 6px; font-family: var(--font-display); font-weight: 600; font-size: 1.625rem; letter-spacing: -0.02em; }
  .sp__card :global(.sp__text) { margin-top: 8px; font-size: 0.9375rem; line-height: 1.5; color: var(--ink-2); }
  .sp__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .sp__tags span { padding: 4px 10px; border-radius: 6px; background: var(--white); font-size: 0.8125rem; font-weight: 500; color: var(--ink-2); }
  .sp__check { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; font-size: 0.875rem; font-weight: 500; color: var(--ink); }
  @media (min-width: 960px) {
    .sp { margin-top: 56px; }
    .sp__line, .sp__dot { left: 50%; }
    .sp__end { justify-content: center; }
    .sp__st { grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr); gap: 0; align-items: center; min-height: 240px; padding: 0; }
    .sp__node { grid-column: 2; justify-self: center; }
    .sp__card { grid-column: 1; justify-self: end; width: 100%; max-width: 400px; padding: 28px; }
    .sp__no { grid-column: 3; justify-self: start; margin: 0; font-size: 9.375rem; color: var(--gray-100); }
    .sp__st--r .sp__card { grid-column: 3; justify-self: start; }
    .sp__st--r .sp__no { grid-column: 1; justify-self: end; }
    .sp__title { font-size: 1.625rem; }
  }
</style>
