---
/**
 * Im Winter, wenn der Bau ruht (v4, Anker #winter): links Titel, Satz und die rote Anfrage, rechts
 * das Jahr ab November in zwei Phasen – dunkel mit Schneeflocke «Bau ruht · Wir tauschen die Trommel»,
 * hell mit Sonne «Bausaison · Ihr Fahrmischer fährt», darunter die Monate. Auf einen Blick lesbar:
 * Symbol, zwei Wörter, ein Satz. Texte: content/fahrzeugtechnik.ts (`winterSlot`).
 */
import Icon, { type IconName } from '../Icon.astro';
import Rich from '../Rich.astro';

interface Phase { icon: IconName; label: string; text: string; when: string }
interface Props { title: string; text: string; months: string[]; winter: number; phases: Phase[]; cta: string }
const { title, text, months, winter, phases, cta } = Astro.props;
const [cold, warm] = phases;
---
<section class="v4-section" id="winter" aria-labelledby="winter-title">
  <div class="wrap wb">
    <div class="wb__text">
      <h2 class="v4-h2" id="winter-title">{title}</h2>
      <Rich as="p" class="v4-sub" text={text} />
      <a class="btn btn--primary btn--lg" href="#anfrage">{cta}</a>
    </div>
    <div class="wb__art" style={`--w: ${winter}; --n: ${months.length}`}>
      <ol class="wb__phases">
        {[cold, warm].map((p, i) => (
          <li class:list={['wb__ph', i === 0 && 'wb__ph--cold']}>
            <span class="wb__ic"><Icon name={p.icon} size={28} /></span>
            <span class="wb__label">{p.label}</span>
            <span class="wb__ptext">{p.text}</span>
            <span class="visually-hidden">{p.when}</span>
          </li>
        ))}
      </ol>
      <ol class="wb__months" aria-hidden="true">
        {months.map((m, i) => <li class:list={[i < winter && 'is-cold']}>{m}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .wb { display: grid; gap: 40px; }
  .wb__text { display: grid; justify-items: start; }
  .wb__text .btn { --btn-h: 52px; margin-top: 28px; padding: 0 24px; font-size: 1rem; }
  .wb__art { padding: 20px; border-radius: 24px; background: var(--gray-100); }
  /* Zwei Phasen, so breit wie ihre Monate. */
  .wb__phases, .wb__months { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 6px; }
  .wb__ph { grid-column: span calc(var(--n) - var(--w)); display: grid; align-content: end; gap: 4px; min-height: 180px; padding: 18px; border-radius: 16px; background: var(--white); color: var(--ink); }
  .wb__ph--cold { grid-column: span var(--w); background: var(--ink); color: var(--white); }
  .wb__ic { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: auto; border-radius: 50%; background: var(--gray-100); color: var(--ink); }
  .wb__ph--cold .wb__ic { background: rgba(255, 255, 255, 0.12); color: var(--white); }
  .wb__label { margin-top: 24px; font-family: var(--font-display); font-weight: 600; font-size: 1.375rem; letter-spacing: -0.02em; line-height: 1.15; }
  .wb__ptext { font-size: 0.875rem; line-height: 1.4; color: var(--ink-3); }
  .wb__ph--cold .wb__ptext { color: rgba(255, 255, 255, 0.72); }
  .wb__months { margin-top: 12px; }
  .wb__months li { text-align: center; font-size: 0.75rem; font-weight: 600; color: var(--gray-500); }
  .wb__months li.is-cold { color: var(--ink); }
  @media (max-width: 599px) {
    .wb__art { padding: 14px; }
    .wb__ph { padding: 14px; min-height: 168px; }
    .wb__ic { width: 40px; height: 40px; }
    .wb__label { font-size: 1.125rem; }
    .wb__ptext { font-size: 0.8125rem; }
  }
  @media (min-width: 960px) {
    .wb { grid-template-columns: 5fr 7fr; gap: 64px; align-items: center; }
    .wb__art { padding: 28px; }
    .wb__ph { min-height: 260px; padding: 28px; }
    .wb__label { font-size: 1.875rem; }
    .wb__ptext { font-size: 1rem; }
  }
</style>
