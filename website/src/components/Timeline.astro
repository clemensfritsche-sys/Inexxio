---
/** Zeitstrahl (Übergabe): Jahr gross in der Titelschrift (rot), ein Satz dazu; die Bahn ist die Kranbahn-Linie. */
import Rich from './Rich.astro';

interface Props { items: { year: string; text: string }[] }
const { items } = Astro.props;
---
<ol class="tl" role="list">
  <li class="tl__rail" aria-hidden="true" data-kranbahn><span class="tl__line"></span><span class="tl__cat"></span></li>
  {items.map((it) => (
    <li class="tl__item">
      <Rich as="p" class="tl__year" text={it.year} />
      <Rich as="p" class="tl__text" text={it.text} />
    </li>
  ))}
</ol>

<style>
  .tl { list-style: none; padding: 0 0 0 30px; display: grid; gap: var(--s-6); position: relative; }
  .tl__rail { position: absolute; left: 6px; top: 8px; bottom: 8px; width: 13px; }
  .tl__line { position: absolute; left: 6px; top: 0; bottom: 0; width: 1px; background: var(--ink); transform-origin: top center; }
  .tl__cat { position: absolute; left: 0; bottom: 0; width: 13px; height: 13px; background: var(--red); }
  .tl__year { font-family: var(--font-display); font-size: 1.5rem; line-height: 1; letter-spacing: -0.03em; color: var(--red); font-weight: 800; font-variant-numeric: tabular-nums; }
  .tl__text { margin-top: 4px; color: var(--ink-2); max-width: 30ch; }
  :global(.section--dark) .tl__line { background: rgba(255, 255, 255, 0.5); }
  :global(.section--dark) .tl__year { color: var(--red-bright); }
  :global(.section--paper) .tl__year { color: var(--red-deep); }
  .tl__rail:global(.is-armed) .tl__line { transform: scaleY(0); }
  .tl__rail:global(.is-armed) .tl__cat { opacity: 0; }
  .tl__rail:global(.is-drawn) .tl__line { transform: none; transition: transform 800ms var(--ease); }
  .tl__rail:global(.is-drawn) .tl__cat { opacity: 1; transition: opacity 400ms var(--ease) 600ms; }
  @media (min-width: 900px) {
    .tl { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); padding: 36px 0 0; gap: var(--s-5); }
    .tl__rail { left: 0; right: 0; top: 0; bottom: auto; width: auto; height: 13px; }
    .tl__line { left: 0; right: 0; top: 6px; bottom: auto; width: auto; height: 1px; transform-origin: left center; }
    .tl__cat { left: auto; right: 0; bottom: auto; top: 0; }
    .tl__rail:global(.is-armed) .tl__line { transform: scaleX(0); }
  }
</style>
