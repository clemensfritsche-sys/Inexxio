---
/**
 * Fuss (Auftrag Kap. 7.2), dunkel, sechs Spalten:
 *  1. Logo und der Satz, der das Unternehmen eindeutig beschreibt
 *  2.–4. je ein Bereich mit seinen Unterseiten (aus site.areas)
 *  5. Unternehmen: Übergabe, Über uns, Ratgeber, Karriere, Service – eine eigene Spalte wie
 *     die Bereiche (Rückmeldung 04.10.2026: unter dem Satz wirkte die Liste wie angehängt)
 *  6. Kontakt: Anschrift, Telefon, E-Mail – zur Laufzeit aus dem ERP (scripts/contact.ts)
 * Unterste Zeile: © Jahr · Impressum · Datenschutz · UID.
 */
import { site, contactEmail, isMissing } from '../config/site.mjs';
import { plain, rich } from '../lib/text.mjs';
import Icon from './Icon.astro';
import Lockup from './Lockup.astro';
import { photos } from '../config/photos.mjs';
import { samples } from '../config/photo-samples.mjs';

const year = new Date().getFullYear();
const company = [
  ...site.company,
  { label: site.service.overview, href: site.service.href },
];
const a = site.address;
/** Solange Beispielbilder stehen, führt der Fuss zu ihrem Nachweis (CC BY/BY-SA). */
const hasSamples = Object.keys(samples).some((id) => photos[id] && !photos[id].file);
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__home" aria-label={`${plain(site.brand.full)} – zur Startseite`}><Lockup tone="dark" size="footer" /></a>
        <p class="site-footer__claim" set:html={rich(site.footer.claim)} />
      </div>

      {site.areas.map((area) => (
        <nav class="site-footer__col" aria-label={area.label}>
          <h2 class="site-footer__title"><a href={area.href}>{area.label}</a></h2>
          <ul role="list">
            {area.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          </ul>
        </nav>
      ))}

      <nav class="site-footer__col" aria-label="Unternehmen">
        <h2 class="site-footer__title">Unternehmen</h2>
        <ul role="list">
          {company.map((c) => <li><a href={c.href}>{plain(c.label)}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__title"><a href="/kontakt">Kontakt</a></h2>
        <address class="site-footer__contact">
          <p>
            <span class="site-footer__k"><Icon name="map-pin" size={16} /></span>
            <span data-erp="address">{plain(site.brand.legalName)}<br />{a.street}<br />{a.zip} {a.city}</span>
          </p>
          <p>
            <span class="site-footer__k"><Icon name="phone" size={16} /></span>
            <span><a href={`tel:${site.phone.e164}`} data-track="tel_click" class="tnum">{site.phone.display}</a></span>
          </p>
          <p>
            <span class="site-footer__k"><Icon name="mail" size={16} /></span>
            <span><a href={`mailto:${contactEmail()}`} data-track="mailto_click">{contactEmail()}</a>{isMissing(site.email.primary) && <> <span set:html={rich(site.email.primary)} /></>}</span>
          </p>
        </address>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {plain(site.brand.legalName)}</p>
      <ul role="list">
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
        {hasSamples && <li><a href="/impressum#bildnachweis">Bildnachweis</a></li>}
        <li>UID <span set:html={rich(site.brand.uid)} /></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--dark); color: rgba(244, 243, 241, 0.78); padding-top: 80px; font-size: 0.875rem; }
  .site-footer a { color: rgba(255, 255, 255, 0.78); text-decoration: none; transition: color var(--t-fast) var(--ease); }
  .site-footer a:hover { color: var(--white); text-decoration: underline; text-underline-offset: 0.2em; }
  .site-footer__grid {
    display: grid; gap: var(--s-7) var(--s-6); grid-template-columns: minmax(0, 1fr);
    padding-bottom: var(--s-7); border-bottom: 1px solid var(--line-dark);
  }
  @media (min-width: 720px) { .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 960px) { .site-footer__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .site-footer__grid { grid-template-columns: 1.3fr repeat(4, minmax(0, 1fr)) 1.3fr; } }
  .site-footer__home { display: inline-flex; min-height: 44px; align-items: center; }
  .site-footer__claim { margin-top: var(--s-4); max-width: 36ch; color: rgba(244, 243, 241, 0.72); line-height: 1.55; }
  /* Jeder Spaltentitel hat dieselbe 44-px-Zeile – ob verlinkt oder nicht. */
  .site-footer__title {
    font-family: var(--font-sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: rgba(244, 243, 241, 0.6);
    display: flex; align-items: center; min-height: 44px; margin: 0;
  }
  .site-footer__title a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; }
  .site-footer__col ul { list-style: none; padding: 0; display: grid; gap: 0; }
  .site-footer__col li a { display: inline-flex; align-items: center; min-height: 44px; }
  .site-footer__contact { font-style: normal; display: grid; gap: var(--s-3); }
  .site-footer__contact p { display: grid; grid-template-columns: 22px 1fr; gap: 8px; max-width: none; line-height: 1.5; }
  .site-footer__k { color: var(--red-bright); padding-top: 3px; }
  /* Im Fliesstext: unterstrichen (nicht nur über die Farbe erkennbar) und mit 44 px hoher
     Trefferfläche – vertikales Padding an einem Inline-Element verschiebt keine Zeile. */
  .site-footer__contact a { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-color: rgba(255, 255, 255, 0.45); padding-block: 14px; }
  .site-footer__bottom {
    display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); justify-content: space-between; align-items: center;
    padding-block: var(--s-5) var(--s-6); font-size: 0.875rem; color: rgba(244, 243, 241, 0.6);
  }
  .site-footer__bottom ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); align-items: center; }
  .site-footer__bottom a { color: rgba(244, 243, 241, 0.85); display: inline-flex; min-height: 44px; align-items: center; }
</style>
