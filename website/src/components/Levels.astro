---
/**
 * «Die drei Ebenen» eines Bereichs (Auftrag Kap. 3.3, 7.4): Lösungen · Service & Reparatur ·
 * Ersatz- und Verschleissteile – drei klar getrennte Blöcke nebeneinander, je ein Satz und
 * die Links auf die Unterseiten. Getrennt durch Haarlinien, nicht durch Kästen.
 */
import Icon from './Icon.astro';
import Rich from './Rich.astro';

interface Props {
  levels: { title: string; text: string; links: { href: string; label: string }[] }[];
}
const { levels } = Astro.props;
---
<ol class="levels" role="list">
  {levels.map((l) => (
    <li class="levels__item">
      <h3 class="levels__title">{l.title}</h3>
      <Rich as="p" class="levels__text" text={l.text} />
      <ul role="list" class="levels__links">
        {l.links.map((k) => <li><a href={k.href}>{k.label} <Icon name="arrow-right" size={16} /></a></li>)}
      </ul>
    </li>
  ))}
</ol>

<style>
  .levels { list-style: none; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 2px solid var(--ink); }
  .levels__item { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5) 0 var(--s-6); border-bottom: 1px solid var(--line-2); }
  .levels__title { font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem); }
  .levels__text { color: var(--ink-2); }
  .levels__links { list-style: none; padding: 0; margin-top: auto; }
  .levels__links li { border-top: 1px solid var(--line); }
  .levels__links a {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 46px;
    color: var(--ink); font-weight: 500; text-decoration: none;
  }
  .levels__links a :global(.icon) { color: var(--red); flex: none; transition: transform var(--t-base) var(--ease); }
  .levels__links a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .levels__links a:hover :global(.icon) { transform: translateX(3px); }
  @media (min-width: 900px) {
    .levels { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .levels__item { padding: var(--s-5) var(--s-6) var(--s-5) 0; border-bottom: 0; }
    .levels__item + .levels__item { padding-left: var(--s-6); border-left: 1px solid var(--line-2); }
  }
</style>
