---
/**
 * Bildkarten wie eine Zeitschrift (v4, Muster Porsche): breit zwei Spalten, die linke deutlich tiefer (160 px);
 * schmal eine Reihe zum Wischen, die nächste Karte schaut herein. Die Karten kommen als `<li>` herein
 * (meist je eine `PhotoCard`). Gebraucht im Verschleissteile-Katalog und bei den Situationen auf
 * Krane nach Mass und bei den Bauformen der Heukrananlagen.
 * `art`: Zeichnungen statt Fotos – die Zeichnung ragt oben aus der Karte (PhotoCard `illo`), darum steht
 * über und zwischen den Reihen Platz. Ein `<li class="mag__end">` (die
 * kompakte Karte «… nicht dabei?») schliesst breit die rechte Spalte, wo die linke eine Stufe tiefer endet.
 */
interface Props { art?: boolean }
const { art = false } = Astro.props;
---
<ul role="list" class:list={['mag', art && 'mag--art']}><slot /></ul>

<style>
  .mag { list-style: none; padding: 0 var(--gutter) 4px; margin-inline: calc(var(--gutter) * -1); display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none; }
  .mag::-webkit-scrollbar { display: none; }
  .mag > :global(li) { flex: 0 0 82%; scroll-snap-align: start; scroll-margin-top: calc(var(--header-h) + 24px); }
  /* Schmal: Platz für die Zeichnung, die oben aus der Karte ragt (der Wischstreifen schneidet sonst ab). */
  .mag--art { padding-top: 64px; }
  @media (min-width: 960px) {
    .mag { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-inline: 0; padding: 0 0 160px; overflow: visible; }
    .mag > :global(li:nth-child(odd)) { transform: translateY(160px); }
    .mag--art { --row: 128px; padding-top: 96px; gap: var(--row) 32px; }
    .mag > :global(li.mag__end) { grid-column: 2; transform: none; margin-top: calc(32px - var(--row, 32px)); }
    .mag > :global(li.mag__end) > :global(.pc) { aspect-ratio: auto; }
  }
</style>
