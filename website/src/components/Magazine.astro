---
/**
 * Bildkarten wie eine Zeitschrift (v4, Muster Porsche): breit zwei Spalten, die linke eine Stufe tiefer;
 * schmal eine Reihe zum Wischen, die nächste Karte schaut herein. Die Karten kommen als `<li>` herein
 * (meist je eine `PhotoCard`). Gebraucht im Verschleissteile-Katalog und bei den Situationen auf
 * Krane nach Mass.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<ul role="list" class:list={['mag', cls]}><slot /></ul>

<style>
  .mag { list-style: none; padding: 0 var(--gutter) 4px; margin-inline: calc(var(--gutter) * -1); display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none; }
  .mag::-webkit-scrollbar { display: none; }
  .mag > :global(li) { flex: 0 0 82%; scroll-snap-align: start; scroll-margin-top: calc(var(--header-h) + 24px); }
  @media (min-width: 960px) {
    .mag { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-inline: 0; padding: 0 0 96px; overflow: visible; }
    .mag > :global(li:nth-child(odd)) { transform: translateY(96px); }
  }
</style>
