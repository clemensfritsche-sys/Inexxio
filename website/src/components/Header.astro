---
/**
 * Kopfzeile, zweizeilig (Auftrag Kap. 7.1):
 *  - Servicezeile (36 px, dunkel, ab 768 px): links «HS Steiner heisst jetzt INEXXIO»
 *    (Schalter), rechts Notfall · Telefon · Anmelden bzw. Profilmenü.
 *  - Hauptzeile (72 px, weiss): Logo · Krantechnik ▾ · Fahrzeugtechnik ▾ · Sonderlösungen ▾ ·
 *    Service ▾ · Über uns · Kontakt · «Anfrage stellen». Schmaler: Logo, Telefon, Menü.
 *
 *  - Darüber, nur für Personal, die **Arbeitsleiste** (32 px, leise Slate-Fläche): «ERP» und
 *    die Datensatztypen. Sie scrollt mit der Seite weg; sticky bleibt die Kopfzeile. Einen
 *    ERP-Knopf in Servicezeile oder Profilmenü gibt es darum nicht mehr.
 *
 * Ohne JavaScript voll bedienbar: Dropdowns öffnen per Zeigen/Fokus, das Mobil-Menü ist ein
 * natives <details>, statt des Profilmenüs steht «Anmelden». Das Skript ergänzt nur Komfort.
 *
 * ►►► Kein `transform`, kein `backdrop-filter`, kein `filter` auf der Kopfzeile. ◄◄◄
 * Jede dieser Eigenschaften macht sie zum Bezugsrahmen für `position: fixed` – das
 * Vollbild-Menü war genau so in der 60 px hohen Kopfzeile eingesperrt (Rückmeldung
 * 04.10.2026, WEBSITE_PLAN Entscheid 35). Die Servicezeile klappt darum über den
 * Sticky-Versatz (`top`) weg, nicht über eine Verschiebung.
 *
 * Anmeldezustand: `html[data-account]` setzt scripts/early.js vor dem ersten Zeichnen aus
 * dem Anzeige-Cache des Kontos (Schnittstelle S1) – darum springt nichts. Sichtbar wird je
 * Zustand, was `data-acct` trägt (Regeln in global.css). Durchgesetzt wird hier nichts:
 * den Schutz von /konto und /erp hat das ERP.
 */
import { site } from '../config/site.mjs';
import { plain } from '../lib/text.mjs';
import Icon from './Icon.astro';
import Lockup from './Lockup.astro';
import Photo from './Photo.astro';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const within = (href: string) => path === href || path.startsWith(`${href}/`);
const tel = `tel:${site.phone.e164}`;
const notfallTel = `tel:${site.notfall.e164}`;
const notfall = site.features.notfall;
const acct = site.account;
const work = acct.workbar;

/** Die vier Dropdowns: drei Bereiche, dann Service. */
const groups = [
  ...site.areas.map((a) => ({ id: a.id, label: a.label, href: a.href, overview: a.overview, photo: a.photo, children: a.children })),
  { id: 'service', label: site.service.label, href: site.service.href, overview: site.service.overview, photo: site.service.photo, children: site.service.children },
];
const groupActive = (g: (typeof groups)[number]) => within(g.href) || g.children.some((c) => c.href === path);
---
<nav class="workbar" data-acct="staff" aria-label="Arbeitsleiste">
  <div class="wrap workbar__in">
    <a class="workbar__home" href={work.href} rel="nofollow"><Icon name="layout-dashboard" size={16} /> {work.label}</a>
    <ul role="list" class="workbar__list">
      {work.links.map((l) => <li><a href={l.href} rel="nofollow">{l.label}</a></li>)}
    </ul>
  </div>
</nav>
<header class="site-header" data-header>
  <div class="servicebar on-dark">
    <div class="wrap servicebar__in">
      {site.features.announcement && (
        <p class="servicebar__news">
          <span>{plain(site.announcement.text)}</span>
          <a href={site.announcement.link.href}>{site.announcement.link.label} <Icon name="arrow-right" size={14} /></a>
        </p>
      )}
      <ul role="list" class="servicebar__links">
        {notfall && (
          <li>
            <a class="servicebar__link servicebar__notfall" href={notfallTel} data-track="notfall_click">
              <Icon name="siren" size={16} /> Notfall <span class="tnum">{site.notfall.display}</span>
            </a>
          </li>
        )}
        <li>
          <a class="servicebar__link" href={tel} data-track="tel_click">
            <Icon name="phone" size={16} /> <span class="tnum">{site.phone.display}</span>
          </a>
        </li>
        <li data-acct="login">
          <a class="servicebar__link" href={acct.login.href} rel="nofollow">
            <Icon name="circle-user" size={16} /> {acct.login.label}
          </a>
        </li>
        <li data-acct="user" class="pm" data-pm>
          <button type="button" class="pm__toggle" aria-expanded="false" aria-controls="profilmenu" data-pm-toggle>
            <span class="pm__initials" data-acct-initials aria-hidden="true"><Icon name="user" size={14} /></span>
            <span class="visually-hidden">Profilmenü</span>
            <Icon name="chevron-down" size={14} class="pm__chev" />
          </button>
          <div class="pm__panel" id="profilmenu" data-pm-panel>
            <p class="pm__who">
              <strong data-acct-name>Angemeldet</strong>
              <span data-acct-email></span>
            </p>
            <ul role="list" class="pm__list">
              <li><a href={acct.profile.href} rel="nofollow"><Icon name="user" size={18} /> {acct.profile.label}</a></li>
              <li class="pm__sep"><a href={acct.logout.href} rel="nofollow"><Icon name="log-out" size={18} /> {acct.logout.label}</a></li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div class="mainbar">
    <div class="wrap mainbar__in">
      <a href="/" class="site-header__home" aria-label={`${plain(site.brand.full)} – zur Startseite`}>
        <Lockup />
      </a>

      <nav class="nav" aria-label="Hauptnavigation">
        <ul role="list" class="nav__list">
          {groups.map((g, i) => (
            <li class:list={['nav__item dd', i === groups.length - 1 && 'dd--end']} data-dd>
              <button
                type="button"
                class:list={['nav__link', groupActive(g) && 'is-current']}
                aria-expanded="false"
                aria-controls={`dd-${g.id}`}
                data-dd-toggle
              >
                {g.label} <Icon name="chevron-down" size={16} class="nav__chev" />
              </button>
              <div class="dd__panel" id={`dd-${g.id}`} data-dd-panel>
                <div class="dd__main">
                  <ul role="list" class="dd__list">
                    {g.children.map((c) => (
                      <li>
                        <a href={c.href} class="dd__link" aria-current={path === c.href ? 'page' : undefined}>
                          <span class="dd__label">{c.label}</span>
                          <span class="dd__text">{c.text}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a href={g.href} class="dd__overview" aria-current={path === g.href ? 'page' : undefined}>
                    {g.overview} <Icon name="arrow-right" size={16} />
                  </a>
                </div>
                <a href={g.href} class="dd__media" tabindex="-1" aria-hidden="true">
                  <Photo id={g.photo} sizes="240px" />
                </a>
              </div>
            </li>
          ))}
          {site.menu.map((m) => (
            <li class="nav__item">
              <a href={m.href} class:list={['nav__link', within(m.href) && 'is-current']} aria-current={within(m.href) ? 'page' : undefined}>{m.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mainbar__actions">
        <a class="mainbar__tel" href={tel} data-track="tel_click" aria-label={`${site.phone.display} anrufen`}>
          <Icon name="phone" size={20} />
        </a>
        <a class="btn btn--primary btn--sm mainbar__cta" href={site.cta.href}>
          {site.cta.label} <Icon name="arrow-right" size={18} class="btn__arrow" />
        </a>

        <details class="mnav" data-mnav>
          <summary class="mnav__toggle">
            <span class="mnav__icon-open"><Icon name="menu" size={24} /></span>
            <span class="mnav__icon-close"><Icon name="x" size={24} /></span>
            <span class="visually-hidden">Menü</span>
          </summary>
          <div class="mnav__panel">
            <div class="mnav__top wrap"><Lockup /></div>
            <nav class="mnav__nav wrap" aria-label="Hauptnavigation (mobil)">
              {groups.map((g) => (
                <details class="mnav__group" open={groupActive(g) ? true : undefined}>
                  <summary class="mnav__link">
                    {g.label}
                    <Icon name="chevron-down" size={20} />
                  </summary>
                  <ul role="list" class="mnav__sub">
                    {g.children.map((c) => (
                      <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}<span>{c.text}</span></a></li>
                    ))}
                    <li><a href={g.href} class="mnav__overview" aria-current={path === g.href ? 'page' : undefined}>{g.overview}</a></li>
                  </ul>
                </details>
              ))}
              {site.menu.map((m) => (
                <a href={m.href} class="mnav__link" aria-current={within(m.href) ? 'page' : undefined}>{m.label}</a>
              ))}
              <ul role="list" class="mnav__more">
                {site.company.filter((c) => !site.menu.some((m) => m.href === c.href)).map((c) => (
                  <li><a href={c.href} aria-current={within(c.href) ? 'page' : undefined}>{plain(c.label)}</a></li>
                ))}
              </ul>
              <ul role="list" class="mnav__account">
                <li data-acct="login"><a href={acct.login.href} rel="nofollow"><Icon name="circle-user" size={20} /> {acct.login.label}</a></li>
                <li data-acct="user"><a href={acct.profile.href} rel="nofollow"><Icon name="user" size={20} /> {acct.profile.label} <span class="mnav__who" data-acct-name></span></a></li>
                <li data-acct="user"><a href={acct.logout.href} rel="nofollow"><Icon name="log-out" size={20} /> {acct.logout.label}</a></li>
              </ul>
              {notfall && (
                <p class="mnav__notfall">
                  <Icon name="siren" size={18} /> Notfall bei Stillstand:
                  <a href={notfallTel} data-track="notfall_click" class="tnum">{site.notfall.display}</a>
                </p>
              )}
            </nav>
            <div class="mnav__actions">
              <a class="btn btn--secondary" href={tel} data-track="tel_click"><Icon name="phone" size={18} /> Anrufen</a>
              <a class="btn btn--primary" href={site.cta.href}>Anfrage <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  /* Deckend weiss (Kap. 9.7: keine Glas-Effekte). Einklappen über `top`, siehe Kopfkommentar. */
  .site-header {
    position: sticky; top: 0; z-index: 50; background: var(--white);
    transition: top 220ms var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  :global(.js) .site-header.is-scrolled { box-shadow: 0 1px 0 var(--line); }
  @media (min-width: 768px) {
    :global(.js) .site-header.is-compact { top: calc(-1 * var(--servicebar-h)); }
  }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }

  /* ---------- Arbeitsleiste (nur Personal) ---------- */
  .workbar { background: var(--slate-soft); color: var(--slate); font-size: 0.8125rem; border-bottom: 1px solid var(--line); }
  .workbar__in { height: 32px; display: flex; align-items: center; gap: var(--s-4); white-space: nowrap; }
  .workbar a { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; color: inherit; text-decoration: none; }
  .workbar a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .workbar__home { font-weight: 700; }
  .workbar__list { display: none; gap: var(--s-4); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 640px) { .workbar__list { display: flex; } }

  /* ---------- Servicezeile ---------- */
  .servicebar { display: none; background: var(--dark); color: rgba(244, 243, 241, 0.8); font-size: 0.8125rem; }
  .servicebar__in { height: var(--servicebar-h); display: flex; align-items: center; gap: var(--s-5); white-space: nowrap; }
  .servicebar__news { display: none; align-items: center; gap: 10px; max-width: none; margin-right: auto; color: rgba(244, 243, 241, 0.72); }
  .servicebar__news a { display: inline-flex; align-items: center; gap: 4px; color: var(--white); font-weight: 600; text-decoration: none; min-height: var(--servicebar-h); }
  .servicebar__news a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .servicebar__links { display: flex; align-items: center; gap: 2px; margin-left: auto; list-style: none; padding: 0; }
  .servicebar__link {
    display: inline-flex; align-items: center; gap: 6px; height: var(--servicebar-h); padding: 0 10px;
    color: rgba(244, 243, 241, 0.86); text-decoration: none; font-weight: 500;
  }
  .servicebar__link:hover { color: var(--white); text-decoration: underline; text-underline-offset: 0.2em; }
  .servicebar__notfall :global(.icon) { color: var(--red-bright); }

  /* Profilmenü: Initialen im Kreis (rot – wie im bisherigen Konto-Kopf), Liste darunter. */
  .pm { position: relative; }
  .pm__toggle {
    display: inline-flex; align-items: center; gap: 6px; height: var(--servicebar-h); padding: 0 6px 0 10px;
    color: rgba(244, 243, 241, 0.86);
  }
  .pm__initials {
    display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%;
    background: var(--red); color: var(--white); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.02em;
  }
  .pm__toggle :global(.pm__chev) { transition: transform var(--t-fast) var(--ease); }
  .pm__toggle[aria-expanded='true'] :global(.pm__chev) { transform: rotate(180deg); }
  .pm__panel {
    display: none; position: absolute; right: 0; top: 100%; z-index: 60; width: 260px; white-space: normal;
    background: var(--white); color: var(--ink); border: 1px solid var(--line); border-radius: var(--r-md);
    box-shadow: var(--shadow-lg); padding: var(--s-2);
  }
  .pm.is-open .pm__panel { display: block; animation: drop-in 150ms var(--ease); }
  .pm__who { display: grid; gap: 2px; padding: 8px 10px 10px; border-bottom: 1px solid var(--line); margin-bottom: 4px; }
  .pm__who strong { font-size: 0.9375rem; }
  .pm__who span { font-size: 0.8125rem; color: var(--ink-3); overflow-wrap: anywhere; }
  .pm__who span:empty { display: none; }
  .pm__list a {
    display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 10px; border-radius: var(--r-sm);
    color: var(--ink); text-decoration: none; font-size: 0.9375rem; font-weight: 500;
  }
  .pm__list a:hover { background: var(--paper); }
  .pm__list :global(.icon) { color: var(--ink-3); }
  .pm__sep { border-top: 1px solid var(--line); margin-top: 4px; padding-top: 4px; }

  /* ---------- Hauptzeile ---------- */
  .mainbar__in { height: var(--header-h); display: flex; align-items: center; gap: var(--s-5); white-space: nowrap; }
  .site-header__home { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; flex: none; }
  .mainbar__actions { margin-left: auto; display: flex; align-items: center; gap: var(--s-2); }

  .nav { display: none; }
  .nav__list { display: flex; align-items: center; gap: 0; list-style: none; padding: 0; }
  .nav__item { position: relative; display: flex; align-items: center; }
  /* Navigation: leise Stimme (ink-2), beim Zeigen dunkel – und die rote Linie wächst von links. */
  .nav__link {
    display: inline-flex; align-items: center; gap: 4px; min-height: 44px; padding: 0 11px;
    font-size: 0.9375rem; font-weight: 500; letter-spacing: -0.01em; color: var(--ink-2);
    text-decoration: none; position: relative; transition: color var(--t-fast) var(--ease);
  }
  .nav__link::after {
    content: ''; position: absolute; left: 11px; right: calc(100% - 11px); bottom: 7px; height: 2px;
    background: var(--red); transition: right 200ms var(--ease);
  }
  .nav__link:hover, .nav__link.is-current, .nav__link[aria-expanded='true'] { color: var(--ink); }
  .nav__link:hover::after, .nav__link.is-current::after { right: 11px; }
  .nav__link :global(.nav__chev) { color: var(--ink-3); transition: transform var(--t-fast) var(--ease); }
  .nav__link[aria-expanded='true'] :global(.nav__chev) { transform: rotate(180deg); }

  /* Mega-Dropdown (schlicht): Unterseiten links, kleines Foto rechts. Geschlossen ist es
     `display: none` – dann lädt auch das Foto erst, wenn jemand das Menü öffnet. */
  .dd__panel {
    display: none; position: absolute; top: calc(100% + 10px); left: 0; z-index: 55;
    grid-template-columns: minmax(0, 1fr) 220px; gap: var(--s-4); width: 600px; white-space: normal;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg); padding: var(--s-3);
  }
  .dd--end .dd__panel { left: auto; right: 0; }
  /* Brücke zwischen Eintrag und Panel, damit es beim Hinüberzeigen nicht zuklappt. */
  .dd__panel::before { content: ''; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
  /* Ohne JS öffnet auch der Tastaturfokus; mit JS übernimmt der Knopf (aria-expanded). */
  :global(html:not(.js)) .dd:focus-within .dd__panel,
  .dd:hover .dd__panel, .dd.is-open .dd__panel { display: grid; animation: drop-in 150ms var(--ease); }
  .dd.is-closed .dd__panel { display: none; }
  .dd__main { display: flex; flex-direction: column; }
  .dd__list { list-style: none; padding: 0; }
  .dd__link { display: grid; gap: 1px; padding: 9px 12px; border-radius: var(--r-md); text-decoration: none; }
  .dd__link:hover, .dd__link:focus-visible { background: var(--paper); }
  .dd__label { font-weight: 600; color: var(--ink); font-size: 0.9375rem; }
  .dd__link[aria-current='page'] .dd__label { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .dd__text { font-size: 0.8125rem; color: var(--ink-3); }
  .dd__overview {
    display: flex; align-items: center; justify-content: space-between; margin-top: auto;
    padding: 12px 12px 6px; border-top: 1px solid var(--line); font-size: 0.875rem; font-weight: 600;
    color: var(--red-deep); text-decoration: none;
  }
  .dd__overview:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .dd__media { display: block; overflow: hidden; border-radius: var(--r-md); align-self: start; }
  .dd__media :global(.ph) { padding: var(--s-3); }
  .dd__media :global(.ph__brief) { font-size: 0.75rem; }

  .mainbar__tel {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--ink);
  }
  .mainbar__cta { display: none; }

  /* ---------- Mobil-Menü (unter 1200 px) ---------- */
  .mnav { display: block; }
  .mnav__toggle {
    list-style: none; display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; color: var(--ink); cursor: pointer; border-radius: var(--radius);
  }
  .mnav__toggle::-webkit-details-marker { display: none; }
  .mnav__icon-close { display: none; }
  .mnav[open] .mnav__icon-open { display: none; }
  .mnav[open] .mnav__icon-close { display: inline-flex; }
  /* Offen: der Schliessen-Knopf liegt über dem Menü an derselben Stelle wie der Burger. */
  .mnav[open] > .mnav__toggle {
    position: fixed; top: calc((var(--header-h) - 44px) / 2); right: var(--gutter); z-index: 62;
  }
  .mnav__panel {
    position: fixed; inset: 0; z-index: 61; background: var(--white); white-space: normal;
    display: flex; flex-direction: column; overflow-y: auto; overscroll-behavior: contain;
  }
  .mnav__top { height: var(--header-h); display: flex; align-items: center; flex: none; border-bottom: 1px solid var(--line); }
  .mnav__nav { display: grid; align-content: start; padding-top: var(--s-3); padding-bottom: var(--s-6); flex: 1 0 auto; }
  .mnav__link {
    display: flex; align-items: center; justify-content: space-between; min-height: 56px;
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ink);
    text-decoration: none; border-bottom: 1px solid var(--line); list-style: none; cursor: pointer;
  }
  .mnav__link::-webkit-details-marker { display: none; }
  .mnav__link[aria-current='page'] { box-shadow: inset 3px 0 0 var(--red); padding-left: 12px; }
  .mnav__link :global(.icon) { transition: transform var(--t-fast) var(--ease); }
  .mnav__group[open] > .mnav__link :global(.icon) { transform: rotate(180deg); }
  .mnav__sub { list-style: none; padding: var(--s-2) 0 var(--s-3); border-bottom: 1px solid var(--line); }
  .mnav__sub a { display: grid; gap: 2px; padding: 10px 0 10px 12px; text-decoration: none; color: var(--ink); font-weight: 600; }
  .mnav__sub a span { font-weight: 400; font-size: 0.875rem; color: var(--ink-3); }
  .mnav__sub a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--red); }
  .mnav__overview { color: var(--red-deep) !important; }
  .mnav__more { display: flex; flex-wrap: wrap; gap: 0 var(--s-5); padding: var(--s-3) 0; border-bottom: 1px solid var(--line); }
  .mnav__more a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); font-weight: 500; text-decoration: none; }
  .mnav__more a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--red); }
  .mnav__account { padding: var(--s-2) 0; border-bottom: 1px solid var(--line); }
  .mnav__account a { display: flex; align-items: center; gap: 12px; min-height: 48px; color: var(--ink); font-weight: 600; text-decoration: none; }
  .mnav__account :global(.icon) { color: var(--ink-3); }
  .mnav__who { font-weight: 400; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; }
  .mnav__notfall { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding-top: var(--s-4); color: var(--ink-2); }
  .mnav__notfall :global(.icon) { color: var(--red); }
  .mnav__notfall a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; color: var(--ink); }
  .mnav__actions {
    position: sticky; bottom: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3);
    padding: var(--s-3) var(--gutter) calc(var(--s-3) + env(safe-area-inset-bottom));
    background: var(--white); border-top: 1px solid var(--line);
  }

  @media (min-width: 600px) {
    .mainbar__cta { display: inline-flex; }
  }
