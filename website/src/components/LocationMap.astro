---
/**
 * Schematische Karte des Standorts – eigene SVG-Zeichnung aus echten Koordinaten
 * (Projektion in km ab Tuttwil). Kein Kartendienst, keine Fremdanfrage, kein Cookie.
 * Sie zeigt, wo wir zuhause sind – kein Einsatzgebiet und keine Grenze (Rückmeldung
 * 04.10.2026: «uns nicht limitieren»).
 */

interface Props { class?: string }
const { class: cls } = Astro.props;

/** Nur die grösseren Städte (#1143) – zur Orientierung, nicht als Liste von Einsatzorten. */
const towns = [
  { name: 'Frauenfeld', x: -2.8, y: -7.8, dx: -2, dy: -2, end: true },
  { name: 'Wil', x: 8.2, y: 2.5, dx: 2, dy: 3.6 },
  { name: 'Winterthur', x: -15.9, y: -1.8, dx: -2, dy: -2, end: true },
  { name: 'Zürich', x: -29.6, y: 11.9, dx: -2, dy: -2, end: true },
  { name: 'St. Gallen', x: 33.0, y: 6.6, dx: 2, dy: 3.8 },
  { name: 'Schaffhausen', x: -22.7, y: -23.6, dx: -2, dy: -2.5, end: true },
];
const lake =
  '18,-20.2 22.1,-17.4 26.6,-12.9 33.4,-9.2 37.4,-3.7 42,0.6 46.9,-0.7 57.4,-2.4 56.3,-6.9 48.4,-11.8 40.9,-18.5 29.6,-21.8 23.6,-24.1 16.9,-31.8 9.3,-36.9 8.6,-34.1 16.1,-27.4 18.7,-24.1 17.6,-21.8';
const untersee = '15.4,-20.2 10.8,-21 3.7,-20.5 -0.8,-18.2 -5.5,-19.6 -4.2,-23 2.6,-28 4.8,-28.5 10.1,-25.7 13.8,-23.5';
const rhine = 'M-5.7,-19.5 L-11.7,-21.8 L-17.7,-23.7 L-22.7,-23.6 L-26,-21.8 L-30.5,-11.8 L-38,-4';
const desc = 'Schematische Karte: Tuttwil zwischen Winterthur, Frauenfeld, Wil und St. Gallen, nahe dem Bodensee.';
---
<figure class:list={['amap', cls]}>
  <svg viewBox="-56 -48 120 98" role="img" aria-label={`Standort Tuttwil. ${desc}`} class="amap__svg">
    <polygon points={lake} class="amap__water" />
    <polygon points={untersee} class="amap__water" />
    <path d={rhine} class="amap__river" />
    <text x="40" y="-10.5" class="amap__region">BODENSEE</text>
    <text x="-50" y="-41" class="amap__region">DEUTSCHLAND</text>
    <text x="-50" y="44" class="amap__region">SCHWEIZ</text>
    {towns.map((t) => (
      <g>
        <circle cx={t.x} cy={t.y} r="0.9" class="amap__dot" />
        <text x={t.x + t.dx} y={t.y + t.dy} text-anchor={t.end ? 'end' : 'start'} class="amap__town">{t.name}</text>
      </g>
    ))}
    <rect x="-1.6" y="-1.6" width="3.2" height="3.2" class="amap__home" />
    <text x="2.4" y="-2.2" class="amap__hometext">Tuttwil</text>
  </svg>
</figure>

<style>
  .amap { margin: 0; display: grid; gap: var(--s-2); max-width: 600px; }
  /* Durchsichtig, ohne Rahmen (#1109): die Karte liegt auf der Fläche ihrer Sektion. Die
     Freistellung der Schrift nimmt dieselbe Farbe (--map-bg), damit sie lesbar bleibt. */
  .amap { --map-bg: var(--white); }
  :global(.section--paper) .amap { --map-bg: var(--paper); }
  .amap__svg { width: 100%; height: auto; display: block; }
  .amap__water { fill: var(--slate-soft); stroke: none; }
  .amap__river { fill: none; stroke: var(--slate); stroke-opacity: 0.35; stroke-width: 0.6; stroke-linecap: round; stroke-linejoin: round; }
  .amap__dot { fill: var(--ink); }
  .amap__town { fill: var(--ink-2); font-weight: 500; }
  /* Freistellung wie auf jeder Karte: wo der Kreis oder der Rhein eine Beschriftung kreuzt,
     unterbricht ein Rand in der Grundfarbe die Linie, statt durch die Buchstaben zu laufen. */
  .amap__town, .amap__hometext { paint-order: stroke; stroke: var(--map-bg); stroke-width: 0.9px; stroke-linejoin: round; }
  .amap__home { fill: var(--red); }
  .amap__hometext { font-weight: 700; fill: var(--ink); }
  .amap__region { font-family: var(--font-mono); letter-spacing: 0.2px; fill: var(--ink-3); }
  /* Die Schrift skaliert mit der Zeichnung – mit nur noch den grossen Städten (#1143) darf sie
     überall gross sein, auch in der schmalen Spalte neben dem Formular. */
  .amap__town { font-size: 3.6px; }
  .amap__hometext { font-size: 4.2px; }
  .amap__region { font-size: 2.6px; }
</style>
