---
/**
 * Schematische Karte des Standorts – eigene SVG-Zeichnung aus echten Koordinaten
 * (Projektion in km ab Tuttwil). Kein Kartendienst, keine Fremdanfrage, kein Cookie.
 * Sie zeigt, wo wir zuhause sind – kein Einsatzgebiet und keine Grenze (Rückmeldung
 * 04.10.2026: «uns nicht limitieren»).
 *
 * v4: `fill` – die Karte ist der Grund der Anfrage (vollflächig, beschnitten statt verzerrt,
 * Tuttwil rechts der Mitte, ein ruhiger Puls am Standort).
 */

interface Props { class?: string; fill?: boolean; compact?: boolean }
/** compact: schmaler Ausschnitt um Tuttwil, grössere Schrift (Handy). */
const { class: cls, fill = false, compact = false } = Astro.props;

/** Nur die grösseren Städte (#1143) – zur Orientierung, nicht als Liste von Einsatzorten. */
const towns = [
  { name: 'Frauenfeld', x: -2.8, y: -7.8, dx: -2.14, dy: -2.14, end: true },
  { name: 'Wil', x: 8.2, y: 2.5, dx: 2.14, dy: 3.86 },
  { name: 'Winterthur', x: -15.9, y: -1.8, dx: -2.14, dy: -2.14, end: true },
  { name: 'Zürich', x: -29.6, y: 11.9, dx: -2.14, dy: -2.14, end: true },
  { name: 'St. Gallen', x: 33.0, y: 6.6, dx: 2.14, dy: 4.07 },
  { name: 'Schaffhausen', x: -22.7, y: -23.6, dx: -2.14, dy: -2.68, end: true },
];
const lake =
  '18,-20.2 22.1,-17.4 26.6,-12.9 33.4,-9.2 37.4,-3.7 42,0.6 46.9,-0.7 57.4,-2.4 56.3,-6.9 48.4,-11.8 40.9,-18.5 29.6,-21.8 23.6,-24.1 16.9,-31.8 9.3,-36.9 8.6,-34.1 16.1,-27.4 18.7,-24.1 17.6,-21.8';
const untersee = '15.4,-20.2 10.8,-21 3.7,-20.5 -0.8,-18.2 -5.5,-19.6 -4.2,-23 2.6,-28 4.8,-28.5 10.1,-25.7 13.8,-23.5';
const rhine = 'M-5.7,-19.5 L-11.7,-21.8 L-17.7,-23.7 L-22.7,-23.6 L-26,-21.8 L-30.5,-11.8 L-38,-4';
const desc = 'Schematische Karte: Tuttwil zwischen Winterthur, Frauenfeld, Wil und St. Gallen, nahe dem Bodensee.';
/** Als Grund: Ausschnitt so, dass Tuttwil rechts der Mitte steht (links liegt der Text). */
const view = fill ? (compact ? '-30 -26 60 46' : '-112 -44 150 88') : '-56 -48 120 98';
---
<figure class:list={['amap', fill && 'amap--fill', compact && 'amap--compact', cls]}>
  <svg viewBox={view} preserveAspectRatio={fill ? 'xMidYMid slice' : 'xMidYMid meet'} role="img" aria-label={`Standort Tuttwil. ${desc}`} class="amap__svg">
    <polygon points={lake} class="amap__water" />
    <polygon points={untersee} class="amap__water" />
    <path d={rhine} class="amap__river" />
    <text x="40" y="-10.5" class="amap__region">BODENSEE</text>
    {towns.map((t) => (
      <g>
        <circle cx={t.x} cy={t.y} r="0.48" class="amap__dot" />
        <text x={t.x + t.dx} y={t.y + t.dy} text-anchor={t.end ? 'end' : 'start'} class="amap__town">{t.name}</text>
      </g>
    ))}
    <circle cx="0" cy="0" r="2.1" class="amap__pulse" />
    <rect x="-0.9" y="-0.9" width="1.8" height="1.8" class="amap__home" />
    <text x="1.65" y="-1.35" class="amap__hometext">Tuttwil</text>
  </svg>
</figure>

<style>
  .amap { margin: 0; max-width: 600px; }
  .amap--fill { position: absolute; inset: 0; max-width: none; }
  .amap__svg { width: 100%; height: auto; display: block; }
  .amap--fill .amap__svg { height: 100%; }
  .amap__water { fill: #E3E8EA; }
  .amap__river { fill: none; stroke: #B9C3C7; stroke-width: 0.45; stroke-linecap: round; stroke-linejoin: round; }
  .amap__region { font-family: var(--font-sans); font-size: 1.2px; letter-spacing: 0.3px; fill: #A9B3B7; }
  .amap__dot { fill: var(--ink-2); }
  .amap__town { font-family: var(--font-sans); font-size: 1.5px; font-weight: 500; fill: var(--ink-2); }
  .amap__home { fill: var(--red); }
  .amap__hometext { font-family: var(--font-display); font-size: 1.88px; font-weight: 600; fill: var(--ink); }
  .amap__pulse { fill: var(--red); opacity: 0.2; transform-box: fill-box; transform-origin: center; animation: amap-pulse 2.4s ease-out 2; }
  @keyframes amap-pulse { 0% { transform: scale(0.5); opacity: 0.45; } 100% { transform: scale(2.4); opacity: 0; } }
  .amap--compact .amap__town { font-size: 2.4px; }
  .amap--compact .amap__hometext { font-size: 3px; }
  .amap--compact .amap__region { font-size: 1.9px; }
  /* Klein (neben Text): die Schrift wächst mit, damit sie lesbar bleibt. */
  .amap:not(.amap--fill) .amap__town { font-size: 3.6px; }
  .amap:not(.amap--fill) .amap__hometext { font-size: 4.2px; }
  .amap:not(.amap--fill) .amap__region { font-size: 2.6px; }
  .amap:not(.amap--fill) .amap__dot { r: 0.9; }
  .amap:not(.amap--fill) .amap__home { x: -1.6px; y: -1.6px; width: 3.2px; height: 3.2px; }
</style>
