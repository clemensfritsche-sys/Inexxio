/** Breit: ganze Schweiz bis Innsbruck, von Stuttgart bis Mailand; rechts verankert (`xMaxYMid`),
 *  damit links unter dem Text zugeschnitten wird, nie rechts. Schmal (Handy): dieselbe Gegend,
 *  ganz sichtbar (`meet`). */
const view = compact ? '-250 -160 470 330' : '-640 -200 860 600';
const fit = compact ? 'xMidYMid meet' : fill ? 'xMaxYMid slice' : 'xMidYMid meet';
---
<figure class:list={['amap', fill && 'amap--fill', compact && 'amap--compact', cls]} data-play>
  <svg viewBox={view} preserveAspectRatio={fit} role="img" aria-label={`${T.place} ${T.desc}`} class="amap__svg">
    {lakes.map((p) => <polygon points={p} class="amap__water" />)}
    <path d={borders} class="amap__border" />
    <text x="36" y="-20" class="amap__lake">{T.lake}</text>
    {countries.map((c) => <text x={c.x} y={c.y} text-anchor="middle" class="amap__region">{c.name}</text>)}
    {towns.map((c) => (
      <g>
        <circle cx={c.x} cy={c.y} class="amap__dot" />
        <text x={c.x + (c.end ? -1 : 1) * 4} y={c.below ? c.y + 11 : c.y - 4} text-anchor={c.end ? 'end' : 'start'} class="amap__town">{c.name}</text>
      </g>
    ))}
    <circle cx="0" cy="0" r="9" class="amap__pulse" />
    <rect x="-3.2" y="-3.2" width="6.4" height="6.4" class="amap__home" />
    <text x="6" y="-5" class="amap__hometext">Tuttwil</text>
  </svg>
</figure>

<style>
  .amap { margin: 0; max-width: 600px; }
  .amap--fill { position: absolute; inset: 0; max-width: none; }
  .amap__svg { width: 100%; height: auto; display: block; }
  .amap--fill .amap__svg { height: 100%; }
  .amap__water { fill: #E3E8EA; }
  .amap__border { fill: none; stroke: #B9C3C7; stroke-width: 1; stroke-dasharray: 4 3; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .amap__region { font-family: var(--font-sans); font-size: 9px; font-weight: 500; letter-spacing: 2.4px; fill: #A9B3B7; }
  .amap__lake { font-family: var(--font-sans); font-size: 4.6px; letter-spacing: 1.2px; fill: #A9B3B7; }
  .amap__dot { fill: var(--ink-2); r: 1.7; }
  .amap__town { font-family: var(--font-sans); font-size: 7px; font-weight: 500; fill: var(--ink-2); }
  .amap__home { fill: var(--red); }
  .amap__hometext { font-family: var(--font-display); font-size: 9px; font-weight: 600; fill: var(--ink); }
  .amap__pulse { fill: var(--red); opacity: 0.2; transform-box: fill-box; transform-origin: center; animation: amap-pulse 2.4s ease-out 2; }
  @keyframes amap-pulse { 0% { transform: scale(0.5); opacity: 0.45; } 100% { transform: scale(2.4); opacity: 0; } }
  .amap--compact .amap__town { font-size: 15px; }
  .amap--compact .amap__hometext { font-size: 19px; }
  .amap--compact .amap__region { font-size: 13px; letter-spacing: 3px; }
  .amap--compact .amap__lake { font-size: 8px; }
  .amap--compact .amap__dot { r: 3; }
  .amap--compact .amap__home { transform: scale(1.6); transform-box: fill-box; transform-origin: center; }
  .amap--compact .amap__pulse { r: 14; }
</style>
