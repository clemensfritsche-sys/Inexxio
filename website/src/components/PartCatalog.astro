---
/**
 * Verschleissteile-Katalog aus der Konfiguration (v4, Muster Porsche-Bildkarten, components/PhotoCard):
 * je Teil eine grosse Bildkarte mit Teileart, Name, einem Satz und «Teil anfragen». Breit zwei Spalten,
 * die linke versetzt; schmal eine Reihe zum Wischen. Die letzte Karte ist hell: «Ihr Teil ist nicht
 * dabei?» mit der Anfrage (`catalog.missing`). Ohne Filter, ohne Preis, ohne Warenkorb.
 * «Teil anfragen» öffnet das Formular mit vorausgefülltem Teil.
 * «Passend für» steht einmal über dem Katalog (`catalog.fits`), an einem Teil nur, wenn es abweicht.
 */
import { catalog } from '../config/catalog.mjs';
import PhotoCard from './PhotoCard.astro';
import Rich from './Rich.astro';

const parts = catalog.groups.flatMap((g) => g.items.map((it, i) => ({ ...it, group: g.title, anchor: i === 0 ? g.id : undefined })));
---
<ul role="list" class="catalog">
  {parts.map((it) => (
    <li class="catalog__item" id={it.anchor}>
      <PhotoCard photo={it.photo} label={it.group} title={it.name} text={it.text} cta={{ label: 'Teil anfragen', href: `/kontakt?teil=${encodeURIComponent(it.name)}` }}>
        {(it.sku || it.material || it.fits) && (
          <p class="catalog__spec">
            {it.sku && <span class="tnum">Art.-Nr. {it.sku}</span>}
            {it.material && <Rich as="span" text={it.material} />}
            {it.fits && <span>Passend für {it.fits.join(' · ')}</span>}
          </p>
        )}
      </PhotoCard>
    </li>
  ))}
  <li class="catalog__item">
    <PhotoCard title={catalog.missing.title} text={catalog.missing.text} cta={{ label: catalog.missing.cta, href: '#anfrage' }} />
  </li>
</ul>

<style>
  /* Schmal: eine Reihe zum Wischen, die Karten 82 % breit, die nächste schaut herein. */
  .catalog { list-style: none; padding: 0 var(--gutter) 4px; margin-inline: calc(var(--gutter) * -1); display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none; }
  .catalog::-webkit-scrollbar { display: none; }
  .catalog__item { flex: 0 0 82%; scroll-snap-align: start; scroll-margin-top: calc(var(--header-h) + 24px); }
  .catalog__spec { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.8125rem; color: rgba(255, 255, 255, 0.7); }
  @media (min-width: 960px) {
    /* Zwei Spalten, die linke um eine Stufe tiefer – wie eine Zeitschrift. */
    .catalog { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-inline: 0; padding: 0 0 96px; overflow: visible; }
    .catalog__item:nth-child(odd) { transform: translateY(96px); }
  }
</style>
