---
/**
 * Verschleissteile-Katalog aus der Konfiguration – gruppiert nach Teileart, ohne Filter und ohne
 * Sprungmarken: die Gruppierung ist so klar, dass niemand filtern muss. Kein Preis, kein Warenkorb.
 * «Teil anfragen» öffnet das Formular mit vorausgefülltem Teil. Gestaltung v4 (graue Karten).
 * «Passend für» steht einmal über dem Katalog (`catalog.fits`), an einem Teil nur, wenn es abweicht.
 */
import { catalog } from '../config/catalog.mjs';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Rich from './Rich.astro';
---
<div class="catalog">
  {catalog.groups.map((g) => (
    <section class="catalog__group" id={g.id} aria-labelledby={`${g.id}-title`}>
      <header class="catalog__head">
        <h3 id={`${g.id}-title`} class="h3">{g.title}</h3>
        <Rich as="p" class="catalog__intro" text={g.intro} />
      </header>
      <ul role="list" class="catalog__items">
        {g.items.map((it) => (
          <li class="part">
            <Photo id={it.photo} sizes="(min-width: 1024px) 400px, (min-width: 720px) 50vw, 100vw" class="part__img" />
            <div class="part__body">
              <h4 class="part__name">{it.name}</h4>
              <Rich as="p" class="part__text" text={it.text} />
              <dl class="part__spec">
                {it.sku && <div><dt>Artikel-Nr.</dt><dd class="tnum">{it.sku}</dd></div>}
                {it.material && <div><dt>Material</dt><Rich as="dd" text={it.material} /></div>}
                {it.fits && <div><dt>Passend für</dt><dd>{it.fits.join(' · ')}</dd></div>}
              </dl>
              <a
                class="btn btn--glass part__cta"
                href={`/kontakt?teil=${encodeURIComponent(it.name)}`}
              >
                Teil anfragen <Icon name="arrow-right" size={18} class="btn__arrow" />
              </a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* v4: Teilearten als graue Marken oben, je Teil eine graue Karte mit dem Foto oben. */
  .catalog { display: grid; gap: 48px; }
  .catalog__group { display: grid; gap: 20px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .catalog__head { display: grid; gap: 6px; align-content: start; }
  .catalog__head .h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.75rem; letter-spacing: -0.02em; }
  .catalog__head :global(.catalog__intro) { max-width: 40em; color: var(--ink-3); }
  .catalog__items { list-style: none; padding: 0; display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 720px) { .catalog__items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  /* Breit wie ein Datenblatt: die Teileart links, ihre Teile rechts daneben – drei Spalten je Zeile,
     ohne leere Felder bei zwei Teilen. */
  @media (min-width: 1024px) {
    .catalog { gap: 24px; }
    .catalog__group { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 24px; padding-top: 24px; border-top: 1px solid var(--line); }
    .catalog__head { padding-right: 24px; }
  }
  .part { display: grid; align-content: start; border-radius: 24px; background: var(--gray-100); overflow: hidden; }
  .part :global(.part__img img) { display: block; transition: transform 0.6s var(--ease); }
  .part:hover :global(.part__img img) { transform: scale(1.03); }
  .part__body { display: grid; gap: 8px; padding: 24px; }
  .part__name { font-family: var(--font-display); font-weight: 600; font-size: 1.375rem; letter-spacing: -0.02em; }
  .part__body :global(.part__text) { color: var(--ink-2); font-size: 0.9375rem; }
  .part__spec { margin: 8px 0 0; }
  .part__spec div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line-2); font-size: 0.875rem; }
  .part__spec dt { font-weight: 600; color: var(--gray-500); }
  .part__spec dd, .part__spec :global(dd) { margin: 0; color: var(--ink-2); }
  .part__cta { justify-self: start; margin-top: 12px; }
</style>
