---
/**
 * Häufige Fragen – native <details>/<summary>, die Frage als echte Überschrift.
 * Die strukturierte Fassung (FAQPage) baut die Seite aus DENSELBEN Einträgen
 * (lib/seo.faqPage), damit nur steht, was auch sichtbar ist.
 *
 * ►►► Es ist immer nur EINE Antwort offen (Rückmeldung 04.10.2026). ◄◄◄ Das macht der
 * Browser selbst: <details> mit demselben `name` bilden eine Gruppe, in der das Öffnen der
 * einen die andere schliesst. Ältere Browser ohne diese Fähigkeit bekommt das Skript unten.
 */
import Icon from './Icon.astro';
import Rich from './Rich.astro';

interface Props {
  items: { q: string; a: string }[];
  level?: 'h3' | 'h4';
}
const { items, level = 'h3' } = Astro.props;
/** Eine Gruppe je FAQ-Block – zwei Blöcke auf einer Seite schliessen sich nicht gegenseitig. */
const counter = globalThis as { __ixFaq?: number };
counter.__ixFaq = (counter.__ixFaq ?? 0) + 1;
const group = `faq-${counter.__ixFaq}`;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item" name={group}>
      <summary class="faq__q">
        <Rich as={level === 'h3' ? 'h3' : 'strong'} class="faq__title" text={item.q} />
        <Icon name="plus" size={20} class="faq__icon" />
      </summary>
      <div class="faq__a">
        {item.a.split('\n\n').map((para) => <Rich text={para} />)}
      </div>
    </details>
  ))}
</div>

<script>
  // Rückfall für Browser ohne `<details name>`: öffnet eine Antwort, schliessen sich die
  // anderen derselben Gruppe. Wo der Browser es selbst kann, ist das ein Leerlauf.
  document.addEventListener('toggle', (e) => {
    const d = e.target;
    if (!(d instanceof HTMLDetailsElement) || !d.open || !d.name) return;
    document.querySelectorAll<HTMLDetailsElement>(`details[name="${d.name}"][open]`).forEach((o) => {
      if (o !== d) o.open = false;
    });
  }, true);
</script>

<style>
  .faq { border-top: 1px solid var(--line-2); }
  :global(.section--dark) .faq, :global(.section--dark) .faq__item { border-color: var(--line-dark); }
  .faq__item { border-bottom: 1px solid var(--line-2); }
  .faq__q {
    list-style: none; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    min-height: 64px; padding: var(--s-4) 0; cursor: pointer;
  }
  .faq__q::-webkit-details-marker { display: none; }
  /* Frage in der Titelschrift (DS «faq-q»), das Plus rot – offen dreht es sich zum ×. */
  .faq__q { padding-block: 22px; }
  .faq__title {
    font-family: var(--font-display); font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.125rem); font-weight: 600;
    letter-spacing: -0.02em; color: var(--ink); line-height: 1.3; transition: color var(--t-fast) var(--ease);
  }
  .faq__icon { flex: none; color: var(--red); transition: transform 250ms var(--ease); }
  :global(.section--paper) .faq__icon { color: var(--red-hover); }
  .faq__item[open] .faq__icon { transform: rotate(45deg); }
  .faq__q:hover .faq__title { color: var(--red-hover); }
  .faq__a { color: var(--ink-2); }
  .faq__a { padding: 0 var(--s-8) var(--s-5) 0; display: grid; gap: var(--s-3); }
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .faq { interpolate-size: allow-keywords; }
      .faq__item::details-content { height: 0; overflow: clip; transition: height 260ms var(--ease), content-visibility 260ms allow-discrete; }
      .faq__item[open]::details-content { height: auto; }
    }
  }
</style>
