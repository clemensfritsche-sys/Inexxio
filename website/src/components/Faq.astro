---
/**
 * Häufige Fragen – native <details>/<summary>, die Frage als echte Überschrift.
 * Die strukturierte Fassung (FAQPage) baut die Seite aus DENSELBEN Einträgen
 * (lib/seo.faqPage), damit nur steht, was auch sichtbar ist.
 *
 * ►►► Es ist immer nur EINE Antwort offen (Rückmeldung 04.10.2026). ◄◄◄ Das macht der
 * Browser selbst: <details> mit demselben `name` bilden eine Gruppe, in der das Öffnen der
 * einen die andere schliesst. Ältere Browser ohne diese Fähigkeit bekommt das Skript unten.
 */
import Icon from './Icon.astro';
import Rich from './Rich.astro';

interface Props {
  items: { q: string; a: string }[];
  level?: 'h3' | 'h4';
}
const { items, level = 'h3' } = Astro.props;
/** Eine Gruppe je FAQ-Block – zwei Blöcke auf einer Seite schliessen sich nicht gegenseitig. */
const counter = globalThis as { __ixFaq?: number };
counter.__ixFaq = (counter.__ixFaq ?? 0) + 1;
const group = `faq-${counter.__ixFaq}`;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item" name={group}>
      <summary class="faq__q">
        <Icon name="chevron-down" size={18} class="faq__icon" />
        <Rich as={level === 'h3' ? 'h3' : 'strong'} class="faq__title" text={item.q} />
      </summary>
      <div class="faq__a">
        {item.a.split('\n\n').map((para) => <Rich text={para} />)}
      </div>
    </details>
  ))}
</div>

<script>
  // Rückfall für Browser ohne `<details name>`: öffnet eine Antwort, schliessen sich die
  // anderen derselben Gruppe. Wo der Browser es selbst kann, ist das ein Leerlauf.
  document.addEventListener('toggle', (e) => {
    const d = e.target;
    if (!(d instanceof HTMLDetailsElement) || !d.open || !d.name) return;
    document.querySelectorAll<HTMLDetailsElement>(`details[name="${d.name}"][open]`).forEach((o) => {
      if (o !== d) o.open = false;
    });
  }, true);
</script>

<style>
  /* v4: jede Frage eine ruhige graue Karte (14 px), Pfeil links, offen dreht er sich. */
  .faq { display: grid; gap: 10px; }
  .faq__item { border-radius: 14px; background: var(--gray-100); transition: background-color 0.2s var(--ease); }
  .faq__item:hover { background: #E8E9EC; }
  :global(.section--dark) .faq__item { background: rgba(255, 255, 255, 0.06); }
  .faq__q { list-style: none; display: flex; align-items: center; gap: 12px; padding: 16px 20px; cursor: pointer; min-height: 56px; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__title { font-family: var(--font-sans); font-size: 1rem; font-weight: 500; letter-spacing: -0.006em; color: var(--ink); line-height: 1.4; transition: color var(--t-fast) var(--ease); }
  @media (min-width: 960px) { .faq__title { font-size: 1.0625rem; } }
  .faq__q:hover .faq__title { color: var(--red-hover); }
  .faq__icon { flex: none; color: var(--ink); transition: transform 350ms var(--ease); }
  .faq__item[open] .faq__icon { transform: rotate(180deg); }
  .faq__a { padding: 0 22px 18px 50px; display: grid; gap: 8px; color: var(--ink-2); font-size: 0.9375rem; line-height: 1.6; }
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .faq { interpolate-size: allow-keywords; }
      .faq__item::details-content { height: 0; overflow: clip; transition: height 450ms var(--ease), content-visibility 450ms allow-discrete; }
      .faq__item[open]::details-content { height: auto; }
    }
  }
</style>
