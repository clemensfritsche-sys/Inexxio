---
/**
 * ►►► Der Kontaktbereich – EINER für die ganze Website (Testnotizen #1107/#1129). ◄◄◄
 * Auf /kontakt und am Ende jeder Seite dasselbe: dieselbe Überschrift, derselbe Satz,
 * dasselbe Formular (ein Feld, Anhänge, wer fragt an) und daneben Telefon, E-Mail und
 * Anschrift mit Route (#1144). Auf /kontakt ist die Überschrift die H1 der Seite. Unter der Anschrift
 * steht überall die Karte (#1162/#1181) – sie zeigt, wo die Route hinführt.
 */
import SectionHead from './SectionHead.astro';
import InquiryForm from './InquiryForm.astro';
import ContactPanel from './ContactPanel.astro';
import LocationMap from './LocationMap.astro';
import { kontakt } from '../content/kontakt';

interface Props {
  level?: 'h1' | 'h2';
}
const { level = 'h2' } = Astro.props;
const main = level === 'h1';
---
<section class="section section--paper contact" id="anfrage" aria-labelledby="anfrage-title" data-hero={main ? true : undefined}>
  <div class="wrap grid">
    <div class="col-7">
      <SectionHead eyebrow="Kontakt" title={kontakt.h1} lead={kontakt.lead} id="anfrage-title" level={level} />
      <InquiryForm resultLevel={main ? 2 : 3} />
    </div>
    <aside class="col-4 contact__aside" aria-label="Direkter Kontakt">
      <ContactPanel />
      <LocationMap class="contact__map" />
    </aside>
  </div>
</section>

<style>
  .contact__aside { display: grid; gap: var(--s-5); align-content: start; }
  @media (min-width: 960px) {
    .contact__aside { grid-column: 9 / span 4; padding-top: var(--s-2); }
  }
</style>
