---
/**
 * ►►► Der Kontaktbereich – EINER für die ganze Website (Testnotizen #1107/#1129). ◄◄◄
 * Auf /kontakt und am Ende jeder Seite dasselbe: dieselbe Überschrift, derselbe Satz,
 * dasselbe Formular (InquiryForm) und daneben Telefon und E-Mail. Was sich je Seite
 * unterscheiden darf, ist allein das vorgewählte Anliegen (`need`) bzw. die Dringlichkeit.
 * Auf /kontakt ist die Überschrift die H1 der Seite.
 */
import SectionHead from './SectionHead.astro';
import InquiryForm from './InquiryForm.astro';
import ContactPanel from './ContactPanel.astro';
import { kontakt } from '../content/kontakt';

interface Props {
  need?: string;
  urgency?: 'dringend' | 'wochen' | 'planung';
  level?: 'h1' | 'h2';
}
const { need, urgency, level = 'h2' } = Astro.props;
---
<section class="section section--paper contact" id="anfrage" aria-labelledby="anfrage-title" data-hero={level === 'h1' ? true : undefined}>
  <div class="wrap grid">
    <div class="col-7">
      <SectionHead eyebrow="Kontakt" title={kontakt.h1} lead={kontakt.lead} id="anfrage-title" level={level} />
      <InquiryForm need={need} urgency={urgency} resultLevel={level === 'h1' ? 2 : 3} />
    </div>
    <aside class="col-4 contact__aside" aria-label="Direkter Kontakt">
      <ContactPanel />
    </aside>
  </div>
</section>

<style>
  @media (min-width: 960px) {
    .contact__aside { grid-column: 9 / span 4; padding-top: var(--s-2); }
  }
</style>
