export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Ohne Label ist das Symbol rein grafisch (aria-hidden). */
  label?: string;
}

const { name, size = 20, class: cls, label } = Astro.props;
const body = ICONS[name];
if (!body) throw new Error(`Unbekanntes Symbol «${name}»`);
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
