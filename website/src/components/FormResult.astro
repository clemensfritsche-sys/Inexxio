---
/**
 * Ergebnis-Flächen der Anfrage (Erfolg · Fehlerfall). Texte aus der Konfiguration,
 * sichtbar gemacht von scripts/form.ts. Der Fehlerfall verliert nichts: Telefon und ein
 * mailto-Link, dessen Text die Eingaben bereits enthält.
 */
import { site, contactEmail } from '../config/site.mjs';
import Icon from './Icon.astro';
import Rich from './Rich.astro';

interface Props {
  /** 2 = Formular direkt unter der H1 (/kontakt), 3 = in einer Sektion mit H2 (Kurzformular). */
  level?: 2 | 3;
}
const { level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---
<div class="iresult iresult--ok" data-result="ok" hidden tabindex="-1">
  <Icon name="check" size={32} class="iresult__icon" />
  <Rich as={H} class="iresult__title h3" text={`Danke. Wir melden uns innert ${site.promises.responseTime}.`} />
  <p>
    Wir sehen uns Ihre Angaben an und melden uns per Telefon oder E-Mail. Haben Sie eine
    E-Mail-Adresse angegeben, erhalten Sie gleich eine Bestätigung mit Ihren Angaben.
  </p>
  <p>Eilt es? Rufen Sie uns an: <a class="link tnum" href={`tel:${site.phone.e164}`} data-track="tel_click">{site.phone.display}</a></p>
</div>

<div class="iresult iresult--fail" data-result="fail" hidden tabindex="-1" role="alert">
  <Icon name="alert" size={32} class="iresult__icon" />
  <H class="iresult__title h3" data-fail-title>Das Senden hat nicht geklappt.</H>
  <p data-fail-text>
    Ihre Angaben sind nicht verloren. Rufen Sie uns an oder schicken Sie sie per E-Mail –
    der Text ist bereits vorbereitet.
  </p>
  <div class="btn-row">
    <a class="btn btn--primary" href={`tel:${site.phone.e164}`} data-track="tel_click"><Icon name="phone" size={18} /> {site.phone.display}</a>
    <a class="btn btn--secondary" href={`mailto:${contactEmail()}`} data-mailto data-track="mailto_click"><Icon name="mail" size={18} /> Per E-Mail senden</a>
  </div>
  <p class="small muted">Ihre Eingaben stehen weiterhin im Formular – Sie können es später noch einmal versuchen.</p>
</div>
