---
/**
 * Seitenkopf «wie Porsche» (v4, für Unterseiten): heller Verlauf, dahinter ein grosses graues
 * Wort, davor ein freigestelltes Bild, das unten über die Fläche hinausragt. Darunter mittig
 * H1, ein Satz, die rote Anfrage und ein Glas-Knopf. Das Bild ist ein WebP mit Transparenz
 * (src/assets/illustrations/), der Build erzeugt AVIF/WebP in mehreren Breiten.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Rich from './Rich.astro';

interface Action { label: string; href: string }
interface Props {
  /** Das Wort im Hintergrund (rein grafisch). */
  word: string;
  image: ImageMetadata;
  alt: string;
  title: string;
  lead: string;
  primary: Action;
  /** Zweite Aktion als Glas-Knopf, meist ein Sprung weiter unten auf der Seite. */
  secondary?: Action;
  /** Ein eher quadratisches Bild (z. B. eine Zeichnung) steht schmaler, damit das Wort sichtbar bleibt. */
  narrow?: boolean;
}
const { word, image, alt, title, lead, primary, secondary, narrow = false } = Astro.props;
---
<section class:list={['sh', narrow && 'sh--narrow']} aria-labelledby="sh-title">
  <div class="sh__band">
    <span class="sh__word" aria-hidden="true">{word}</span>
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600].filter((w) => w <= image.width)}
      sizes="(min-width: 1100px) 1000px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="sh__img"
      fallbackFormat="webp"
    />
  </div>
  <div class="wrap sh__body" data-hero>
    <Rich as="h1" class="sh__title" id="sh-title" text={title} />
    <Rich as="p" class="sh__lead" text={lead} />
    <div class="sh__btns">
      <a class="btn btn--primary btn--lg" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn--glass btn--lg" href={secondary.href}>{secondary.label} <Icon name="arrow-down" size={18} /></a>}
    </div>
  </div>
</section>

<style>
  .sh { text-align: center; overflow: hidden; }
  .sh__band { position: relative; height: 280px; background: linear-gradient(180deg, var(--white) 0%, var(--paper) 100%); }
  .sh__word {
    position: absolute; left: 50%; top: 24px; transform: translateX(-50%); white-space: nowrap; pointer-events: none; user-select: none;
    font-family: var(--font-display); font-weight: 700; font-size: 11vw; line-height: 1; letter-spacing: -0.05em; color: var(--gray-200);
  }
  .sh__band :global(.sh__img) { position: absolute; left: 50%; bottom: -16px; transform: translateX(-50%); width: 100%; height: auto; max-width: none; }
  .sh--narrow .sh__band :global(.sh__img) { width: 78%; }
  .sh__body { padding-top: 44px; display: flex; flex-direction: column; align-items: center; }
  .sh__body :global(.sh__title) { font-family: var(--font-display); font-weight: 600; font-size: 2.75rem; line-height: 1.05; letter-spacing: -0.03em; color: var(--ink); }
  .sh__body :global(.sh__lead) { margin-top: 14px; max-width: 36em; font-size: 1.0625rem; line-height: 1.5; color: var(--ink-2); }
  .sh__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
  .sh__btns .btn { --btn-h: 52px; padding: 0 24px; font-size: 1rem; }
  @media (min-width: 960px) {
    .sh__band { height: 620px; }
    .sh__word { top: 40px; }
    .sh__band :global(.sh__img) { width: min(1000px, 92%); bottom: -40px; }
    .sh--narrow .sh__band :global(.sh__img) { width: min(640px, 60%); bottom: -24px; }
    .sh__body { padding-top: 96px; }
    .sh__body :global(.sh__title) { font-size: 4.5rem; }
  }
</style>
